#!/bin/sh
# /usr/sbin/apwatch — bring a missing AP back, and nothing else.
#
# WHY THIS EXISTS: every repeater action runs `wifi reload`, which bounces BOTH
# radios (single PHY). If a reload ever fails to bring an AP back — a wedged
# mt76 radio, a failed STA association taking its radio down with it — someone
# with only a phone has no way in: no AP, no dashboard, no SSH. This watchdog
# closes that hole by noticing and recovering on its own.
#
# ESCALATION, gentlest first, stopping as soon as the AP is back:
#   strike 1  ->  `wifi up`        (re-apply wireless config)
#   strike 2+ ->  `wifi reload`    (fuller restart of the wireless stack)
#
# It stops there. It used to reboot on strike 3; that was removed 2026-08-11
# after an audit found no case where it had ever been needed, while it remained
# the most destructive automation on the box.
#
# THIS IS NOT THE ONLY WRITER FOR WIRELESS, and assuming otherwise is unsafe.
# As of 2026-08-11 five paths can reload the radios: this script (on a timer),
# /etc/hotplug.d/iface/99-repeater-iot (on an interface event, backgrounded),
# and repeater-api / dashboard-api / settings-api (user-initiated).
#
# That matters because of how the 2026-08-10 outage escalated: an `ifup`
# elsewhere reconfigured the wireless stack, this check sampled it mid-flight,
# called the APs missing, and stacked a `wifi up` on top — tearing down phy0
# and dropping every client. The `.repeater-trying` guard below covers only
# the repeater-api path; the hotplug and tethering paths do not set it, so a
# collision remains possible. Known and accepted, not solved — see F2 in the
# 2026-08-11 sign-off. Do not "fix" it by adding another guard or lock without
# a deliberate decision: that is how the last one got built.

STATE=/tmp/.apwatch.strikes
LOG="logger -t apwatch"

# ---- heartbeat ---------------------------------------------------------------
# Written at every point this script legitimately FINISHES, never at the top and
# never from a trap on EXIT. The top would only prove cron fired it, so a job
# dying on line two would still look healthy; a trap fires on a crash too, which
# is the same lie one level up. Reaching one of these calls means this script got
# to the end of its logic and decided what to do — including deciding to do
# nothing, which is a correct outcome, not a failure.
#
# The name is derived from $0 rather than written out, so the file this job
# stamps and the file the console looks for cannot drift apart.
#
# /tmp, not /etc/dashboard: this runs every minute, and 1440 flash writes a day
# per job is exactly the wear this project keeps its ring buffers in RAM to
# avoid. Uptime rather than wall clock, for the reason dashmon states about
# .wanreach — an NTP step must not be able to make a fresh stamp look ancient.
HB=/tmp/.hb-${0##*/}
beat() { read -r _hb _ < /proc/uptime 2>/dev/null; printf '%s
' "${_hb%.*}" > "$HB" 2>/dev/null; return 0; }

MIN_UPTIME=600          # don't act during the first 10 min (boot still settling)

uptime_s=$(cut -d. -f1 /proc/uptime 2>/dev/null); : "${uptime_s:=0}"
# Standing back while boot settles is a correct outcome, so it stamps. Without
# this the watchdog that exists for the phone-only case would report itself dead
# for the first ten minutes of every boot.
[ "$uptime_s" -lt "$MIN_UPTIME" ] && { beat; exit 0; }

# A repeater connect legitimately tears radios down for a few seconds.
[ -f /tmp/.repeater-trying ] && { beat; exit 0; }

# So does any DELIBERATE radio reload - a Wi-Fi or secondary-network change from
# the console, a width change on a new uplink, the repeater hook switching the
# non-primary SSIDs. Those paths leave an uptime stamp; anything inside 30s of it
# is our own reload in flight, not a fault. Measured: a reload has every AP back
# within about eight seconds, so 30 is generous and still under one cron tick -
# at worst this skips a single sample, where acting instead would stack a
# `wifi up` on a reload that is already running.
if [ -r /tmp/.wifi-reloading ]; then
    read -r wr_at < /tmp/.wifi-reloading 2>/dev/null
    case "$wr_at" in ''|*[!0-9]*) wr_at=-1 ;; esac
    if [ "$wr_at" -ge 0 ]; then
        wr_age=$((uptime_s - wr_at))
        [ "$wr_age" -ge 0 ] && [ "$wr_age" -le 30 ] && { beat; exit 0; }
    fi
fi

# Which AP sections are *supposed* to be running right now?
want=0; have=0; missing=""
for sec in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
    [ "$(uci -q get wireless.$sec.mode)" = "ap" ] || continue
    [ "$(uci -q get wireless.$sec.disabled)" = "1" ] && continue
    want=$((want+1))
    ifn=$(ubus call network.wireless status 2>/dev/null | awk -v w="$sec" '
        /"section":/ { gsub(/[",]/,""); s=$2 }
        /"ifname":/  { gsub(/[",]/,""); if (s==w) { print $2; exit } }')
    # Present in ubus AND actually carrying the IFF_UP flag in the kernel.
    if [ -n "$ifn" ] && [ -e "/sys/class/net/$ifn" ] && \
       grep -qi 'up' "/sys/class/net/$ifn/operstate" 2>/dev/null; then
        have=$((have+1))
    else
        # operstate for an AP with no clients reads "unknown", not "up" — so fall
        # back to the admin flag, which is what actually matters here.
        if [ -n "$ifn" ] && [ -e "/sys/class/net/$ifn/flags" ] && \
           [ $(( $(cat "/sys/class/net/$ifn/flags" 2>/dev/null || echo 0) & 1 )) -eq 1 ]; then
            have=$((have+1))
        else
            missing="$missing $sec"
        fi
    fi
done

# No APs configured at all? Nothing to guard.
[ "$want" -gt 0 ] || { beat; exit 0; }

if [ "$have" -ge "$want" ]; then
    [ -f "$STATE" ] && { rm -f "$STATE"; $LOG "all $want AP(s) healthy again"; }
    beat
    exit 0
fi

strikes=$(cat "$STATE" 2>/dev/null); case "$strikes" in ''|*[!0-9]*) strikes=0 ;; esac
strikes=$((strikes+1))
echo "$strikes" > "$STATE"
$LOG "AP(s) missing:$missing ($have/$want up) — strike $strikes"

case "$strikes" in
    1) $LOG "recovery: wifi up";     wifi up     >/dev/null 2>&1 ;;
    *) $LOG "recovery: wifi reload"; wifi reload >/dev/null 2>&1 ;;
esac
beat
exit 0
