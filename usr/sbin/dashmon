#!/bin/sh
# /usr/sbin/dashmon — 1-minute telemetry collector for the dashboard.
# Ring buffers live in /tmp (RAM): no flash wear, lost on reboot by design.

PRES=/tmp/.presence
SNAP=/tmp/.dashmon.sta
now=$(date +%s)

# ---- WAN reachability, for the status LED below -----------------------------
# Three packets, once a minute, and nothing is kept. This used to append a row
# to a 4-hour ring at /tmp/.wanlat; that ring was deleted 2026-08-11 because
# five minutes is the window that actually gets looked at, and pingmon keeps
# that at 1-second resolution.
#
# Deliberately its OWN probe rather than reading pingmon's ring. It is three
# packets a minute, and it means the LED keeps telling the truth even if pingmon
# is stopped — one less thing that has to be working for another thing to work.
loss=$(ping -c3 -W1 -q 1.1.1.1 2>/dev/null | awk -F, '/packet loss/{gsub(/[^0-9]/,"",$3); print $3}')
[ -n "$loss" ] || loss=100

# Published so the dashboard's "is there internet" verdict has a second,
# independent source. The Overview's probe target is user-selectable and may be
# aimed at a game server that never answers pings; this one is fixed, so a
# silent custom target can never make the hero panel claim the line is down.
# Uptime rather than wall clock, so an NTP step cannot make it look stale.
read -r _u _rest < /proc/uptime 2>/dev/null
echo "${_u%.*} $loss" > /tmp/.wanreach

# ---- IPv6 reachability ------------------------------------------------------
# Separate from the v4 probe above because they fail independently: the
# 2026-08-10 outage took IPv6 down completely while v4 stayed perfect, and
# nothing here noticed. One line of state, same shape as $LAT.
v6=$(ping6 -c1 -W2 -q 2606:4700:4700::1111 2>/dev/null | awk -F, '/packet loss/{gsub(/[^0-9]/,"",$3); print $3}')
[ -n "$v6" ] || v6=100
echo "$now $v6" > /tmp/.wanlat6

# ---- internet-status LED (white:status) ----
# At-a-glance health with no phone needed: DARK when the internet is fine, BLINK
# when it is not. Reflects real reachability (this same 1.1.1.1 probe), so it
# works whatever the uplink is — Ethernet, repeater or tethering. The blue status
# LED is left alone. Reversible: `echo none >…/trigger; echo 0 >…/brightness`.
LED=/sys/class/leds/white:status
if [ -d "$LED" ]; then
    if [ "$loss" = "100" ]; then
        # offline — fast blink for attention
        [ "$(cat "$LED/trigger" 2>/dev/null | grep -o '\[timer\]')" = "[timer]" ] || echo timer > "$LED/trigger" 2>/dev/null
        echo 200 > "$LED/delay_on"  2>/dev/null
        echo 200 > "$LED/delay_off" 2>/dev/null
    else
        # online — dark and quiet
        echo none > "$LED/trigger" 2>/dev/null
        echo 0 > "$LED/brightness" 2>/dev/null
    fi
fi

# ---- presence: join/leave events (band moves are deliberately NOT events) ----
# Interfaces come from `iw dev`, and each one's band from the frequency it is
# actually on — never from its name. Interface naming is a build detail
# (phy0.<radio>-ap<n> here, wlan0/wlan1 on stock OpenWrt), so a name pattern
# would quietly record nothing on another router.
cur=$(iw dev 2>/dev/null | awk '
        /^\tInterface /  { ifc=$2 }
        /^\t\tchannel /  { f=$3; sub(/\(/,"",f); if (ifc != "") print ifc, (f+0 < 3000 ? "2.4" : (f+0 < 5955 ? "5" : "6")) }
      ' | while read -r ifc b; do
        iw dev "$ifc" station dump 2>/dev/null | awk -v b="$b" '/^Station/{print $2, b}'
      done | sort -u)
if [ -f "$SNAP" ]; then
    prev=$(cat "$SNAP")
    printf '%s\n' "$cur" | while read -r mac band; do
        [ -n "$mac" ] || continue
        printf '%s\n' "$prev" | grep -q "^$mac " || echo "$now join $mac $band" >> "$PRES"
    done
    printf '%s\n' "$prev" | while read -r mac band; do
        [ -n "$mac" ] || continue
        printf '%s\n' "$cur" | grep -q "^$mac " || echo "$now leave $mac $band" >> "$PRES"
    done
    [ -f "$PRES" ] && tail -n 50 "$PRES" > "$PRES.n" && mv "$PRES.n" "$PRES"
fi
printf '%s\n' "$cur" > "$SNAP"

# ---- daily traffic baseline (LOCAL midnight) --------------------------------
# nlbwmon anchors its accounting periods to UTC, so its per-device counters roll
# over at UTC midnight — 07:00 here, not at local midnight. Without a baseline
# the dashboard's "today" would mean "since 07:00", which is not what anyone
# reading it assumes.
#
# So: on the first run of each LOCAL day, record the counters and which nlbwmon
# period they came from. dashboard-api subtracts this to get a true local-day
# figure, and handles the counters resetting under it when the period rolls.
#
# Written to flash rather than /tmp deliberately, unlike the ring buffers above:
# it changes once per day, so the wear is one small write per day, and putting
# it in /tmp would silently zero the day's traffic on every reboot.
DAILY=/etc/dashboard/nlbw-daily
_today=$(date +%Y-%m-%d)
_snapday=$(sed -n 's/^day=//p' "$DAILY" 2>/dev/null | head -1)
if [ "$_snapday" != "$_today" ]; then
    _per=$(nlbw -c list 2>/dev/null | head -1)
    if [ -n "$_per" ]; then
        mkdir -p /etc/dashboard 2>/dev/null
        {
            printf 'day=%s\nperiod=%s\n' "$_today" "$_per"
            # csv, not json: tab separated and trivially parsed, where the json
            # would need bracket handling in awk for no benefit.
            nlbw -c csv -g mac 2>/dev/null | awk -F'\t' 'NR>1 {
                gsub(/"/,"",$1); gsub(/"/,"",$3); gsub(/"/,"",$5)
                if ($1 != "") print $1, $3, $5
            }'
        } > "$DAILY.tmp" 2>/dev/null
        # Only replace a good baseline with another good one — a truncated write
        # here would corrupt the whole day's numbers.
        if [ -s "$DAILY.tmp" ] && grep -q '^period=' "$DAILY.tmp"; then
            mv "$DAILY.tmp" "$DAILY"
            logger -t dashmon "daily traffic baseline taken for $_today (nlbwmon period $_per)"
        else
            rm -f "$DAILY.tmp"
        fi
    fi
fi
