#!/bin/sh
# /usr/sbin/wifiwatch — real-time Wi-Fi arrivals and departures.
#
# WHY THIS EXISTS SEPARATELY FROM notifymon. notifymon runs from cron, so the
# fastest it can ever be is a minute, and the presence file it reads is written
# by dashmon on the same minute cadence. For "is the internet down" a minute is
# nothing. For "who just walked in" it is the whole point, and the owner said
# so.
#
# WHAT IT LISTENS TO. hostapd publishes ubus notifications per AP. Verified on
# this router rather than assumed - a subscriber was attached and one
# association was deliberately provoked to read the names off the wire:
#
#   join   sta-authorized   (fires after the handshake, when the client is
#                            actually usable - `assoc` fires earlier, before
#                            the key exchange, and would announce a device
#                            that may still fail to join)
#   leave  disassoc | deauth | local-deauth
#
# THE HARD PART IS NOT SPEED, IT IS ROAMING. Measured here: hostapd logged 22
# connect/disconnect lines in one hour while only 2 were real arrivals - a
# phone hopping 2.4 <-> 5 GHz produces a disassoc and an assoc every time, and
# announcing those would make the alerts worthless within a day. dashmon avoids
# this by only sampling once a minute, which is exactly the latency being
# removed here, so the debounce has to be rebuilt properly:
#
#   JOIN  is announced only if the device is not already on another AP OF THE
#         SAME NETWORK at that moment. A band hop therefore announces nothing.
#   LEAVE cannot be judged instantly - "gone" and "moving" look identical for a
#         second or two - so it is held for GRACE seconds and then confirmed.
#         Anything that came back to the same network is silently dropped.
#   MOVE  is the third case, and it was missing. "Same network" above used to
#         read "anywhere", which swallowed a crossing between two watched
#         networks from both ends at once - see assoc_net.
#
# So joins are instant and leaves take GRACE. That asymmetry is physics, not a
# shortcut: no amount of engineering can tell a departure from a roam at the
# instant the frame arrives.
#
# WHAT IT IS ALLOWED TO DO. It sends messages. It never restarts a service,
# never writes uci, never touches the radios - the same invariant pingmon
# carries. The worst failure it can produce is a wrong message.

# EVERYTHING THIS WRITES IS PRIVATE, and procd starts a service with a 022
# umask, so every one of these files landed world-readable: the alert queue
# (which carries device names and, since the guest network existed, guest
# SSIDs), the pending-departure and recently-left files (MACs), and the event
# FIFO - which is not just readable but WRITABLE, i.e. an injection point for
# fake association events. There are no non-root accounts on this router today,
# which is exactly why none of it was visible; the next person to add one
# inherits a readable list of who is in the house. Set before the first file is
# created rather than chmod'ing afterwards, so there is no window at all.
umask 077

CONF=/etc/dashboard/notify.conf
PEND=/tmp/.wifipend
# MEASURED TWICE, and the second measurement corrected the first. Counting all
# disconnect->reconnect gaps together said "74% within 10s" and produced a 10s
# grace. But that mixed two populations. Split by whether the device came back
# on a DIFFERENT radio (a roam) or the same one (a blip, a sleep, an off/on):
#
#   roam, n=38      53% return within ONE second, then a clean gap with ZERO
#                   samples at 2-3s, a small 4-10s cluster, and a >10s tail
#                   that is not roaming at all - those are real departures that
#                   happened to come back on the other band.
#   same radio, n=171   median ONE second: power-save wakeups and retries.
#
# So nearly all of the noise is over within a second, and the 10s grace was
# paying nine seconds of delay for almost nothing. 3s sits inside the empty
# 2-3s band: past the fast roams, well short of a human noticing.
#
# It stays a knob, because the tail overlaps: a handful of roams take 4-10s and
# will produce a departure followed by a "back after Ns". That is the honest
# trade for reporting a real disconnect in about three seconds.

# How long a device may return and still be described as coming BACK rather
# than arriving. Beyond this it is treated as a fresh arrival.
LEFT=/tmp/.wifileft

# Which access points are worth a message, named by the NETWORK behind them.
#
# This used to be "only APs bridged onto the main LAN", which was the right
# answer while the only other network was IoT - a house full of smart plugs
# reconnects all day and none of it is news. It became the wrong answer the
# moment a guest network existed: guests are people, their arrivals and
# departures are exactly the thing worth knowing about, and a LAN-only test
# silently excluded them for the same reason it excluded the plugs.
#
# So the rule is now a skip LIST rather than an allow-one. Default skips `iot`
# alone; everything else - lan, guest, whatever comes next - notifies like the
# main network does. NOTIFY_WIFI_SKIP overrides it (space separated), and
# NOTIFY_WIFI_ALL_APS=1 still reports absolutely everything.

# The config is PARSED, not sourced. It carries a value written by the web UI,
# and `.` would run it as a shell script every minute as root. conf_load reads
# it as data; see the note on that function. There is no fallback to `.` here
# on purpose - if the library is missing the safe outcome is not to run.
BERYL_LIB=/usr/share/beryl/cgi-lib.sh
if [ -r "$BERYL_LIB" ]; then
    . "$BERYL_LIB"
else
    logger -t wifiwatch "missing $BERYL_LIB - cannot read the config safely, not running"
    exit 0
fi

conf_load "$CONF" || exit 0
[ "$NOTIFY_ENABLED" = "1" ] || exit 0
[ -n "$NOTIFY_URL" ] || exit 0
notify_flag_on "$NOTIFY_WIFI" || exit 0    # see cgi-lib: only an explicit 0 is off

# NOTE: every ${NOTIFY_*:-default} below MUST stay after the source above.
# They were written before it and silently used their defaults forever - the
# knobs were documented, advertised to the owner, and dead. A default that
# happens to be sensible hides this completely.
GRACE=${NOTIFY_WIFI_GRACE:-3}
RETURN_WINDOW=${NOTIFY_WIFI_RETURN:-600}
WATCH_ALL=${NOTIFY_WIFI_ALL_APS:-0}
SKIP_NETS=${NOTIFY_WIFI_SKIP:-iot}

HOSTN=$(uci -q get system.@system[0].hostname 2>/dev/null); HOSTN=${HOSTN:-router}

# ---- wording ---------------------------------------------------------------
# Every caption below can be overridden in notify.conf without touching this
# file, which matters because a console reinstall replaces this script and never
# touches that config:
#
#     MSG_WIFI_JOIN_B="%s masuk ke %s di %s GHz."
#
# HOW MANY %s A BODY TAKES IS PART OF ITS CONTRACT, and getting it wrong is not
# a harmless mistake here. busybox printf REPEATS its whole format string when
# it is handed more arguments than the format has conversions, rather than
# ignoring the extras. Measured on this router, a two-slot format given three
# arguments:
#
#     $ printf '%s disconnected from %s GHz.' dev net 5
#     dev disconnected from net GHz.5 disconnected from  GHz.
#
# The sentence arrives twice, the second copy garbled. Too FEW arguments is the
# quiet direction: the surplus conversions render as empty strings, leaving gaps
# and stray punctuation.
#
# So the per-caption comments below state the slot count, and they are the
# contract. Only MSG_WIFI_LEAVE_B tolerates a wrong count, and only because its
# arity CHANGED - see its own note. Every other caption here, and every caption
# in notifymon, is fed a fixed number of arguments and assumes the shipped
# count.
#
# Never put a | in a caption: it separates fields in the retry queue.

# 3 slots: %s = device, %s = network, %s = band
M_WIFI_JOIN_T=${MSG_WIFI_JOIN_T:-"device joined Wi-Fi"}
M_WIFI_JOIN_B=${MSG_WIFI_JOIN_B:-"%s connected to %s on %s GHz."}
# 3 slots: %s = device, %s = network, %s = band.
#
# THE NETWORK IS NEW HERE, and it is the whole point: a departure used to carry
# the band and nothing else, so leaving the guest network and leaving the main
# one produced byte-identical messages. Joins have always named the network, so
# the pair read as if the router only half knew what it was talking about.
#
# THIS CAPTION WENT FROM TWO SLOTS TO THREE ON 2026-08-31, so unlike every other
# caption in this file it cannot assume the shipped count: an override written
# for the old form is still out there. THE SLOT COUNT IS COUNTED BEFORE FILLING
# (the `case` at the departure branch) and exactly that many arguments are
# passed. Without that count, busybox printf's repeat-on-surplus behaviour would
# print the whole sentence twice - see the block above the join caption for the
# measured output.
#
# What each shape produces, measured through that `case`:
#
#     3 slots (shipped)  device disconnected from network on 5 GHz.
#     2 slots (old form) device disconnected from 5 GHz.        network dropped
#     0 slots            used verbatim
#     4 slots            takes the 3-slot branch; the fourth conversion renders
#                        EMPTY, so a trailing "after ." is what you get. Not
#                        corrupt, but not what was written - four is not a
#                        supported arity and nothing will tell you so.
M_WIFI_LEAVE_T=${MSG_WIFI_LEAVE_T:-"device left Wi-Fi"}
M_WIFI_LEAVE_B=${MSG_WIFI_LEAVE_B:-"%s disconnected from %s on %s GHz."}
# %s = device, %s = how long it was away
M_WIFI_BACK_T=${MSG_WIFI_BACK_T:-"device is back"}
M_WIFI_BACK_B=${MSG_WIFI_BACK_B:-"%s reconnected after %s away."}
# %s = device, %s = network left, %s = network joined.
#
# A device crossing between two watched networks is neither an arrival nor a
# departure and reads wrong as either: "left" is untrue because it is still on
# the router, and "joined" hides that it used to be somewhere with different
# rules. Naming both ends is the only phrasing that is actually the news.
M_WIFI_MOVE_T=${MSG_WIFI_MOVE_T:-"device changed network"}
M_WIFI_MOVE_B=${MSG_WIFI_MOVE_B:-"%s moved from %s to %s."}

# THE QUEUE IS NOTIFYMON'S, DELIBERATELY. A second retry mechanism here would
# be a second thing to get wrong, and the two would race for the same topic.
# notifymon drains this file every minute from cron, oldest first, stopping at
# the first failure so ordering survives - so appending to it is the whole of
# what this needs to do.
#
# It matters most on exactly the paths this router exists for: a captive portal,
# a dead uplink, a DNS outage. wget failed on every one of those and the alert
# was discarded with nothing recording that it had ever existed, which is the
# worst possible behaviour for a device whose job is telling you what happened
# while you were not looking.
QUEUE=/tmp/.notifyq
QMAX=25
QDROP=/tmp/.notifyqdrop

# THE QUEUE IS SHARED, AND SHARING IT WAS NOT FREE. notifymon drains it by
# reading it and writing the remainder back over the top; an append landing
# between that read and that write was overwritten, and overwritten in SILENCE -
# the drop counter is only touched when the queue is FULL, so a lost alert
# incremented nothing and left no trace anywhere. Measured, not theorised: one
# line appended a second into a three-second drain vanished and no counter
# appeared.
#
# LOCKING, rather than the alternatives. Counting the loss is a receipt for a
# lost message, not a fix. Making the drain non-destructive cannot help on its
# own while an appender may be mid-write. And a second delivery path here is the
# very thing the note above rejects - the queue being notifymon's is the point.
#
# flock is a kernel lock held on an open fd, so a process that dies holding it
# releases it: there is no stale-lock case to reason about and nothing to clean
# up after a reboot. The redirection is scoped to a brace group rather than a
# bare `exec`, because a failed `exec` redirection can take a non-interactive
# shell down with it. If flock is missing entirely the block still runs and the
# behaviour degrades to exactly what exists today - never to a dropped alert.
QLOCK=/tmp/.notifyq.lock

# A umask only applies to files this process CREATES. Anything left in /tmp by a
# build that ran before it - the queue, the drop counter, and this program's own
# pending and recently-left lists, which are nothing but MACs - keeps 0644 until
# a reboot clears /tmp. One chmod at start-up, once per service start.
chmod 0600 "$QUEUE" "$QDROP" "$PEND" "$LEFT" 2>/dev/null

# ---- heartbeat -------------------------------------------------------------
# WHAT A HEARTBEAT MEANS FOR A DAEMON, which is not what it means for a cron
# job. dashmon, apwatch, vpnwatch and notifymon each stamp when a RUN completes.
# This has no runs: it blocks on a read and may legitimately have nothing to say
# for days, so "completed normally" is not an event that ever happens here.
#
# The observable is therefore THE LOOP TURNING. The read already has a one
# second timeout - it has to, so a held departure can be confirmed when the
# airwaves go silent - which means an idle, healthy wifiwatch still comes round
# about once a second. A stopped loop is the failure worth surfacing, and it is
# very nearly the only one: a deaf subscriber, a wedged read, a process killed
# without procd noticing. Everything else this program does is downstream of it.
#
# Written at most every HB_EVERY seconds rather than on every pass: a stamp a
# second is 86400 pointless writes a day and the console's staleness bar is
# 150s, so five missed beats still fit inside it.
#
# NO EARLY EXIT BEATS - the opposite of notifymon's rule, and deliberate. For a
# cron job an early exit IS a completed run, so it stamps. For a service procd
# respawns every ten seconds, an early exit means the program is not running at
# all, and a stamp there would assert liveness for something that just died.
# Notifications being switched off is the one legitimate reason to be absent,
# and the CONSOLE is what knows that: dashboard-api reads the same three keys
# this gates on and does not expect a stamp when they say no. Liveness is
# claimed here; permission to be absent is granted there.
HB=/tmp/.hb-${0##*/}
HB_EVERY=30
HB_LAST=0

# Failures to parse an event that SHOULD have parsed, counted IN A WINDOW.
#
# The first version counted CONSECUTIVE failures and reset on any success, which
# a mixed stream walks straight through: hostapd renaming one event type -
# disassoc, say, while sta-authorized keeps working - alternates bad and good, so
# the run never reaches two. Measured on the real loop: half the events
# discarded, 1213 notifications delivered against 3247 in the control, and the
# panel green throughout. A consecutive counter cannot see that shape at all.
#
# A window can, and it is LESS machinery rather than more: the reset-on-success
# rule is gone, because successes are no longer part of the arithmetic. Failures
# are the only thing counted and the window ages them out on its own.
#
# WHAT THE POST-RESTART BEHAVIOUR IS, named rather than implied: the count and
# the window both start at zero, so a restarted wifiwatch beats immediately and
# needs PFAIL_MAX fresh failures inside PFAIL_WIN before it stops again. A
# restart therefore CLEARS a standing stale signal and re-earns it within a
# minute if the cause is still there. procd does not restart a live process, so
# that only happens when someone restarts it deliberately.
#
# Rare events make it slow to trip, which is proportionate rather than a gap: if
# events are rare, few are being lost.
PFAIL=0
PFAIL_MAX=5
PFAIL_WIN=60
PFAIL_AT=0
#
# THE GATE LIVES HERE, not at the call site, and that is what a first attempt
# got wrong. Gating the loop's own call left the OTHER caller - notify(),
# below - stamping freely, so a stream mixing unparseable events with good
# ones kept the console green off the back of the notifications the good half
# produced. Measured: 1930 loop turns, the gate refusing about half of them,
# and the stamp moving anyway. One function decides and every caller inherits
# it; a second gate would have left the same shape waiting for a third caller.
beat() {
    read -r _hb _ < /proc/uptime 2>/dev/null
    _hb=${_hb%.*}
    case "$_hb" in ''|*[!0-9]*) return 0 ;; esac
    # Roll the failure window off the clock read we already have, so it ages
    # out on an idle loop as well as a busy one.
    [ "$((_hb - PFAIL_AT))" -ge "$PFAIL_WIN" ] && { PFAIL_AT=$_hb; PFAIL=0; }
    # Events are being discarded: say nothing rather than say healthy.
    [ "$PFAIL" -lt "$PFAIL_MAX" ] || return 0
    [ "$((_hb - HB_LAST))" -lt "$HB_EVERY" ] && return 0
    HB_LAST=$_hb
    printf '%s\n' "$_hb" > "$HB" 2>/dev/null
    return 0
}

send() {   # $1 title  $2 body  $3 priority  $4 tags
    wget -q -T 8 -O /dev/null \
        --header="Title: $HOSTN: $1" \
        --header="Priority: ${3:-default}" \
        --header="Tags: ${4:-iphone}" \
        --post-data="$2" "$NOTIFY_URL" 2>/dev/null
}

# Send, and keep it if the send fails. The body carries the time the event
# actually happened, because a Wi-Fi join delivered an hour late is misleading
# without it - the same reason notifymon stamps its own queued messages.
notify() {  # $1 title  $2 body  $3 priority  $4 tags
    # A send can stall for the full wget timeout, and a run of them is the only
    # thing that keeps this function away from the loop for long. Stamp before
    # blocking, so a dead uplink is never mistaken for a dead wifiwatch.
    beat
    send "$1" "$2" "$3" "$4" && return 0
    # A literal | would split into the wrong fields when notifymon reads this
    # back. Names come from the class map, which is itself |-separated and so
    # cannot contain one, but the guard costs nothing and does not depend on
    # that staying true. Composed BEFORE the lock is taken: these are forks, and
    # nothing held under a lock should be waiting on one.
    _qt=$(printf '%s' "$1" | tr -d '|')
    _qb="$(date '+%H:%M') — $(printf '%s' "$2" | tr -d '|')"
    # No `return` inside the block: the lock is released by the brace group's
    # redirection closing, and jumping out of it is the one way to make that
    # harder to reason about than it needs to be.
    {
        flock -x 9 2>/dev/null
        if [ -f "$QUEUE" ] && [ "$(wc -l < "$QUEUE" 2>/dev/null)" -ge "$QMAX" ]; then
            _d=0; [ -r "$QDROP" ] && read -r _d < "$QDROP" 2>/dev/null
            case "$_d" in ''|*[!0-9]*) _d=0 ;; esac
            printf '%s\n' "$((_d + 1))" > "$QDROP" 2>/dev/null
            logger -t wifiwatch "alert queue full ($QMAX) - dropped: $1"
        else
            printf '%s|%s|%s|%s\n' "$_qt" "$_qb" "$3" "$4" >> "$QUEUE" 2>/dev/null
            logger -t wifiwatch "notification send failed - queued for notifymon to retry"
        fi
    } 9>>"$QLOCK" 2>/dev/null
}

# Names come from the class map, so the phone and the console agree on what a
# device is called; the MAC is the honest fallback.
dev_name() {
    _n=$(awk -F'|' -v m="$1" '!/^#/ && tolower($1)==m {print $2; exit}' \
         /etc/dashboard/classmap 2>/dev/null)
    [ -n "$_n" ] || _n=$(awk -v m="$1" '$2==m {print $4; exit}' /tmp/dhcp.leases 2>/dev/null)
    [ -n "$_n" ] && [ "$_n" != "*" ] || _n="$1"
    printf '%s' "$_n"
}

ap_list() { iw dev 2>/dev/null | awk '/^\tInterface /{print $2}'; }

# Is this AP one we report on? Answered from the KERNEL's bridge table rather
# than from uci section names or an interface-name pattern: an AP carrying the
# main network is a port of the LAN bridge, and the IoT AP is a port of its
# own. Naming is a build detail - "iot2g" here, something else on the next
# router - but bridge membership is what actually decides which network a
# client lands on, so it is the honest thing to key on.
LANDEV=$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
[ -n "$LANDEV" ] || LANDEV=br-lan
# Which network is behind this AP. Answered from the KERNEL's bridge table and
# then resolved to a uci interface name, rather than from the wifi-iface's own
# `network` option: bridge membership is what actually decides where a client's
# packets go, and it stays true if someone reconfigures the section without
# reloading. The uci lookup is only the bridge-device -> name translation.
net_of_ap() {   # $1 = interface -> prints the network name, or fails
    _m=$(bridge link show dev "$1" 2>/dev/null | sed -n 's/.*master \([^ ]*\).*/\1/p')
    [ -n "$_m" ] || return 1
    for _n in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=interface$/\1/p'); do
        [ "$(uci -q get network.$_n.device 2>/dev/null)" = "$_m" ] && { printf '%s' "$_n"; return 0; }
    done
    # A LAN whose device option is implied rather than written still resolves.
    [ "$_m" = "$LANDEV" ] && { printf 'lan'; return 0; }
    return 1
}

# The skip rule, applied to a network NAME. Split out from the interface-shaped
# test because assoc_net below has already paid for the bridge lookup by the
# time it needs to ask, and resolving the same interface twice on an event path
# is the kind of cost that turns "instant" into "nearly instant".
watched_net() {   # $1 = network name
    [ "$WATCH_ALL" = "1" ] && return 0
    [ -n "$1" ] || return 1
    case " $SKIP_NETS " in *" $1 "*) return 1 ;; esac
    return 0
}

# The hostapd ubus OBJECTS, with their ids. `wifi reload` - which the console's
# own channel and SSID controls trigger - destroys and recreates them, and a
# subscription to the old ones dies with them. Both processes stay alive
# through that, so liveness says everything is fine while nothing is being
# received: exactly the process-is-running-therefore-healthy trap this project
# has been burned by before. The id changes when the object is recreated, so
# comparing this string detects it.
ap_fingerprint() { ubus -v list 2>/dev/null | grep "'hostapd\." | sort; }

# Band from the FREQUENCY, never from the interface name or its index: naming
# is a build detail and radio order is not guaranteed.
band_of() {   # $1 = interface
    iw dev "$1" info 2>/dev/null | awk '/channel/ {
        f=$0; sub(/.*\(/,"",f); sub(/ MHz.*/,"",f)
        print ((f+0) < 3000 ? "2.4" : ((f+0) < 5955 ? "5" : "6")); exit }'
}

ssid_of() {   # $1 = interface
    iwinfo "$1" info 2>/dev/null | sed -n 's/.*ESSID: "\(.*\)"/\1/p' | head -1
}

# The human label for a network. The SSID is what the owner's phone shows and
# what a join message already says, so using it on both sides of the pair is
# what makes them symmetric; the uci name is the fallback when the radio cannot
# be asked, and it is still better than nothing at all.
net_label() {   # $1 = interface  $2 = network name
    _nl=$(ssid_of "$1")
    [ -n "$_nl" ] || _nl=$2
    [ -n "$_nl" ] || _nl="Wi-Fi"
    printf '%s' "$_nl"
}

# Which WATCHED network is this MAC on right now, ignoring one AP?
#
# THIS USED TO ANSWER A DIFFERENT QUESTION - "is it associated ANYWHERE" - and
# both callers read a yes as "still here, say nothing". That made a crossing
# between two watched networks invisible from BOTH ends at once: the join saw it
# still on the old network and stayed quiet, the departure saw it already on the
# new one and stayed quiet, so moving between the main and guest networks - the
# exact event the guest network exists to report - produced no message at all.
# Reproduced in both event orders before it was changed.
#
# The same yes also came back from APs on the SKIP LIST. Joining the main
# network while something held the same MAC on the IoT network was silenced by
# an AP the owner had explicitly asked not to be told about, which is a strictly
# larger bug than the crossing and was hiding underneath it.
#
# So the answer is now a NETWORK, from watched APs only, and the callers compare
# it with the network in front of them. Same network -> a band hop, still
# silent, which is the noise the original guard exists to kill and the one
# behaviour that must not regress. Different network -> a crossing, and news.
#
# Prints "<network> <label>", label last because an SSID may contain spaces. The
# network is "-" when the bridge lookup fails or NOTIFY_WIFI_ALL_APS is on; rc 0
# still means associated, and callers treat "-" as "cannot tell, assume same" -
# conservative, and identical to today rather than a new source of messages.
assoc_net() {   # $1 = mac (lower)  $2 = interface to skip (optional)
    for _i in $(ap_list); do
        [ "$_i" = "$2" ] && continue
        # The cheap test first. The bridge and uci lookups are the expensive
        # half and are paid only for the AP that actually holds this station,
        # which is normally exactly one of them.
        iw dev "$_i" station dump 2>/dev/null | grep -qi "^Station $1" || continue
        _an=$(net_of_ap "$_i" 2>/dev/null)
        watched_net "$_an" || continue
        printf '%s %s' "${_an:--}" "$(net_label "$_i" "$_an")"
        return 0
    done
    return 1
}

# Departures that have outlived the grace period and are still gone.
#
# A pending record is "mac epoch band network label", label last because an SSID
# may contain spaces. The last two fields are what F-069 was missing: without
# the network a departure from the guest side and a departure from the main side
# were byte-identical messages.
resolve_pending() {
    [ -s "$PEND" ] || return 0
    _now=$(date +%s); _keep="$PEND.k"; : > "$_keep"
    while read -r _pm _pt _pb _pn _pl; do
        [ -n "$_pm" ] || continue
        if [ $((_now - _pt)) -lt "$GRACE" ]; then
            printf '%s %s %s %s %s\n' "$_pm" "$_pt" "$_pb" "${_pn:--}" "${_pl:-Wi-Fi}" >> "$_keep"
            continue
        fi
        # A record written by an older build has no network fields at all, and
        # would otherwise compare unequal to everything and report a crossing
        # that did not happen. One restart's worth of them, but a wrong message
        # is the worst thing this program can produce.
        [ -n "$_pl" ] || _pl="Wi-Fi"
        _here=0; _cn=-; _cl=
        if _c=$(assoc_net "$_pm"); then _here=1; _cn=${_c%% *}; _cl=${_c#* }; fi
        if [ "$_here" = 1 ] && [ -n "$_pn" ] && [ "$_pn" != "-" ] && \
           [ "$_cn" != "-" ] && [ "$_cn" != "$_pn" ]; then
            # Gone from the network it left, but present on a different watched
            # one. The join should already have announced this crossing; getting
            # here means that event never arrived - a dropped notification, or an
            # association that predates this process. A late crossing beats the
            # silence, which is what this whole path was producing before.
            notify "$M_WIFI_MOVE_T" \
                 "$(cap_fmt "$M_WIFI_MOVE_B" "$(dev_name "$_pm")" "$_pl" "$_cl")" low iphone
        elif [ "$_here" = 1 ]; then
            :   # back on the same network inside the window - a roam, not news
        else
            # An override written for the OLD two-slot body still has to work,
            # and busybox printf repeats its format rather than ignoring extra
            # arguments, so the sentence would be printed twice if this just fed
            # it three. Count the slots and pass exactly that many.
            # THIS GLOB IS A SECOND PLACE THAT COUNTS SLOTS, and cap_fmt is
            # the first. It survives because it is not really counting - it is
            # choosing WHICH VALUES to pass, and the two arities want different
            # ones: three slots take device, network, band, while the old
            # two-slot form takes device and band, because that sentence had no
            # network in it. No argument order satisfies both, so the choice has
            # to be made before the call.
            #
            # It does share cap_fmt's blind spot without sharing its fix: `%%` is
            # not treated as one token here, so a hand-written override using it
            # could pick the wrong arm. Unreachable today - this router's config
            # holds no MSG_* keys at all - and left alone rather than given a
            # third copy of the counting logic. If cap_fmt's parsing changes,
            # change this with it: they are two, and only this comment says so.
            _dn=$(dev_name "$_pm")
            case "$M_WIFI_LEAVE_B" in
                *%s*%s*%s*) _db=$(cap_fmt "$M_WIFI_LEAVE_B" "$_dn" "$_pl" "$_pb") ;;
                *)          _db=$(cap_fmt "$M_WIFI_LEAVE_B" "$_dn" "$_pb") ;;
            esac
            notify "$M_WIFI_LEAVE_T" "$_db" min iphone
            # Remember that we ANNOUNCED this one. If it reappears shortly the
            # departure was premature in hindsight, and the return is worth
            # phrasing as a return - "back after 22s" tells the owner it was a
            # blip, where a bare "joined" three seconds after a "left" reads as
            # the system contradicting itself.
            grep -v "^$_pm " "$LEFT" 2>/dev/null > "$LEFT.k"
            printf '%s %s\n' "$_pm" "$_now" >> "$LEFT.k"
            mv "$LEFT.k" "$LEFT" 2>/dev/null
        fi
    done < "$PEND"
    if [ -s "$_keep" ]; then mv "$_keep" "$PEND"; else rm -f "$_keep" "$PEND"; fi
}

OBJS=$(ubus list 2>/dev/null | grep '^hostapd\.')
[ -n "$OBJS" ] || exit 0
FP0=$(ap_fingerprint); FPTICK=0

# A FIFO rather than a pipe, so the reader can WAKE ON A TIMER as well as on an
# event. That matters: a held departure has to be confirmed after GRACE seconds
# even if the airwaves then go completely silent, and a plain `ubus | while
# read` only ever wakes when something arrives. Opened read-write so it never
# sees EOF; the subscriber's death is detected explicitly instead, and ending
# the loop lets procd restart the service - the right answer to the event
# source disappearing.
FIFO=/tmp/.wifiwatch.fifo
rm -f "$FIFO"; mkfifo "$FIFO" 2>/dev/null || exit 0
ubus subscribe $OBJS > "$FIFO" 2>/dev/null &
UBPID=$!
exec 3<> "$FIFO"
trap 'kill $UBPID 2>/dev/null; rm -f "$FIFO"' EXIT INT TERM

# Stamp before the first pass rather than 30s into it: the service is up and
# subscribed at this point, and a console that showed it stale for the first
# half minute after every boot would be crying wolf on the most frequent
# condition a travel router has.
beat

while :; do
    kill -0 "$UBPID" 2>/dev/null || break

    # STAMPED HERE, AT THE TOP, and deliberately not at the bottom where it used
    # to be. The body has three `continue`s - hostapd probe/auth chatter, an
    # event whose fields will not parse, and an event on a network we do not
    # report on - and every one of them jumped over a bottom-of-loop stamp. So a
    # busy IoT network, or a burst of association noise, could hold the loop at
    # full speed for minutes while the console reported Wi-Fi alerts stale. That
    # fails safe - a false alarm, never a false all-clear - but a panel that
    # cries wolf is one nobody reads on the day it is right.
    #
    # The top of the body is also the honest place for it: reaching here means
    # the read returned, which IS the loop turning, and it cannot be starved by
    # a `continue` added later. Rate-limited inside beat, so all but one pass in
    # thirty is a /proc read and an arithmetic test.
    #
    # WITH ONE EXCEPTION, AND IT IS THE WHOLE OF WHY THIS IS NOT AN UNCONDITIONAL
    # BEAT. Two of the three `continue`s below are benign and constant - hostapd
    # probe chatter, and events on a network the owner asked not to hear about -
    # and stamping through those is exactly the false-stale this stamp was moved
    # up to kill. The third is not benign: failing to parse an event's address
    # or interface means a REAL event was DISCARDED, and that branch has no
    # logger line of its own, so a hostapd schema change would silently end
    # every Wi-Fi alert. Beating through that would trade a false stale for a
    # false HEALTHY, which is the worse direction.
    #
    # A plain call: whether it actually stamps is beat()'s decision, made in
    # one place so both callers get the same answer.
    beat

    if IFS= read -r -t 1 line <&3; then
        case "$line" in
            *'"sta-authorized"'*|*'"disassoc"'*|*'"deauth"'*) ;;
            *) resolve_pending; continue ;;      # probe/auth/assoc noise
        esac
        mac=$(printf '%s' "$line" | sed -n 's/.*"address":"\([0-9a-fA-F:]*\)".*/\1/p' | tr 'A-F' 'a-f')
        ifc=$(printf '%s' "$line" | sed -n 's/.*"ifname":"\([^"]*\)".*/\1/p')
        if [ -z "$mac" ] || [ -z "$ifc" ]; then
            PFAIL=$((PFAIL + 1))
            # Logged once, as the threshold is crossed, not per event: the log is
            # where the cause is, the panel is where the owner looks, and a line
            # per dropped event would bury the one that matters.
            [ "$PFAIL" = "$PFAIL_MAX" ] && \
                logger -t wifiwatch "cannot parse address/ifname out of hostapd events - $PFAIL in ${PFAIL_WIN}s, events are being dropped; the panel will report this stale"
            resolve_pending; continue
        fi
        # Resolved once and carried, rather than asked for again inside the
        # skip test: the network is now needed by every branch below, not just
        # by the filter.
        net=$(net_of_ap "$ifc" 2>/dev/null)
        # Not a network we report on (IoT by default): drop the event before it
        # can create a pending departure, or a device that only ever lives there
        # would sit in the queue and be announced when its grace expired.
        watched_net "$net" || { resolve_pending; continue; }
        band=$(band_of "$ifc")
        label=$(net_label "$ifc" "$net")

        case "$line" in
            *'"sta-authorized"'*)
                # A pending departure for this MAC means it was moving, not
                # leaving. WHICH KIND of move decides whether it is news, and
                # that is what the network on the pending record is for: back
                # onto the same network is the band hop this debounce exists to
                # swallow; onto a different one is the crossing that used to be
                # silenced from both ends at once.
                if [ -s "$PEND" ] && grep -q "^$mac " "$PEND" 2>/dev/null; then
                    _pnet=; _plab=
                    while read -r _qm _qt _qb _qn _ql; do
                        [ "$_qm" = "$mac" ] || continue
                        _pnet=$_qn; _plab=$_ql; break
                    done < "$PEND"
                    grep -v "^$mac " "$PEND" > "$PEND.k" 2>/dev/null
                    if [ -s "$PEND.k" ]; then mv "$PEND.k" "$PEND"; else rm -f "$PEND.k" "$PEND"; fi
                    # $net is empty only under NOTIFY_WIFI_ALL_APS with an
                    # unbridged AP, and "moved to nowhere" is not a sentence.
                    if [ -n "$net" ] && [ -n "$_pnet" ] && [ "$_pnet" != "-" ] && \
                       [ "$_pnet" != "$net" ]; then
                        notify "$M_WIFI_MOVE_T" \
                             "$(cap_fmt "$M_WIFI_MOVE_B" "$(dev_name "$mac")" \
                                "${_plab:-Wi-Fi}" "$label")" low iphone
                    fi
                elif _o=$(assoc_net "$mac" "$ifc"); then
                    # Already on another watched AP with no departure pending.
                    # Same network -> a band hop, and silent. Different network
                    # -> the crossing, announced HERE, because the matching
                    # departure will (correctly) stay quiet when it arrives.
                    _onet=${_o%% *}; _olab=${_o#* }
                    if [ -n "$net" ] && [ "$_onet" != "-" ] && [ "$_onet" != "$net" ]; then
                        notify "$M_WIFI_MOVE_T" \
                             "$(cap_fmt "$M_WIFI_MOVE_B" "$(dev_name "$mac")" "$_olab" "$label")" \
                             low iphone
                    fi
                else
                    _lt=$(awk -v m="$mac" '$1==m {print $2; exit}' "$LEFT" 2>/dev/null)
                    _away=""
                    if [ -n "$_lt" ]; then
                        _ag=$(( $(date +%s) - _lt ))
                        [ "$_ag" -ge 0 ] && [ "$_ag" -le "$RETURN_WINDOW" ] && {
                            if [ "$_ag" -ge 60 ]; then _away="$((_ag / 60))m"; else _away="${_ag}s"; fi
                        }
                        grep -v "^$mac " "$LEFT" 2>/dev/null > "$LEFT.k"
                        if [ -s "$LEFT.k" ]; then mv "$LEFT.k" "$LEFT"; else rm -f "$LEFT.k" "$LEFT"; fi
                    fi
                    if [ -n "$_away" ]; then
                        notify "$M_WIFI_BACK_T" \
                             "$(cap_fmt "$M_WIFI_BACK_B" "$(dev_name "$mac")" "$_away")" low iphone
                    else
                        # the label, not a second ssid_of: same string when the
                        # radio answers, and the network name rather than an
                        # empty gap in the sentence when it does not
                        notify "$M_WIFI_JOIN_T" \
                             "$(cap_fmt "$M_WIFI_JOIN_B" "$(dev_name "$mac")" "$label" "$band")" \
                             low iphone
                    fi
                fi
                ;;
            *)
                # Still on another WATCHED AP at this instant? Then this is
                # either hostapd pruning the old association after a band hop or
                # the tail of a crossing whose join has already been announced
                # above. Either way it is decided, not pending, and silent.
                #
                # Watched only, deliberately: an AP on the skip list answering
                # "yes" here is how a real departure from the main network used
                # to be swallowed by the IoT radio.
                if assoc_net "$mac" "$ifc" >/dev/null; then
                    :
                else
                    grep -q "^$mac " "$PEND" 2>/dev/null || \
                        printf '%s %s %s %s %s\n' "$mac" "$(date +%s)" "$band" \
                            "${net:--}" "$label" >> "$PEND"
                fi
                ;;
        esac
    fi
    # runs on every event AND on every 1s timeout, so a held departure is
    # confirmed within a second of its grace expiring rather than up to five
    # seconds later - the read timeout was the real floor on how fast a
    # departure could be reported, not the grace itself
    resolve_pending

    # Re-check the subscription target, not just the process. If hostapd's
    # objects were rebuilt underneath us the subscriber is deaf; ending the
    # loop is procd's cue to restart the whole thing against the new ones.
    # Worst-case deafness is one tick.
    FPTICK=$((FPTICK + 1))
    if [ "$FPTICK" -ge 15 ] && [ "$(ap_fingerprint)" != "$FP0" ]; then
        logger -t wifiwatch "hostapd ubus objects changed (wifi reload?) - restarting to resubscribe"
        break
    fi
    [ "$FPTICK" -ge 15 ] && FPTICK=0
done
exit 0
