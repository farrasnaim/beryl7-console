#!/bin/sh
# /usr/sbin/wifiwatch — real-time Wi-Fi arrivals and departures.
#
# WHY THIS EXISTS SEPARATELY FROM notifymon. notifymon runs from cron, so the
# fastest it can ever be is a minute, and the presence file it reads is written
# by dashmon on the same minute cadence. For "is the internet down" a minute is
# nothing. For "who just walked in" it is the whole point, and the owner said
# so.
#
# WHAT IT LISTENS TO. hostapd publishes ubus notifications per AP. Verified on
# this router rather than assumed - a subscriber was attached and one
# association was deliberately provoked to read the names off the wire:
#
#   join   sta-authorized   (fires after the handshake, when the client is
#                            actually usable - `assoc` fires earlier, before
#                            the key exchange, and would announce a device
#                            that may still fail to join)
#   leave  disassoc | deauth | local-deauth
#
# THE HARD PART IS NOT SPEED, IT IS ROAMING. Measured here: hostapd logged 22
# connect/disconnect lines in one hour while only 2 were real arrivals - a
# phone hopping 2.4 <-> 5 GHz produces a disassoc and an assoc every time, and
# announcing those would make the alerts worthless within a day. dashmon avoids
# this by only sampling once a minute, which is exactly the latency being
# removed here, so the debounce has to be rebuilt properly:
#
#   JOIN  is announced only if the device is not already associated on ANOTHER
#         AP at that moment. A band hop therefore announces nothing.
#   LEAVE cannot be judged instantly - "gone" and "moving" look identical for a
#         second or two - so it is held for GRACE seconds and then confirmed
#         against every AP. Anything that came back is silently dropped.
#
# So joins are instant and leaves take GRACE. That asymmetry is physics, not a
# shortcut: no amount of engineering can tell a departure from a roam at the
# instant the frame arrives.
#
# WHAT IT IS ALLOWED TO DO. It sends messages. It never restarts a service,
# never writes uci, never touches the radios - the same invariant pingmon
# carries. The worst failure it can produce is a wrong message.

CONF=/etc/dashboard/notify.conf
PEND=/tmp/.wifipend
# MEASURED TWICE, and the second measurement corrected the first. Counting all
# disconnect->reconnect gaps together said "74% within 10s" and produced a 10s
# grace. But that mixed two populations. Split by whether the device came back
# on a DIFFERENT radio (a roam) or the same one (a blip, a sleep, an off/on):
#
#   roam, n=38      53% return within ONE second, then a clean gap with ZERO
#                   samples at 2-3s, a small 4-10s cluster, and a >10s tail
#                   that is not roaming at all - those are real departures that
#                   happened to come back on the other band.
#   same radio, n=171   median ONE second: power-save wakeups and retries.
#
# So nearly all of the noise is over within a second, and the 10s grace was
# paying nine seconds of delay for almost nothing. 3s sits inside the empty
# 2-3s band: past the fast roams, well short of a human noticing.
#
# It stays a knob, because the tail overlaps: a handful of roams take 4-10s and
# will produce a departure followed by a "back after Ns". That is the honest
# trade for reporting a real disconnect in about three seconds.

# How long a device may return and still be described as coming BACK rather
# than arriving. Beyond this it is treated as a fresh arrival.
LEFT=/tmp/.wifileft

# Which access points are worth a message, named by the NETWORK behind them.
#
# This used to be "only APs bridged onto the main LAN", which was the right
# answer while the only other network was IoT - a house full of smart plugs
# reconnects all day and none of it is news. It became the wrong answer the
# moment a guest network existed: guests are people, their arrivals and
# departures are exactly the thing worth knowing about, and a LAN-only test
# silently excluded them for the same reason it excluded the plugs.
#
# So the rule is now a skip LIST rather than an allow-one. Default skips `iot`
# alone; everything else - lan, guest, whatever comes next - notifies like the
# main network does. NOTIFY_WIFI_SKIP overrides it (space separated), and
# NOTIFY_WIFI_ALL_APS=1 still reports absolutely everything.

# The config is PARSED, not sourced. It carries a value written by the web UI,
# and `.` would run it as a shell script every minute as root. conf_load reads
# it as data; see the note on that function. There is no fallback to `.` here
# on purpose - if the library is missing the safe outcome is not to run.
BERYL_LIB=/usr/share/beryl/cgi-lib.sh
if [ -r "$BERYL_LIB" ]; then
    . "$BERYL_LIB"
else
    logger -t wifiwatch "missing $BERYL_LIB - cannot read the config safely, not running"
    exit 0
fi

conf_load "$CONF" || exit 0
[ "$NOTIFY_ENABLED" = "1" ] || exit 0
[ -n "$NOTIFY_URL" ] || exit 0
[ "${NOTIFY_WIFI:-1}" = "1" ] || exit 0

# NOTE: every ${NOTIFY_*:-default} below MUST stay after the source above.
# They were written before it and silently used their defaults forever - the
# knobs were documented, advertised to the owner, and dead. A default that
# happens to be sensible hides this completely.
GRACE=${NOTIFY_WIFI_GRACE:-3}
RETURN_WINDOW=${NOTIFY_WIFI_RETURN:-600}
WATCH_ALL=${NOTIFY_WIFI_ALL_APS:-0}
SKIP_NETS=${NOTIFY_WIFI_SKIP:-iot}

HOSTN=$(uci -q get system.@system[0].hostname 2>/dev/null); HOSTN=${HOSTN:-router}
M_WIFI_JOIN_T=${MSG_WIFI_JOIN_T:-"device joined Wi-Fi"}
M_WIFI_JOIN_B=${MSG_WIFI_JOIN_B:-"%s connected to %s on %s GHz."}
M_WIFI_LEAVE_T=${MSG_WIFI_LEAVE_T:-"device left Wi-Fi"}
M_WIFI_LEAVE_B=${MSG_WIFI_LEAVE_B:-"%s disconnected from %s GHz."}
# %s = device, %s = how long it was away
M_WIFI_BACK_T=${MSG_WIFI_BACK_T:-"device is back"}
M_WIFI_BACK_B=${MSG_WIFI_BACK_B:-"%s reconnected after %s away."}

# THE QUEUE IS NOTIFYMON'S, DELIBERATELY. A second retry mechanism here would
# be a second thing to get wrong, and the two would race for the same topic.
# notifymon drains this file every minute from cron, oldest first, stopping at
# the first failure so ordering survives - so appending to it is the whole of
# what this needs to do.
#
# It matters most on exactly the paths this router exists for: a captive portal,
# a dead uplink, a DNS outage. wget failed on every one of those and the alert
# was discarded with nothing recording that it had ever existed, which is the
# worst possible behaviour for a device whose job is telling you what happened
# while you were not looking.
QUEUE=/tmp/.notifyq
QMAX=25
QDROP=/tmp/.notifyqdrop

send() {   # $1 title  $2 body  $3 priority  $4 tags
    wget -q -T 8 -O /dev/null \
        --header="Title: $HOSTN: $1" \
        --header="Priority: ${3:-default}" \
        --header="Tags: ${4:-iphone}" \
        --post-data="$2" "$NOTIFY_URL" 2>/dev/null
}

# Send, and keep it if the send fails. The body carries the time the event
# actually happened, because a Wi-Fi join delivered an hour late is misleading
# without it - the same reason notifymon stamps its own queued messages.
notify() {  # $1 title  $2 body  $3 priority  $4 tags
    send "$1" "$2" "$3" "$4" && return 0
    if [ -f "$QUEUE" ] && [ "$(wc -l < "$QUEUE" 2>/dev/null)" -ge "$QMAX" ]; then
        _d=0; [ -r "$QDROP" ] && read -r _d < "$QDROP" 2>/dev/null
        case "$_d" in ''|*[!0-9]*) _d=0 ;; esac
        printf '%s\n' "$((_d + 1))" > "$QDROP" 2>/dev/null
        logger -t wifiwatch "alert queue full ($QMAX) - dropped: $1"
        return 0
    fi
    # A literal | would split into the wrong fields when notifymon reads this
    # back. Names come from the class map, which is itself |-separated and so
    # cannot contain one, but the guard costs nothing and does not depend on
    # that staying true.
    printf '%s|%s|%s|%s\n' \
        "$(printf '%s' "$1" | tr -d '|')" \
        "$(date '+%H:%M') — $(printf '%s' "$2" | tr -d '|')" \
        "$3" "$4" >> "$QUEUE" 2>/dev/null
    logger -t wifiwatch "notification send failed - queued for notifymon to retry"
}

# Names come from the class map, so the phone and the console agree on what a
# device is called; the MAC is the honest fallback.
dev_name() {
    _n=$(awk -F'|' -v m="$1" '!/^#/ && tolower($1)==m {print $2; exit}' \
         /etc/dashboard/classmap 2>/dev/null)
    [ -n "$_n" ] || _n=$(awk -v m="$1" '$2==m {print $4; exit}' /tmp/dhcp.leases 2>/dev/null)
    [ -n "$_n" ] && [ "$_n" != "*" ] || _n="$1"
    printf '%s' "$_n"
}

ap_list() { iw dev 2>/dev/null | awk '/^\tInterface /{print $2}'; }

# Is this AP one we report on? Answered from the KERNEL's bridge table rather
# than from uci section names or an interface-name pattern: an AP carrying the
# main network is a port of the LAN bridge, and the IoT AP is a port of its
# own. Naming is a build detail - "iot2g" here, something else on the next
# router - but bridge membership is what actually decides which network a
# client lands on, so it is the honest thing to key on.
LANDEV=$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
[ -n "$LANDEV" ] || LANDEV=br-lan
# Which network is behind this AP. Answered from the KERNEL's bridge table and
# then resolved to a uci interface name, rather than from the wifi-iface's own
# `network` option: bridge membership is what actually decides where a client's
# packets go, and it stays true if someone reconfigures the section without
# reloading. The uci lookup is only the bridge-device -> name translation.
net_of_ap() {   # $1 = interface -> prints the network name, or fails
    _m=$(bridge link show dev "$1" 2>/dev/null | sed -n 's/.*master \([^ ]*\).*/\1/p')
    [ -n "$_m" ] || return 1
    for _n in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=interface$/\1/p'); do
        [ "$(uci -q get network.$_n.device 2>/dev/null)" = "$_m" ] && { printf '%s' "$_n"; return 0; }
    done
    # A LAN whose device option is implied rather than written still resolves.
    [ "$_m" = "$LANDEV" ] && { printf 'lan'; return 0; }
    return 1
}

watched_ap() {   # $1 = interface
    [ "$WATCH_ALL" = "1" ] && return 0
    _wn=$(net_of_ap "$1") || return 1
    case " $SKIP_NETS " in *" $_wn "*) return 1 ;; esac
    return 0
}

# The hostapd ubus OBJECTS, with their ids. `wifi reload` - which the console's
# own channel and SSID controls trigger - destroys and recreates them, and a
# subscription to the old ones dies with them. Both processes stay alive
# through that, so liveness says everything is fine while nothing is being
# received: exactly the process-is-running-therefore-healthy trap this project
# has been burned by before. The id changes when the object is recreated, so
# comparing this string detects it.
ap_fingerprint() { ubus -v list 2>/dev/null | grep "'hostapd\." | sort; }

# Band from the FREQUENCY, never from the interface name or its index: naming
# is a build detail and radio order is not guaranteed.
band_of() {   # $1 = interface
    iw dev "$1" info 2>/dev/null | awk '/channel/ {
        f=$0; sub(/.*\(/,"",f); sub(/ MHz.*/,"",f)
        print ((f+0) < 3000 ? "2.4" : ((f+0) < 5955 ? "5" : "6")); exit }'
}

ssid_of() {   # $1 = interface
    iwinfo "$1" info 2>/dev/null | sed -n 's/.*ESSID: "\(.*\)"/\1/p' | head -1
}

# Is this MAC associated anywhere right now, optionally ignoring one AP?
assoc_anywhere() {   # $1 = mac (lower)  $2 = interface to skip (optional)
    for _i in $(ap_list); do
        [ "$_i" = "$2" ] && continue
        iw dev "$_i" station dump 2>/dev/null | grep -qi "^Station $1" && return 0
    done
    return 1
}

# Departures that have outlived the grace period and are still gone.
resolve_pending() {
    [ -s "$PEND" ] || return 0
    _now=$(date +%s); _keep="$PEND.k"; : > "$_keep"
    while read -r _pm _pt _pb; do
        [ -n "$_pm" ] || continue
        if [ $((_now - _pt)) -lt "$GRACE" ]; then
            printf '%s %s %s\n' "$_pm" "$_pt" "$_pb" >> "$_keep"
        elif assoc_anywhere "$_pm"; then
            :   # came back inside the window - a roam, and not news
        else
            notify "$M_WIFI_LEAVE_T" "$(printf "$M_WIFI_LEAVE_B" "$(dev_name "$_pm")" "$_pb")" \
                 min iphone
            # Remember that we ANNOUNCED this one. If it reappears shortly the
            # departure was premature in hindsight, and the return is worth
            # phrasing as a return - "back after 22s" tells the owner it was a
            # blip, where a bare "joined" three seconds after a "left" reads as
            # the system contradicting itself.
            grep -v "^$_pm " "$LEFT" 2>/dev/null > "$LEFT.k"
            printf '%s %s\n' "$_pm" "$_now" >> "$LEFT.k"
            mv "$LEFT.k" "$LEFT" 2>/dev/null
        fi
    done < "$PEND"
    if [ -s "$_keep" ]; then mv "$_keep" "$PEND"; else rm -f "$_keep" "$PEND"; fi
}

OBJS=$(ubus list 2>/dev/null | grep '^hostapd\.')
[ -n "$OBJS" ] || exit 0
FP0=$(ap_fingerprint); FPTICK=0

# A FIFO rather than a pipe, so the reader can WAKE ON A TIMER as well as on an
# event. That matters: a held departure has to be confirmed after GRACE seconds
# even if the airwaves then go completely silent, and a plain `ubus | while
# read` only ever wakes when something arrives. Opened read-write so it never
# sees EOF; the subscriber's death is detected explicitly instead, and ending
# the loop lets procd restart the service - the right answer to the event
# source disappearing.
FIFO=/tmp/.wifiwatch.fifo
rm -f "$FIFO"; mkfifo "$FIFO" 2>/dev/null || exit 0
ubus subscribe $OBJS > "$FIFO" 2>/dev/null &
UBPID=$!
exec 3<> "$FIFO"
trap 'kill $UBPID 2>/dev/null; rm -f "$FIFO"' EXIT INT TERM

while :; do
    kill -0 "$UBPID" 2>/dev/null || break
    if IFS= read -r -t 1 line <&3; then
        case "$line" in
            *'"sta-authorized"'*|*'"disassoc"'*|*'"deauth"'*) ;;
            *) resolve_pending; continue ;;      # probe/auth/assoc noise
        esac
        mac=$(printf '%s' "$line" | sed -n 's/.*"address":"\([0-9a-fA-F:]*\)".*/\1/p' | tr 'A-F' 'a-f')
        ifc=$(printf '%s' "$line" | sed -n 's/.*"ifname":"\([^"]*\)".*/\1/p')
        [ -n "$mac" ] && [ -n "$ifc" ] || { resolve_pending; continue; }
        # Not an AP we report on (the IoT SSID by default): drop the event
        # before it can create a pending departure, or a device that only ever
        # lives there would sit in the queue and be announced when its grace
        # expired.
        watched_ap "$ifc" || { resolve_pending; continue; }
        band=$(band_of "$ifc")

        case "$line" in
            *'"sta-authorized"'*)
                # A pending departure for this MAC means it was moving, not
                # leaving: cancel it and say nothing.
                if [ -s "$PEND" ] && grep -q "^$mac " "$PEND" 2>/dev/null; then
                    grep -v "^$mac " "$PEND" > "$PEND.k" 2>/dev/null
                    if [ -s "$PEND.k" ]; then mv "$PEND.k" "$PEND"; else rm -f "$PEND.k" "$PEND"; fi
                elif ! assoc_anywhere "$mac" "$ifc"; then
                    _lt=$(awk -v m="$mac" '$1==m {print $2; exit}' "$LEFT" 2>/dev/null)
                    _away=""
                    if [ -n "$_lt" ]; then
                        _ag=$(( $(date +%s) - _lt ))
                        [ "$_ag" -ge 0 ] && [ "$_ag" -le "$RETURN_WINDOW" ] && {
                            if [ "$_ag" -ge 60 ]; then _away="$((_ag / 60))m"; else _away="${_ag}s"; fi
                        }
                        grep -v "^$mac " "$LEFT" 2>/dev/null > "$LEFT.k"
                        if [ -s "$LEFT.k" ]; then mv "$LEFT.k" "$LEFT"; else rm -f "$LEFT.k" "$LEFT"; fi
                    fi
                    if [ -n "$_away" ]; then
                        notify "$M_WIFI_BACK_T" \
                             "$(printf "$M_WIFI_BACK_B" "$(dev_name "$mac")" "$_away")" low iphone
                    else
                        notify "$M_WIFI_JOIN_T" \
                             "$(printf "$M_WIFI_JOIN_B" "$(dev_name "$mac")" "$(ssid_of "$ifc")" "$band")" \
                             low iphone
                    fi
                fi
                ;;
            *)
                # If the device is ALREADY on another radio at this instant,
                # this is hostapd pruning the old association after a roam -
                # decided, not pending. Costs nothing and removes the delay
                # entirely for the commonest case.
                if assoc_anywhere "$mac" "$ifc"; then
                    :
                else
                    grep -q "^$mac " "$PEND" 2>/dev/null || \
                        printf '%s %s %s\n' "$mac" "$(date +%s)" "$band" >> "$PEND"
                fi
                ;;
        esac
    fi
    # runs on every event AND on every 1s timeout, so a held departure is
    # confirmed within a second of its grace expiring rather than up to five
    # seconds later - the read timeout was the real floor on how fast a
    # departure could be reported, not the grace itself
    resolve_pending

    # Re-check the subscription target, not just the process. If hostapd's
    # objects were rebuilt underneath us the subscriber is deaf; ending the
    # loop is procd's cue to restart the whole thing against the new ones.
    # Worst-case deafness is one tick.
    FPTICK=$((FPTICK + 1))
    if [ "$FPTICK" -ge 15 ] && [ "$(ap_fingerprint)" != "$FP0" ]; then
        logger -t wifiwatch "hostapd ubus objects changed (wifi reload?) - restarting to resubscribe"
        break
    fi
    [ "$FPTICK" -ge 15 ] && FPTICK=0
done
exit 0
