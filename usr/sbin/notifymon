#!/bin/sh
# /usr/sbin/notifymon — push a message when something the console would have
# shown you actually changes.
#
# WHY THIS EXISTS. Every detector on this router is a PULL: the console shows
# the fault correctly, but only to someone looking at it. The faults that cost
# real time this month all happened silently — IPv6 relayed a poisoned DNS
# server for hours, accounting lost a third of all traffic for days, encrypted
# DNS upstreams stalled twenty seconds at a time — and each was found by
# someone going looking, days late. This is the same facts, pushed.
#
# WHAT IT IS ALLOWED TO DO. It sends HTTP POSTs and writes two files in /tmp.
# It never restarts a service, never touches uci, never repairs anything. Same
# invariant as the probe: the worst failure it can produce is a wrong message.
# A monitor that also acts is the shape of the automation that caused the
# 2026-08-10 incident, and this deliberately is not one.
#
# EDGE-TRIGGERED, NOT LEVEL-TRIGGERED. Cron runs this every minute; a state
# that is still wrong is not news. Only transitions are sent, so a WAN that is
# down for six hours costs exactly two messages. That is the same cry-wolf
# reasoning already written into the firewall detector: an alert that repeats
# is one the owner learns to swipe away, and then misses the one that mattered.
#
# THE QUEUE IS THE WHOLE POINT. The most important message — "the internet is
# down" — is precisely the one that cannot be delivered when it happens. So a
# failed send is queued and retried on later runs, and the message carries the
# time the event HAPPENED rather than pretending it just did. Without this the
# tool would work for everything except its headline case.
#
# WHAT IT SENDS: interface and service state only. No addresses, no keys, no
# device names, no traffic contents. Assume the topic is readable by anyone who
# learns its name (it is, on the public ntfy service) and keep it that way.

CONF=/etc/dashboard/notify.conf

# Link-quality thresholds. Overridable in notify.conf; the defaults are set
# against this line's MEASURED idle behaviour (about 13-15 ms, jitter under
# 1 ms, zero loss), not against a generic idea of "slow".
#
# 150 ms is roughly ten times the normal round trip - not "a bit worse", but
# the range where calls break up and games become unplayable. 5% loss is where
# TCP throughput visibly collapses.
#
# THREE CONSECUTIVE MINUTES, and a lower bar to clear than to trip. A single
# bad minute is a torrent starting or a neighbour's microwave, and alerting on
# it is how an owner learns to ignore the alerts. The gap between the trip and
# clear levels stops a link hovering at the threshold from flapping the phone
# all evening.
# EVERYTHING THIS WRITES IS PRIVATE. cron runs this with a 022 umask, so the
# alert queue landed world-readable - and since wifiwatch started reporting the
# guest network, that queue carries guest SSIDs and guest device names. There
# are no non-root accounts on this router today, which is precisely why nobody
# noticed; the next person to add one inherits the list. Set before the first
# file is created rather than chmod'ing afterwards, so there is no window.
umask 077

STATE=/tmp/.notifystate
QUEUE=/tmp/.notifyq
QMAX=25
QDROP=/tmp/.notifyqdrop

# Both writers of the queue take this lock. See drain_queue for why the queue
# needed one at all, and why nothing waits on the network while holding it.
QLOCK=/tmp/.notifyq.lock

# Files created before the umask above existed keep their old mode, so correct
# them once. Only when they exist, which on a healthy router is almost never.
{ [ -f "$QUEUE" ] || [ -f "$QDROP" ]; } && chmod 0600 "$QUEUE" "$QDROP" 2>/dev/null

# ---- heartbeat -------------------------------------------------------------
# The console's Jobs panel calls a cron program healthy when /tmp/.hb-<name> is
# under 150s old. This program was in the crontab for a day writing NOTHING to
# /tmp, so it was invisible there: it could have been dead the whole time and no
# surface would have moved. Written on every path that completes normally -
# including the idle ones, because "notifications are switched off" is notifymon
# working correctly with nothing to do, not notifymon failing. The one path that
# deliberately does NOT beat is a missing cgi-lib, where the program genuinely
# cannot function and reporting it stale is the true answer.
HB=/tmp/.hb-${0##*/}
beat() { read -r _hb _ < /proc/uptime 2>/dev/null; printf '%s\n' "${_hb%.*}" > "$HB" 2>/dev/null; return 0; }

# The config is PARSED, not sourced. It carries a value written by the web UI,
# and `.` would run it as a shell script every minute as root. conf_load reads
# it as data; see the note on that function. There is no fallback to `.` here
# on purpose - if the library is missing the safe outcome is not to run.
BERYL_LIB=/usr/share/beryl/cgi-lib.sh
if [ -r "$BERYL_LIB" ]; then
    . "$BERYL_LIB"
else
    logger -t notifymon "missing $BERYL_LIB - cannot read the config safely, not running"
    exit 0
fi

conf_load "$CONF" || { beat; exit 0; }
[ "$NOTIFY_ENABLED" = "1" ] || { beat; exit 0; }
[ -n "$NOTIFY_URL" ] || { beat; exit 0; }

# NOTE: every ${NOTIFY_*:-default} below MUST stay after the source above.
# They were written before it and silently used their defaults forever - the
# knobs were documented, advertised to the owner, and dead. A default that
# happens to be sensible hides this completely.
RTT_BAD=${NOTIFY_RTT_MS:-150}
RTT_OK=${NOTIFY_RTT_OK_MS:-80}
LOSS_BAD=${NOTIFY_LOSS_PCT:-5}
LOSS_OK=${NOTIFY_LOSS_OK_PCT:-2}
NEED=${NOTIFY_DEGRADE_MINUTES:-3}

HOSTN=$(uci -q get system.@system[0].hostname 2>/dev/null); HOSTN=${HOSTN:-router}

# ---- wording ---------------------------------------------------------------
# Every line below can be overridden in notify.conf without touching this file,
# which matters because a console reinstall replaces this script and never
# touches that config. Nor does the Settings page: its notification Save owns
# NOTIFY_ENABLED and NOTIFY_URL and copies every other key through untouched.
# It did not always - until 2026-08-31 it wrote two lines over the whole file
# and silently erased every override in it, while this comment promised the
# opposite. Set any of these there to reword a message:
#
#     MSG_WAN_DOWN_T="internet mati"
#     MSG_WAN_DOWN_B="Koneksi WAN terputus."
#
# %s in a body is filled with live values where the comment says so; a message
# with no %s is used verbatim. Never put a | in one - it separates fields in
# the retry queue.
#
# THE SLOT COUNT IS PART OF THE CONTRACT, and getting it wrong used to be worse
# than a typo: busybox printf REPEATS its whole format when handed more
# arguments than conversions, so a caption reworded with one %s too few printed
# the entire sentence twice. Every caption here now goes through cap_fmt, which
# passes only as many values as the format has slots, so a wrong count degrades
# instead of doubling. Match the count in the comment above each caption anyway
# - cap_fmt stops the damage, it cannot guess what you meant.
M_HELLO_T=${MSG_HELLO_T:-"monitoring started"}
M_HELLO_B=${MSG_HELLO_B:-"Watching the internet link, connection quality, VPN tunnels, Wi-Fi devices, IPv6, firewall, DNS upstreams and traffic accounting."}
M_WAN_DOWN_T=${MSG_WAN_DOWN_T:-"internet is down"}
M_WAN_DOWN_B=${MSG_WAN_DOWN_B:-"The WAN interface lost its connection."}
M_WAN_UP_T=${MSG_WAN_UP_T:-"internet is back"}
M_WAN_UP_B=${MSG_WAN_UP_B:-"The WAN interface reconnected."}
M_V6_DOWN_T=${MSG_V6_DOWN_T:-"IPv6 is down"}
M_V6_DOWN_B=${MSG_V6_DOWN_B:-"IPv4 is unaffected. A third of this line's traffic normally goes over IPv6."}
M_V6_UP_T=${MSG_V6_UP_T:-"IPv6 is back"}
M_V6_UP_B=${MSG_V6_UP_B:-"The IPv6 uplink recovered."}
M_FW_DOWN_T=${MSG_FW_DOWN_T:-"FIREWALL IS NOT LOADED"}
M_FW_DOWN_B=${MSG_FW_DOWN_B:-"The kernel has no ruleset. The console has no password and relies on the firewall - treat this as urgent."}
M_FW_UP_T=${MSG_FW_UP_T:-"firewall reloaded"}
M_FW_UP_B=${MSG_FW_UP_B:-"The ruleset is back in the kernel."}
M_ACCT_DOWN_T=${MSG_ACCT_DOWN_T:-"traffic accounting stopped"}
M_ACCT_DOWN_B=${MSG_ACCT_DOWN_B:-"Per-device usage is no longer being counted."}
M_ACCT_UP_T=${MSG_ACCT_UP_T:-"traffic accounting running"}
M_ACCT_UP_B=${MSG_ACCT_UP_B:-"Per-device usage is being counted again."}
M_PROBE_DOWN_T=${MSG_PROBE_DOWN_T:-"connection probe stopped"}
M_PROBE_DOWN_B=${MSG_PROBE_DOWN_B:-"Latency and loss are no longer being measured, so the connection-quality alert cannot fire."}
M_PROBE_UP_T=${MSG_PROBE_UP_T:-"connection probe running"}
M_PROBE_UP_B=${MSG_PROBE_UP_B:-"Latency and loss are being measured again."}
# %s = how many alerts were dropped while the queue was full
M_QDROP_T=${MSG_QDROP_T:-"some alerts were lost"}
M_QDROP_B=${MSG_QDROP_B:-"%s alert(s) were dropped while this router could not reach the notification service. Everything since has been delivered."}
M_DNS_BAD_T=${MSG_DNS_BAD_T:-"encrypted DNS is stalling"}
M_DNS_BAD_B=${MSG_DNS_BAD_B:-"Two or more upstream lookups timed out in the last half hour. Pages may load slowly; retries usually succeed."}
M_DNS_OK_T=${MSG_DNS_OK_T:-"encrypted DNS recovered"}
M_DNS_OK_B=${MSG_DNS_OK_B:-"Upstream lookups are answering again."}
# %s = rtt, %s = loss
M_LINK_BAD_T=${MSG_LINK_BAD_T:-"connection is struggling"}
M_LINK_BAD_B=${MSG_LINK_BAD_B:-"Latency %s ms and %s%% packet loss, held for several minutes. Calls and games will feel it."}
M_LINK_OK_T=${MSG_LINK_OK_T:-"connection is steady again"}
M_LINK_OK_B=${MSG_LINK_OK_B:-"Back to %s ms with %s%% loss."}
# %s = tunnel name
M_VPN_DOWN_T=${MSG_VPN_DOWN_T:-"VPN tunnel is down"}
M_VPN_DOWN_B=${MSG_VPN_DOWN_B:-"%s stopped answering. Devices routed through it are affected."}
M_VPN_UP_T=${MSG_VPN_UP_T:-"VPN tunnel is back"}
M_VPN_UP_B=${MSG_VPN_UP_B:-"%s is handshaking again."}
# %s = device name, %s = tunnel name
M_VPNDEV_ON_T=${MSG_VPNDEV_ON_T:-"device now on the VPN"}
M_VPNDEV_ON_B=${MSG_VPNDEV_ON_B:-"%s is being routed through %s."}
M_VPNDEV_OFF_T=${MSG_VPNDEV_OFF_T:-"device left the VPN"}
M_VPNDEV_OFF_B=${MSG_VPNDEV_OFF_B:-"%s is back on the normal uplink."}
M_VPNDEV_PAUSE_T=${MSG_VPNDEV_PAUSE_T:-"VPN routing auto-paused"}
M_VPNDEV_PAUSE_B=${MSG_VPNDEV_PAUSE_B:-"A tunnel stopped answering, so routed devices were released to the normal uplink to keep them online. Their traffic is not private until it returns."}

# `|` is the field separator in the queue and nothing generated here contains
# one — every message in this file is a literal written above.
send() {   # $1 title  $2 body  $3 priority  $4 tags
    wget -q -T 8 -O /dev/null \
        --header="Title: $HOSTN: $1" \
        --header="Priority: ${3:-default}" \
        --header="Tags: ${4:-bell}" \
        --post-data="$2" "$NOTIFY_URL" 2>/dev/null
}

queue() { # same args; called when send failed
    # A FULL QUEUE USED TO DROP IN SILENCE. The message was gone, nothing
    # recorded that it had existed, and the owner's only clue was an alert that
    # never arrived - indistinguishable from nothing having happened. Count the
    # drops instead; flush_queue reports the total once delivery works again,
    # which is the moment the owner can actually be told.
    #
    # Under the lock, all of it: wifiwatch appends to the same file and reads
    # the same counter, so two writers deciding independently that there was one
    # slot left is the same class of bug as the drain race below.
    #
    # No `return` inside the block - the lock is released by the brace group's
    # redirection closing, and jumping out of it only makes that harder to read.
    {
        flock -x 9 2>/dev/null
        if [ -f "$QUEUE" ] && [ "$(wc -l < "$QUEUE" 2>/dev/null)" -ge "$QMAX" ]; then
            _d=0; [ -r "$QDROP" ] && read -r _d < "$QDROP" 2>/dev/null
            case "$_d" in ''|*[!0-9]*) _d=0 ;; esac
            printf '%s\n' "$((_d + 1))" > "$QDROP" 2>/dev/null
            logger -t notifymon "alert queue full ($QMAX) - dropped: $1"
        else
            printf '%s|%s|%s|%s\n' "$1" "$2" "$3" "$4" >> "$QUEUE" 2>/dev/null
        fi
    } 9>>"$QLOCK" 2>/dev/null
}

notify() { # $1 title $2 body $3 priority $4 tags
    if ! send "$1" "$2" "$3" "$4"; then
        queue "$1" "$(date '+%H:%M') — $2" "$3" "$4"
    fi
}

# Drain anything stranded by an outage. Stop at the first failure so ordering
# survives and the retry is not a send storm against a link that is still down.
flush_queue() {
    # The drain is CONDITIONAL, the drop report is not. An early `return` here
    # when the queue is empty would put the report below out of reach in exactly
    # the case it exists for - drops recorded, queue since emptied - and the
    # count would sit in /tmp forever with nobody told.
    # $QUEUE.w is the in-flight copy drain_queue works from. It only exists if a
    # previous run died mid-drain, and it holds real alerts, so it is a reason to
    # drain even when the queue itself is gone.
    { [ -s "$QUEUE" ] || [ -s "$QUEUE.w" ]; } && drain_queue
    report_drops
}

drain_queue() {
    # TAKE THE QUEUE, THEN SEND. This used to read $QUEUE in place and write the
    # remainder back over the top, so an append from wifiwatch landing in that
    # window was overwritten - and overwritten in silence, because the drop
    # counter is only touched when the queue is FULL. Measured before it was
    # changed: one line appended a second into a three-second drain vanished and
    # no counter appeared. An alert the owner never saw and nothing said existed
    # is the exact failure the queue was built to prevent.
    #
    # The rename is what makes the lock cheap. Holding it across the sends
    # instead would be fewer lines and would block wifiwatch's event loop for as
    # long as a stalled wget takes - on the very link outage that fills this
    # queue in the first place, and while it is trying to report who just walked
    # in. So: rename under the lock, send unlocked, merge back under the lock.
    _tmp="$QUEUE.w"
    { flock -x 9 2>/dev/null; mv "$QUEUE" "$_tmp" 2>/dev/null; } 9>>"$QLOCK" 2>/dev/null
    [ -s "$_tmp" ] || { rm -f "$_tmp"; return 0; }
    _un="$QUEUE.u"; : > "$_un"
    _stuck=0
    while IFS='|' read -r _t _b _p _g; do
        [ -n "$_t" ] || continue
        if [ "$_stuck" = 1 ]; then
            printf '%s|%s|%s|%s\n' "$_t" "$_b" "$_p" "$_g" >> "$_un"
        elif ! send "$_t" "$_b" "$_p" "$_g"; then
            _stuck=1
            printf '%s|%s|%s|%s\n' "$_t" "$_b" "$_p" "$_g" >> "$_un"
        fi
    done < "$_tmp"
    rm -f "$_tmp"
    # The undelivered remainder goes back IN FRONT of anything that arrived while
    # the sends were running, so the file stays oldest-first for the next drain.
    if [ -s "$_un" ]; then
        {
            flock -x 9 2>/dev/null
            [ -s "$QUEUE" ] && cat "$QUEUE" >> "$_un"
            mv "$_un" "$QUEUE" 2>/dev/null
        } 9>>"$QLOCK" 2>/dev/null
    fi
    rm -f "$_un"
}

# Something was lost while the link was down: say so, once, at the first moment
# saying so can work. Only when nothing is still queued - sending the count over
# a link that is still failing would just queue the count, or lose it too. The
# file is cleared only on a CONFIRMED send, so a failure here retries next
# minute rather than swallowing the number.
report_drops() {
    [ -s "$QUEUE" ] && return 0
    [ -s "$QDROP" ] || return 0
    _dn=0; read -r _dn < "$QDROP" 2>/dev/null
    case "$_dn" in ''|*[!0-9]*) _dn=0 ;; esac
    [ "$_dn" -gt 0 ] || { rm -f "$QDROP"; return 0; }
    send "$M_QDROP_T" "$(cap_fmt "$M_QDROP_B" "$_dn")" low warning || return 0
    # SUBTRACT what was reported rather than deleting the file. wifiwatch may
    # have counted another drop during the send above, and an unconditional rm
    # would throw that away - losing the record of a lost alert, which is the one
    # thing this counter exists to prevent.
    {
        flock -x 9 2>/dev/null
        _dc=0; [ -r "$QDROP" ] && read -r _dc < "$QDROP" 2>/dev/null
        case "$_dc" in ''|*[!0-9]*) _dc=0 ;; esac
        _dc=$((_dc - _dn)); [ "$_dc" -gt 0 ] || _dc=0
        if [ "$_dc" -gt 0 ]; then printf '%s\n' "$_dc" > "$QDROP" 2>/dev/null
        else rm -f "$QDROP"; fi
    } 9>>"$QLOCK" 2>/dev/null
}

# ---- read the facts, the same ones the console reads -----------------------
iface_up() {  # $1 = interface
    ubus call network.interface."$1" status 2>/dev/null | grep -q '"up": true' && echo up || echo down
}

now_wan=$(iface_up wan)
now_wan6=$(iface_up wan6)

# The firewall is read from the KERNEL, not from whether the service is
# enabled — the console learned that distinction the hard way. This router has
# no console login and depends entirely on fw4 to stay off the internet, so an
# empty ruleset is the security model absent, not a feature degraded.
_nft=$(nft list ruleset 2>/dev/null | wc -l)
case "$_nft" in ''|*[!0-9]*) _nft=0 ;; esac
[ "$_nft" -gt 20 ] && now_fw=ok || now_fw=absent

# Per-device accounting: running is not the same as counting, but a daemon
# that has gone away definitely is not counting.
pgrep -f '[n]lbwmon -o' >/dev/null 2>&1 && now_acct=ok || now_acct=stopped

# Encrypted-DNS upstream failures, the F-042 fact: AdGuard's own record of
# giving up on an upstream, counted inside a 30-minute window. Two or more is
# a pattern; one is a transient and stays quiet.
#
# COUNTED BY NAME, NOT BY LINE. A client resolving one name asks for it as
# several record types at once - A, AAAA, HTTPS - and when the upstream stalls,
# every one of those times out and AdGuard writes a line for each. One stuck
# lookup therefore produced two or three lines inside the same second, which
# is what this counter used to compare against the threshold of two: a single
# transient paged the owner as a pattern, and then again as a recovery. On
# 2026-09-03 that was `unleash.premid.app` failing as HTTPS and as AAAA in one
# second. Distinct names in the window is what "two or more" was always meant
# to measure; the four-name stall at 11:41 the same day still counts as four.
now_dns=ok
if [ -r /etc/dashboard/agh-auth ]; then
    _n=0; _names=""; _cut=$(( $(date +%s) - 1800 ))
    # one line per failure: "timestamp|name" - the name is what AdGuard prints
    # after question=";  up to the first backslash, tab, or quote. All three
    # are cut on because the suffix (\tIN\t TYPE") reaches the log either as
    # a literal backslash-t (measured: bytes 5c 74) or as a real tab depending
    # on who quoted it, and the counter must not depend on which.
    logread -l 3000 2>/dev/null | grep 'dnsproxy: exchange failed' | grep 'upstream=127.0.0.1:50' |
        tail -40 | awk '{
            ts = $1 " " $2 " " $3 " " $4 " " $5
            q = ""; i = index($0, "question=\";")
            if (i) { q = substr($0, i + 11); if (match(q, /[\\\t"]/)) q = substr(q, 1, RSTART - 1) }
            print ts "|" q
        }' > /tmp/.nmuf.$$ 2>/dev/null
    while IFS='|' read -r _ts _q; do
        _e=$(date -D '%a %b %e %T %Y' -d "$_ts" +%s 2>/dev/null)
        case "$_e" in ''|*[!0-9]*) continue ;; esac
        [ "$_e" -ge "$_cut" ] || continue
        [ -n "$_q" ] || _q='?'
        case " $_names " in
            *" $_q "*) ;;
            *) _names="$_names $_q"; _n=$((_n + 1)) ;;
        esac
    done < /tmp/.nmuf.$$
    rm -f /tmp/.nmuf.$$
    [ "$_n" -ge 2 ] && now_dns=failing
fi

# Link quality, from the probe's own summary line - the same numbers the
# Overview charts. Line 1 is "uptime window state"; line 3 is
# "loss_percent avg_rtt jitter" over the last 60 probes, i.e. about a minute.
#
# Only judged while the probe says "ok". "down" is the WAN alert's business,
# and "silent" means the chosen target never answered at all (a game server
# that drops ICMP is a deliberate choice, not a fault).
#
# THE RING'S AGE IS PART OF THE READING, NOT DECORATION. The first field of line
# one is the uptime the ring was last written at, and both display endpoints
# check it - rate-api at 10s, dashboard-api at 90s. This did not: it read the
# field into a variable and threw it away. So if pingmon stopped, the file stayed
# on disk holding its last good numbers, this scored them as healthy forever, and
# the ONE alert whose whole job is "your connection is struggling" could never
# fire again. A detector that reports health from a file nobody is writing is the
# exact shape this project keeps having to remove.
#
# Stale is UNKNOWN, never ok. Unknown advances neither counter below, so an
# outstanding bad run cannot be cleared by silence and a new one cannot be
# started by it either.
now_link=unknown; now_probe=stopped; q_rtt=0; q_loss=0
if [ -r /tmp/.pingring ]; then
    read -r _pu _pw _pstate < /tmp/.pingring 2>/dev/null
    _upnow=$(cut -d. -f1 /proc/uptime 2>/dev/null)
    _page=-1
    case "$_pu$_upnow" in ''|*[!0-9]*) ;; *) _page=$((_upnow - _pu)) ;; esac
    # 90s matches the Overview's window: cron gives this a minute of jitter, so a
    # tighter bound would call a healthy ring stale on an unlucky tick.
    if [ "$_page" -ge 0 ] && [ "$_page" -le 90 ]; then now_probe=ok; fi
fi
if [ "$now_probe" = ok ]; then
    now_link=ok
    _l3=$(sed -n '3p' /tmp/.pingring 2>/dev/null)
    q_loss=${_l3%% *}; _rest=${_l3#* }; q_rtt=${_rest%% *}
    case "$q_loss" in ''|*[!0-9]*) q_loss=0 ;; esac
    q_rtt=${q_rtt%%.*}
    case "$q_rtt" in ''|-*|*[!0-9]*) q_rtt=0 ;; esac
    # pingmon is alive but reports the target unreachable or silent: that is
    # the WAN alert's business, so quality stays unjudged rather than "ok".
    [ "$_pstate" = "ok" ] || now_link=unknown
    if [ "$_pstate" = "ok" ] && [ "$q_rtt" -gt 0 ]; then
        if [ "$q_rtt" -ge "$RTT_BAD" ] || [ "$q_loss" -ge "$LOSS_BAD" ]; then
            now_link=bad
        elif [ "$q_rtt" -gt "$RTT_OK" ] || [ "$q_loss" -gt "$LOSS_OK" ]; then
            now_link=middling      # neither trips nor clears - hysteresis gap
        fi
    fi
fi

# ---- VPN tunnels -----------------------------------------------------------
# Liveness is the HANDSHAKE AGE, not whether the interface exists: a WireGuard
# device stays "up" forever once configured, so the interface says nothing.
# 180s matches vpnwatch's own STALE_AFTER, deliberately - two components
# disagreeing about whether a tunnel is alive is worse than either threshold.
#
# Only tunnels a policy actually ROUTES THROUGH are judged. An idle tunnel with
# no device behind it legitimately stops handshaking, and alerting on that
# would fire every night on a tunnel nobody is using.
VPN_STALE=180
now_vpn=""
_vnow=$(date +%s)
_i=0
while [ "$_i" -lt 64 ]; do
    _pn=$(uci -q get pbr.@policy[$_i].name 2>/dev/null) || break
    [ -n "$_pn" ] || break
    case "$_pn" in
        dash_*)
            _pif=$(uci -q get pbr.@policy[$_i].interface 2>/dev/null)
            _pen=$(uci -q get pbr.@policy[$_i].enabled 2>/dev/null)
            if [ "$_pen" = "1" ] && [ -n "$_pif" ]; then
                case " $now_vpn " in
                    *" $_pif:"*) ;;
                    *)
                        _hs=$(wg show "$_pif" latest-handshakes 2>/dev/null | awk 'NR==1{print $2+0}')
                        case "$_hs" in ''|*[!0-9]*) _hs=0 ;; esac
                        if [ "$_hs" -eq 0 ] || [ $((_vnow - _hs)) -gt "$VPN_STALE" ]; then
                            now_vpn="$now_vpn $_pif:down"
                        else
                            now_vpn="$now_vpn $_pif:up"
                        fi ;;
                esac
            fi ;;
    esac
    _i=$((_i + 1))
done
now_vpn=$(printf '%s' "$now_vpn" | tr -s ' ' | sed 's/^ //;s/ $//')

# ---- which devices are routed through a tunnel -----------------------------
# The set of enabled dash_ policies, as "MAC>tunnel" pairs. A change here is
# either the owner routing a device from the console or vpnwatch releasing one,
# and the two are told apart by the autopause flag below.
now_vdev=""
_i=0
while [ "$_i" -lt 64 ]; do
    _pn=$(uci -q get pbr.@policy[$_i].name 2>/dev/null) || break
    [ -n "$_pn" ] || break
    case "$_pn" in
        dash_*)
            if [ "$(uci -q get pbr.@policy[$_i].enabled 2>/dev/null)" = "1" ]; then
                _sa=$(uci -q get pbr.@policy[$_i].src_addr 2>/dev/null | tr 'A-F' 'a-f')
                _pif=$(uci -q get pbr.@policy[$_i].interface 2>/dev/null)
                [ -n "$_sa" ] && now_vdev="$now_vdev $_sa>$_pif"
            fi ;;
    esac
    _i=$((_i + 1))
done
now_vdev=$(printf '%s' "$now_vdev" | tr -s ' ' | sed 's/^ //;s/ $//')
now_vpause=no
[ -s /etc/dashboard/vpn-autopaused ] && now_vpause=yes

# A device's name, for messages. The class map is what the console shows, so
# the phone and the screen agree; the MAC is the honest fallback.
dev_name() {
    _n=$(awk -F'|' -v m="$1" '!/^#/ && tolower($1)==m {print $2; exit}' \
         /etc/dashboard/classmap 2>/dev/null)
    [ -n "$_n" ] || _n=$(awk -v m="$1" '$2==m {print $4; exit}' /tmp/dhcp.leases 2>/dev/null)
    [ -n "$_n" ] && [ "$_n" != "*" ] || _n="$1"
    printf '%s' "$_n"
}

# Wi-Fi arrivals and departures are NOT handled here. They moved to
# /usr/sbin/wifiwatch, which subscribes to hostapd ubus notifications and
# reports in real time - a minute of cron latency is nothing for "the internet
# is down" and everything for "who just walked in". Two mechanisms for one job
# is how they drift apart, so this one owns none of it.

# ---- compare with last run --------------------------------------------------
was_wan=""; was_wan6=""; was_fw=""; was_acct=""; was_dns=""
was_link="ok"; bad_run=0; good_run=0
was_vpn=""; was_vdev=""; was_vpause="no"
[ -r "$STATE" ] && . "$STATE" 2>/dev/null

if [ -z "$was_wan" ]; then
    # First run after a boot or an install: take a baseline and say so ONCE.
    # Announcing every current state here would mean a burst of messages after
    # every reboot, which is exactly the noise this design avoids.
    notify "$M_HELLO_T" "$M_HELLO_B" low white_check_mark
else
    [ "$now_wan" != "$was_wan" ] && {
        [ "$now_wan" = down ] \
            && notify "$M_WAN_DOWN_T" "$M_WAN_DOWN_B" high rotating_light \
            || notify "$M_WAN_UP_T" "$M_WAN_UP_B" default white_check_mark; }

    [ "$now_wan6" != "$was_wan6" ] && {
        [ "$now_wan6" = down ] \
            && notify "$M_V6_DOWN_T" "$M_V6_DOWN_B" default warning \
            || notify "$M_V6_UP_T" "$M_V6_UP_B" low white_check_mark; }

    [ "$now_fw" != "$was_fw" ] && {
        [ "$now_fw" = absent ] \
            && notify "$M_FW_DOWN_T" "$M_FW_DOWN_B" urgent rotating_light \
            || notify "$M_FW_UP_T" "$M_FW_UP_B" default white_check_mark; }

    [ "$now_acct" != "$was_acct" ] && {
        [ "$now_acct" = stopped ] \
            && notify "$M_ACCT_DOWN_T" "$M_ACCT_DOWN_B" default warning \
            || notify "$M_ACCT_UP_T" "$M_ACCT_UP_B" low white_check_mark; }

    # The probe's own death, reported the way accounting's already is. Judged
    # from the FRESHNESS OF ITS OUTPUT rather than from pgrep: a process can be
    # alive and writing nothing, which is precisely how this went unnoticed.
    [ "$now_probe" != "$was_probe" ] && {
        [ "$now_probe" = stopped ] \
            && notify "$M_PROBE_DOWN_T" "$M_PROBE_DOWN_B" default warning \
            || notify "$M_PROBE_UP_T" "$M_PROBE_UP_B" low white_check_mark; }

    # Counters rather than a straight comparison: this is the one signal where
    # the interesting state is "has been true for a while", not "changed".
    case "$now_link" in
        bad)       bad_run=$((bad_run + 1)); good_run=0 ;;
        ok)        good_run=$((good_run + 1)); bad_run=0 ;;
        middling)  bad_run=0; good_run=0 ;;
        unknown)   bad_run=0; good_run=0 ;;   # no measurement is not evidence
    esac
    if [ "$was_link" = "ok" ] && [ "$bad_run" -ge "$NEED" ]; then
        was_link=bad
        notify "$M_LINK_BAD_T" "$(cap_fmt "$M_LINK_BAD_B" "$q_rtt" "$q_loss")" high warning
    elif [ "$was_link" = "bad" ] && [ "$good_run" -ge "$NEED" ]; then
        was_link=ok
        notify "$M_LINK_OK_T" "$(cap_fmt "$M_LINK_OK_B" "$q_rtt" "$q_loss")" default white_check_mark
    fi

    # VPN tunnels, per tunnel, edge-triggered like everything else
    for _t in $now_vpn; do
        _tn=${_t%%:*}; _ts=${_t##*:}
        case " $was_vpn " in
            *" $_tn:$_ts "*) ;;
            *" $_tn:"*)
                if [ "$_ts" = down ]; then
                    notify "$M_VPN_DOWN_T" "$(cap_fmt "$M_VPN_DOWN_B" "$_tn")" high warning
                else
                    notify "$M_VPN_UP_T" "$(cap_fmt "$M_VPN_UP_B" "$_tn")" default white_check_mark
                fi ;;
            *) ;;   # newly routed tunnel: the device message below covers it
        esac
    done

    # devices entering or leaving the tunnel
    for _p in $now_vdev; do
        case " $was_vdev " in
            *" $_p "*) ;;
            *) notify "$M_VPNDEV_ON_T" \
                   "$(cap_fmt "$M_VPNDEV_ON_B" "$(dev_name "${_p%%>*}")" "${_p##*>}")" \
                   default lock ;;
        esac
    done
    for _p in $was_vdev; do
        case " $now_vdev " in
            *" $_p "*) ;;
            *) notify "$M_VPNDEV_OFF_T" \
                   "$(cap_fmt "$M_VPNDEV_OFF_B" "$(dev_name "${_p%%>*}")")" \
                   default unlock ;;
        esac
    done

    # the automatic release is its own event: it is not the owner's doing and
    # it silently costs privacy, which is exactly the kind of thing that should
    # not wait to be noticed
    [ "$now_vpause" != "$was_vpause" ] && [ "$now_vpause" = yes ] && \
        notify "$M_VPNDEV_PAUSE_T" "$M_VPNDEV_PAUSE_B" high warning

    [ "$now_dns" != "$was_dns" ] && {
        [ "$now_dns" = failing ] \
            && notify "$M_DNS_BAD_T" "$M_DNS_BAD_B" default warning \
            || notify "$M_DNS_OK_T" "$M_DNS_OK_B" low white_check_mark; }
fi

{ printf 'was_wan=%s\nwas_wan6=%s\nwas_fw=%s\nwas_acct=%s\nwas_dns=%s\nwas_link=%s\nbad_run=%s\ngood_run=%s\nwas_vpause=%s\nwas_probe=%s\n' \
    "$now_wan" "$now_wan6" "$now_fw" "$now_acct" "$now_dns" "$was_link" "$bad_run" "$good_run" "$now_vpause" "$now_probe"
  printf 'was_vpn="%s"\nwas_vdev="%s"\n' "$now_vpn" "$now_vdev"; } > "$STATE.tmp" 2>/dev/null &&
    mv "$STATE.tmp" "$STATE" 2>/dev/null

flush_queue
beat
exit 0
