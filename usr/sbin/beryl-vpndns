#!/bin/sh
# Per-device VPN DNS enforcement, regenerated from the current pbr policies.
#
# Why DNAT and not DHCP option 6: DHCP only reaches a device at lease time, so
# routing a device would not change its DNS for up to a full lease, and
# un-routing it would leave it aimed at a dead resolver until renewal.
#
# Why the IPv6 half: Windows (and iOS) prefer IPv6, so a device with an IPv6
# resolver address sends nearly all its DNS over v6 — straight past an IPv4-only
# redirect and into the router, which resolves it from the HOME uplink. That is
# a location leak even though the traffic itself is tunnelled. These tunnels
# carry no usable IPv6 and pbr does not mark v6, so v6 DNS is rejected (not
# dropped) for routed devices: the client fails instantly and retries over IPv4,
# which the DNAT above then carries into the tunnel.
#
# Blocking v6 DNS alone stopped being enough once the LAN gained real IPv6.
# The router relays the uplink's /64, so devices hold globally routable v6
# addresses. A routed device then resolves over IPv4 as intended, gets an AAAA
# back, connects over IPv6 — and pbr, which does not mark v6 at all
# (pbr.config.ipv6_enabled=0), lets that flow straight out the home uplink.
# Same leak, one step later. So while a device is routed, ALL of its forwarded
# IPv6 is rejected, not just port 53: it falls back to IPv4 and stays inside
# the tunnel. Rejected rather than dropped so the fallback is instant. The
# input chain still only takes DNS — the device must keep reaching the router
# itself (console, NDP, DHCPv6) over v6.
#
# fw4 includes /etc/nftables.d/*.nft into `table inet fw4`, so these survive
# every firewall reload and boot with no service of their own.
# Called by vpn-api (route/add/del) and vpnwatch (pause/resume a dead tunnel).
NFT=/etc/nftables.d/30-beryl-vpndns.nft
TMP="$NFT.$$"
body=""; body6=""; body6fw=""; i=0
while [ "$i" -lt 64 ]; do
    pn=$(uci -q get pbr.@policy[$i].name 2>/dev/null) || break
    [ -n "$pn" ] || break
    case "$pn" in
        dash_*)
            sa=$(uci -q get pbr.@policy[$i].src_addr 2>/dev/null | tr "A-F" "a-f")
            pif=$(uci -q get pbr.@policy[$i].interface 2>/dev/null)
            en=$(uci -q get pbr.@policy[$i].enabled 2>/dev/null)
            if [ "$en" = "1" ] && [ -n "$pif" ] && [ -n "$sa" ]; then
                d=$(uci -q get network.$pif.dns 2>/dev/null | tr " ," "\n\n" | grep -v ":" | grep -m1 "[0-9]")
                if [ -n "$d" ]; then
                    body="$body	meta nfproto ipv4 ether saddr $sa udp dport 53 counter dnat ip to $d comment \"!vpn-dns $pn\"
	meta nfproto ipv4 ether saddr $sa tcp dport 53 counter dnat ip to $d comment \"!vpn-dns $pn\"
"
                    body6="$body6	meta nfproto ipv6 ether saddr $sa udp dport 53 counter reject comment \"!vpn-dns6 $pn\"
	meta nfproto ipv6 ether saddr $sa tcp dport 53 counter reject with tcp reset comment \"!vpn-dns6 $pn\"
"
                    # Everything leaving this device over v6, not just DNS. TCP
                    # gets a reset so Happy Eyeballs abandons v6 immediately
                    # rather than waiting out a timeout on every connection.
                    body6fw="$body6fw	meta nfproto ipv6 ether saddr $sa meta l4proto tcp counter reject with tcp reset comment \"!vpn-v6 $pn\"
	meta nfproto ipv6 ether saddr $sa counter reject comment \"!vpn-v6 $pn\"
"
                fi
            fi ;;
    esac
    i=$((i+1))
done
{
    printf "# generated by beryl-vpndns — do not edit\n"
    printf "chain beryl_vpndns {\n\ttype nat hook prerouting priority dstnat - 5; policy accept;\n%s}\n" "$body"
    printf "chain beryl_vpndns6_in {\n\ttype filter hook input priority filter - 5; policy accept;\n%s}\n" "$body6"
    printf "chain beryl_vpndns6_fw {\n\ttype filter hook forward priority filter - 5; policy accept;\n%s}\n" "$body6fw"
} > "$TMP" 2>/dev/null
[ -s "$TMP" ] || { rm -f "$TMP"; exit 1; }
cmp -s "$TMP" "$NFT" 2>/dev/null && { rm -f "$TMP"; exit 0; }
mv "$TMP" "$NFT"
if fw4 check >/dev/null 2>&1; then
    /etc/init.d/firewall reload >/dev/null 2>&1
else
    logger -t beryl-vpndns "ruleset rejected by fw4 — falling back to no redirects"
    printf "chain beryl_vpndns {\n\ttype nat hook prerouting priority dstnat - 5; policy accept;\n}\n" > "$NFT"
    /etc/init.d/firewall reload >/dev/null 2>&1
fi
