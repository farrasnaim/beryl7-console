#!/bin/sh
# Per-device VPN DNS enforcement, regenerated from the current pbr policies.
#
# Why DNAT and not DHCP option 6: DHCP only reaches a device at lease time, so
# routing a device would not change its DNS for up to a full lease, and
# un-routing it would leave it aimed at a dead resolver until renewal.
#
# Why the IPv6 half: Windows (and iOS) prefer IPv6, so a device with an IPv6
# resolver address sends nearly all its DNS over v6 — straight past an IPv4-only
# redirect and into the router, which resolves it from the HOME uplink. That is
# a location leak even though the traffic itself is tunnelled. These tunnels
# carry no usable IPv6 and pbr does not mark v6, so v6 DNS is rejected (not
# dropped) for routed devices: the client fails instantly and retries over IPv4,
# which the DNAT above then carries into the tunnel.
#
# Blocking v6 DNS alone stopped being enough once the LAN gained real IPv6.
# The router relays the uplink's /64, so devices hold globally routable v6
# addresses. A routed device then resolves over IPv4 as intended, gets an AAAA
# back, connects over IPv6 — and pbr, which does not mark v6 at all
# (pbr.config.ipv6_enabled=0), lets that flow straight out the home uplink.
# Same leak, one step later. So while a device is routed, ALL of its forwarded
# IPv6 is rejected, not just port 53: it falls back to IPv4 and stays inside
# the tunnel. Rejected rather than dropped so the fallback is instant. The
# input chain still only takes DNS — the device must keep reaching the router
# itself (console, NDP, DHCPv6) over v6.
#
# fw4 includes /etc/nftables.d/*.nft into `table inet fw4`, so these survive
# every firewall reload and boot with no service of their own.
# Called by vpn-api (route/add/del) and vpnwatch (pause/resume a dead tunnel).
NFT=/etc/nftables.d/30-beryl-vpndns.nft
TMP="$NFT.$$"

# valid_ip4 comes from the console's shared library. This is not a CGI, but the
# check has to be the SAME one vpn-api applies at the boundary — two validators
# that disagree is how a value passes one gate and fails the next.
#
# Validating here as well as there is deliberate, not belt-and-braces: vpnwatch
# calls this script too, /etc/config/network can be hand-edited, and anything
# stored before the boundary check existed is still in UCI unvalidated. This is
# the last point before the value becomes nftables syntax.
#
# If the library is missing, no IPv4 value can be validated, so none is emitted —
# the redirect is lost but the IPv6 protection below is not. That is the safe
# direction: the redirect hides which resolver you use, the v6 block hides where
# you are.
BERYL_LIB=/usr/share/beryl/cgi-lib.sh
if [ -r "$BERYL_LIB" ]; then
    . "$BERYL_LIB"
else
    logger -t beryl-vpndns "missing $BERYL_LIB — emitting IPv6 protection only"
    valid_ip4() { return 1; }
fi

# Why a marker file at all, when the console could just look at this script's
# output: because the output is not the authority. fw4 can be reloaded by
# anything after this script last ran, and the file on disk is what fw4 reads at
# boot — so the console reads the FACT (are the v6 rules actually loaded?) from
# the kernel, and only the REASON from here. This script is the one thing that
# knows WHY a policy got no rules, because it is the one holding $d.
#
# /etc/dashboard, not /tmp: this script never runs at boot (only vpn-api and
# vpnwatch call it), so a degraded ruleset survives a reboot while a /tmp marker
# would not — the two would diverge in exactly the direction that hides the
# problem. /etc/dashboard is already the console's persistent state directory
# and is already listed in sysupgrade.conf.
STATEF=/etc/dashboard/vpndns-state
write_state() {          # $1 = ok | nodns | rejected | rejected-v6only
    mkdir -p /etc/dashboard 2>/dev/null
    { printf 'state=%s\n' "$1"
      printf 'nodns=%s\n' "$nodns"
      printf 'ts=%s\n' "$(date +%s 2>/dev/null)"
    } > "$STATEF.tmp" 2>/dev/null || return 0
    # Only touch flash when something actually changed. The timestamp is
    # deliberately excluded from that comparison, or every run would be a write.
    if [ -f "$STATEF" ] &&
       [ "$(grep -v '^ts=' "$STATEF" 2>/dev/null)" = "$(grep -v '^ts=' "$STATEF.tmp")" ]; then
        rm -f "$STATEF.tmp"; return 0
    fi
    mv "$STATEF.tmp" "$STATEF" 2>/dev/null
}
base_state() { [ -n "$nodns" ] && printf 'nodns' || printf 'ok'; }

body=""; body6=""; body6fw=""; nodns=""; i=0
while [ "$i" -lt 64 ]; do
    pn=$(uci -q get pbr.@policy[$i].name 2>/dev/null) || break
    [ -n "$pn" ] || break
    case "$pn" in
        dash_*)
            sa=$(uci -q get pbr.@policy[$i].src_addr 2>/dev/null | tr "A-F" "a-f")
            pif=$(uci -q get pbr.@policy[$i].interface 2>/dev/null)
            en=$(uci -q get pbr.@policy[$i].enabled 2>/dev/null)
            if [ "$en" = "1" ] && [ -n "$pif" ] && [ -n "$sa" ]; then
                # The first entry that is actually a usable IPv4 literal, not
                # merely the first one that has a digit and no colon. Those are
                # not the same thing: a list like "dns.example.com 10.2.0.1"
                # used to yield the hostname, which nft then refused — taking
                # the whole ruleset, and every device's v6 protection, with it.
                d=""
                for _e in $(uci -q get network.$pif.dns 2>/dev/null | tr " ," "  "); do
                    if valid_ip4 "$_e"; then d="$_e"; break; fi
                done
                if [ -n "$d" ]; then
                    body="$body	meta nfproto ipv4 ether saddr $sa udp dport 53 counter dnat ip to $d comment \"!vpn-dns $pn\"
	meta nfproto ipv4 ether saddr $sa tcp dport 53 counter dnat ip to $d comment \"!vpn-dns $pn\"
"
                else
                    # Recorded, not silently accepted: this device's DNS still
                    # resolves from the home uplink, which is a smaller leak than
                    # the v6 one below but is still a leak, and the owner cannot
                    # fix what nothing tells them about.
                    nodns="$nodns $pn"
                fi

                # The v6 chains are emitted for every routed device, WHETHER OR
                # NOT the tunnel has a usable resolver.
                #
                # They used to sit inside the `if [ -n "$d" ]` above, which meant
                # a tunnel with no DNS line in its .conf — ordinary for anything
                # that is not Proton — silently gave its routed devices no IPv6
                # protection at all, while the VPN page showed them routed. The
                # two are unrelated: these rules match on the device's MAC and do
                # not reference $d. Coupling them made a missing resolver into a
                # location leak.
                body6="$body6	meta nfproto ipv6 ether saddr $sa udp dport 53 counter reject comment \"!vpn-dns6 $pn\"
	meta nfproto ipv6 ether saddr $sa tcp dport 53 counter reject with tcp reset comment \"!vpn-dns6 $pn\"
"
                # Everything leaving this device over v6, not just DNS. TCP
                # gets a reset so Happy Eyeballs abandons v6 immediately
                # rather than waiting out a timeout on every connection.
                body6fw="$body6fw	meta nfproto ipv6 ether saddr $sa meta l4proto tcp counter reject with tcp reset comment \"!vpn-v6 $pn\"
	meta nfproto ipv6 ether saddr $sa counter reject comment \"!vpn-v6 $pn\"
"
            fi ;;
    esac
    i=$((i+1))
done
{
    printf "# generated by beryl-vpndns — do not edit\n"
    printf "chain beryl_vpndns {\n\ttype nat hook prerouting priority dstnat - 5; policy accept;\n%s}\n" "$body"
    printf "chain beryl_vpndns6_in {\n\ttype filter hook input priority filter - 5; policy accept;\n%s}\n" "$body6"
    printf "chain beryl_vpndns6_fw {\n\ttype filter hook forward priority filter - 5; policy accept;\n%s}\n" "$body6fw"
} > "$TMP" 2>/dev/null
[ -s "$TMP" ] || { rm -f "$TMP"; exit 1; }
# An unchanged file means the previous run installed this exact ruleset and fw4
# accepted it — had it been rejected, the fallback would have left the degraded
# file on disk and this comparison would differ, which is what makes a later run
# retry by itself. So the state is whatever the policy walk just found.
cmp -s "$TMP" "$NFT" 2>/dev/null && { rm -f "$TMP"; write_state "$(base_state)"; exit 0; }
mv "$TMP" "$NFT"
if fw4 check >/dev/null 2>&1; then
    /etc/init.d/firewall reload >/dev/null 2>&1
    write_state "$(base_state)"
else
    logger -t beryl-vpndns "ruleset rejected by fw4 — falling back to no redirects"
    printf "chain beryl_vpndns {\n\ttype nat hook prerouting priority dstnat - 5; policy accept;\n}\n" > "$NFT"
    /etc/init.d/firewall reload >/dev/null 2>&1
    write_state rejected
fi
