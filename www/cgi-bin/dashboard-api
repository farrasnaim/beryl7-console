#!/bin/sh
# /www/cgi-bin/dashboard-api  —  JSON data layer for the Beryl 7 dashboard (vanilla OpenWrt).
#
# Design note: ubus already emits valid JSON, so this script *embeds* those documents
# verbatim rather than re-serialising them field-by-field in ash. That removes the whole
# class of printf/IFS/sort quirks that plagued the GL-stock version.

# esc, jnum, fail, read_body, urldec, qs_get, qs_get_dec, guard_post — one copy,
# shared with every other endpoint. Tested for readability rather than sourced
# blind: busybox ash treats `.` as a special builtin, so a missing file aborts
# the script outright and an `|| fallback` after it never runs. Without the
# check the failure is a 500 with an empty body and nothing in the log.
BERYL_LIB=/usr/share/beryl/cgi-lib.sh
if [ -r "$BERYL_LIB" ]; then
    . "$BERYL_LIB"
else
    printf 'Content-Type: application/json\r\n'
    printf 'Cache-Control: no-store\r\n\r\n'
    printf '{"ok":false,"error":"missing %s - reinstall the console"}' "$BERYL_LIB"
    exit 0
fi

CLASSMAP=/etc/dashboard/classmap
# The interface actually carrying internet traffic. This used to be pinned to
# network.wan.device, which reads ~0 while travelling: on a Wi-Fi or USB uplink
# the default route moves to that device and eth0 goes quiet. pbr keeps its
# tunnel routes in separate tables (pbr_wg_*, by fwmark), so the main table's
# default is always the physical uplink, never a WireGuard interface.
# rate-api derives it identically — the two must agree or the throughput ribbon
# would step between two different interfaces when the 1s sampler hands back.
WANIF=$(ip route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
[ -n "$WANIF" ] || WANIF=$(uci -q get network.wan.device 2>/dev/null)
[ -n "$WANIF" ] || WANIF=eth0
# The LAN bridge, named once. Both the neighbour lookup and the bridge-port scan
# need it, and they used to disagree — one derived it, the other said br-lan.
LANDEV=$(uci -q get network.lan.device 2>/dev/null); [ -n "$LANDEV" ] || LANDEV=br-lan
STATE=/tmp/.dashwan

# Which UCI network an address belongs to, matched against the interfaces this
# router actually serves rather than a fixed table of subnets. Assumes /24,
# which is what a router hands out in practice; an unmatched address returns
# empty and the caller leaves the zone unset rather than guessing.
zone_of_ip() {
    [ -n "$1" ] || return 0
    _zp=$(printf '%s' "$1" | cut -d. -f1-3)
    for _zn in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=interface$/\1/p'); do
        _za=$(uci -q get network.$_zn.ipaddr 2>/dev/null)
        [ -n "$_za" ] || continue
        case "$_zn" in loopback) continue ;; esac
        if [ "$(printf '%s' "${_za%%/*}" | cut -d. -f1-3)" = "$_zp" ]; then
            printf '%s' "$_zn"; return 0
        fi
    done
}

POST_MAX=8192

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n\r\n'

# `action` may arrive in the POST body, so the body is read before dispatch.
read_body

ACTION=$(qs_get action)

# Any POST must pass the origin check, even if the action is unknown/absent —
# otherwise a cross-site POST would fall through to the read path and leak status.
[ "$REQUEST_METHOD" = "POST" ] && guard_post

# ...and any WRITE must be a POST. Without this, `setdev` — the one write here
# that deliberately has no password, because renaming a device cannot disrupt
# the network — was reachable with a plain GET, so an <img src> on any page the
# owner visited could silently rename their devices. The other three APIs
# already carried this clause; dashboard-api was the one that did not.
case "$ACTION" in
    # devdetail reads accounting and connection state and changes nothing, so
    # it stays a GET for the same reason `logs` does on the settings API.
    ""|devdetail) ;;
    *) [ "$REQUEST_METHOD" = "POST" ] || { printf '{"ok":false,"error":"POST required"}'; exit 0; } ;;
esac

# ------------------------------------------------------------- devdetail --
# What one device's number is MADE OF. Two answers, deliberately different in
# kind, because the router only records one of them historically:
#
#   protos  — this accounting day, per protocol (nlbwmon groups by layer7).
#             Same period as the Traffic panel's own engine.
#   remotes — what the device is talking to RIGHT NOW. Grouped from conntrack
#             by remote address, named by PTR. The byte figures here are the
#             LAST ~30 SECONDS only: nlbwmon drains every flow's counters each
#             refresh interval to compute its deltas, so a snapshot can never
#             hold more than one interval of bytes. That is why this list is
#             labelled "now" and the per-site share of the DAY is not offered —
#             nothing on this router records destinations historically, and
#             pretending the last half-minute is the day would be a lie with
#             a chart on it.
if [ "$ACTION" = "devdetail" ]; then
    DMAC=$(qs_get_dec mac | tr 'a-f' 'A-F')
    case "$DMAC" in
        [0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]) ;;
        *) printf '{"ok":false,"error":"bad mac"}'; exit 0 ;;
    esac
    LMAC=$(printf '%s' "$DMAC" | tr 'A-F' 'a-f')

    # every address the device holds: the v4 lease plus its global/ULA v6
    # neighbours (link-locals excluded — nothing routes through them).
    IPS=$(awk -v m="$LMAC" '$2==m {print $3}' /tmp/dhcp.leases 2>/dev/null)
    IPS="$IPS $(ip -6 neigh show 2>/dev/null | awk -v m="$LMAC" \
        '$1 ~ /^fe80/ { next }
        { for (i=1;i<NF;i++) if ($i=="lladdr" && tolower($(i+1))==m) print $1 }')"

    PTRCACHE=/tmp/.ptrcache
    ASNCACHE=/tmp/.asncache

    # ---- live fast path -------------------------------------------------
    # Polled every second while the modal is open, so it must stay cheap: the
    # full path costs ~400ms, almost all of it name-resolution forks. This one
    # is a single awk pass with both name caches joined in-process - no
    # nslookup, no per-remote forks, no cache writes. Names it has not seen
    # come back empty; the full call (every few seconds) fills them in.
    if [ "$(qs_get live)" = "1" ]; then
        REMJ=$(IPLIST="$IPS" awk -v P="$PTRCACHE" -v A="$ASNCACHE" '
            function jesc(x) { gsub(/\\/, "\\\\&", x); gsub(/"/, "\\\\&", x); return x }
            BEGIN {
                n = split(ENVIRON["IPLIST"], a, " ")
                for (i = 1; i <= n; i++) if (a[i] != "") mine[a[i]] = 1
                while ((getline l < P) > 0) {
                    sp = index(l, " ")
                    if (sp > 1) { v = substr(l, sp + 1); if (v != "-") ptr[substr(l, 1, sp - 1)] = v }
                }
                close(P)
                while ((getline l < A) > 0) {
                    sp = index(l, "\t")
                    if (sp > 1) { v = substr(l, sp + 1); if (v != "-") asn[substr(l, 1, sp - 1)] = v }
                }
                close(A)
            }
            {
                src = ""; dst = ""; bytes = 0
                for (i = 1; i <= NF; i++) {
                    if ($i ~ /^src=/ && src == "") src = substr($i, 5)
                    else if ($i ~ /^dst=/ && dst == "") dst = substr($i, 5)
                    else if ($i ~ /^bytes=/) bytes += substr($i, 7)
                }
                if (!(src in mine)) next
                if (dst ~ /^192\.168\./ || dst ~ /^10\./ || dst ~ /^172\.(1[6-9]|2[0-9]|3[01])\./) next
                if (dst ~ /^(224|239|255)\./ || dst ~ /^ff/ || dst ~ /^fe80/ || dst ~ /^fd/) next
                agg[dst] += bytes; cnt[dst]++
            }
            END {
                for (d in agg) {
                    printf "%s[\"%s\",\"%s\",%.0f,%d,\"%s\"]", (c++ ? "," : ""), \
                        d, jesc(ptr[d]), agg[d], cnt[d], jesc(asn[d])
                    if (c >= 40) break
                }
            }' /proc/net/nf_conntrack 2>/dev/null)
        printf '{"ok":true,"mac":"%s","live":true,"remotes":[%s]}' "$(esc "$DMAC")" "$REMJ"
        exit 0
    fi

    # ---- today, by protocol ----
    PJ=$(nlbw -c csv -g mac,layer7 2>/dev/null | awk -F'\t' -v m="\"$LMAC\"" '
        NR==1 { next }
        $3 != m { next }
        {
            gsub(/"/,"",$9); gsub(/"/,"",$1)
            name = ($9 != "" ? $9 : ($1 == "IP" ? "other" : $1 "/" $2))
            rx[name] += $5; tx[name] += $7
        }
        END { for (n in rx) printf "%015.0f\t%s\t%.0f\t%.0f\n", rx[n]+tx[n], n, rx[n], tx[n] }' |
        sort -r | head -8 | awk -F'\t' '
        { gsub(/\\/,"\\\\&",$2); gsub(/"/,"\\\\&",$2)
          printf "%s[\"%s\",%.0f,%.0f]", (c++?",":""), $2, $3, $4 }')

    # ---- talking to, right now ----
    RJ=""
    if [ -r /proc/net/nf_conntrack ]; then
        RJ=$(IPLIST="$IPS" awk '
            BEGIN { n = split(ENVIRON["IPLIST"], a, " "); for (i=1;i<=n;i++) if (a[i]!="") mine[a[i]]=1 }
            {
                src=""; dst=""; bytes=0
                for (i=1;i<=NF;i++) {
                    if ($i ~ /^src=/ && src=="") src=substr($i,5)
                    else if ($i ~ /^dst=/ && dst=="") dst=substr($i,5)
                    else if ($i ~ /^bytes=/) bytes += substr($i,7)
                }
                if (!(src in mine)) next
                # remote only: LAN, multicast, broadcast and link-local are
                # chatter, not sites
                if (dst ~ /^192\.168\./ || dst ~ /^10\./ || dst ~ /^172\.(1[6-9]|2[0-9]|3[01])\./) next
                if (dst ~ /^(224|239|255)\./ || dst ~ /^ff/ || dst ~ /^fe80/ || dst ~ /^fd/) next
                agg[dst] += bytes; cnt[dst]++
            }
            END { for (d in agg) printf "%015.0f\t%s\t%d\n", agg[d], d, cnt[d] }' \
            /proc/net/nf_conntrack 2>/dev/null | sort -r | head -10)
    fi
    REMJ=""
    OIFS=$IFS; IFS='
'
    for line in $RJ; do
        IFS=$OIFS
        b=${line%%	*}; b=$(printf %s "$b" | sed "s/^0*//"); [ -n "$b" ] || b=0; rest=${line#*	}; d=${rest%%	*}; c=${rest#*	}
        nm=""
        [ -f "$PTRCACHE" ] && nm=$(awk -v ip="$d" '$1==ip {print $2; exit}' "$PTRCACHE" 2>/dev/null)
        if [ -z "$nm" ]; then
            nm=$(nslookup "$d" 127.0.0.1 2>/dev/null | sed -n 's/.*name = //p' | head -1 | sed 's/\.$//')
            printf '%s %s\n' "$d" "${nm:--}" >> "$PTRCACHE" 2>/dev/null
        fi
        [ "$nm" = "-" ] && nm=""
        # Who owns the address: Team Cymru's IP-to-ASN zone, answered over the
        # router's own resolver chain (dnsmasq -> AdGuard -> DoH, so encrypted
        # like everything else). Two TXT lookups per address, cached hard -
        # ownership of an IP block changes on the timescale of company
        # acquisitions, not page loads.
        org=""
        [ -f "$ASNCACHE" ] && org=$(awk -F'\t' -v ip="$d" '$1==ip {print $2; exit}' "$ASNCACHE" 2>/dev/null)
        if [ -z "$org" ]; then
            case "$d" in
                *:*) _rq=$(printf '%s' "$d" | awk '{
                        s=$0
                        if (s ~ /::/) {
                            split(s, hp, "::")
                            nl = (hp[1]=="" ? 0 : split(hp[1], L, ":"))
                            nr = (hp[2]=="" ? 0 : split(hp[2], R, ":"))
                            s = ""
                            for (i=1;i<=nl;i++) s = s (s==""?"":":") L[i]
                            for (i=1;i<=8-nl-nr;i++) s = s (s==""?"":":") "0"
                            for (i=1;i<=nr;i++) s = s (s==""?"":":") R[i]
                        }
                        n = split(s, g, ":"); hexs=""
                        for (i=1;i<=n;i++) { x=g[i]; while (length(x)<4) x="0" x; hexs = hexs x }
                        for (i=32;i>=1;i--) printf "%s.", substr(hexs, i, 1)
                    }')origin6.asn.cymru.com ;;
                *)   _rq=$(printf '%s' "$d" | awk -F. '{print $4"."$3"."$2"."$1}').origin.asn.cymru.com ;;
            esac
            _asn=$(nslookup -type=txt "$_rq" 127.0.0.1 2>/dev/null |
                   sed -n 's/.*text = "\([0-9]*\).*/\1/p' | head -1)
            if [ -n "$_asn" ]; then
                org=$(nslookup -type=txt "AS$_asn.asn.cymru.com" 127.0.0.1 2>/dev/null |
                      sed -n 's/.*| //p' | head -1 | tr -d '"' | sed 's/^AS[^ ]* - //')
            fi
            printf '%s\t%s\n' "$d" "${org:--}" >> "$ASNCACHE" 2>/dev/null
        fi
        [ "$org" = "-" ] && org=""
        REMJ="$REMJ${REMJ:+,}[\"$(esc "$d")\",\"$(esc "$nm")\",$b,$c,\"$(esc "$org")\"]"
        IFS='
'
    done
    IFS=$OIFS
    # cache growth is bounded: keep the newest 400 mappings
    [ -f "$PTRCACHE" ] && [ "$(wc -l < "$PTRCACHE")" -gt 400 ] && \
        { tail -200 "$PTRCACHE" > "$PTRCACHE.n" && mv "$PTRCACHE.n" "$PTRCACHE"; }
    [ -f "$ASNCACHE" ] && [ "$(wc -l < "$ASNCACHE")" -gt 400 ] && \
        { tail -200 "$ASNCACHE" > "$ASNCACHE.n" && mv "$ASNCACHE.n" "$ASNCACHE"; }

    printf '{"ok":true,"mac":"%s","protos":[%s],"remotes":[%s]}' "$(esc "$DMAC")" "$PJ" "$REMJ"
    exit 0
fi

# =========================== WRITE ACTIONS ===========================

# rename a device / change its class (classmap metadata only)
#
# No password: this is cosmetic metadata, it cannot disrupt the network, and it
# matches the same call made for the VPN toggle. guard_post still applies, so a
# cross-site page can't rewrite your device names.
if [ "$ACTION" = "setdev" ]; then
    MAC=$(qs_get_dec mac); NEWNAME=$(qs_get_dec name); NEWCLASS=$(qs_get_dec class)
    MAC=$(printf '%s' "$MAC" | tr 'a-f' 'A-F')
    case "$MAC" in
        [0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]) ;;
        *) printf '{"ok":false,"error":"bad mac"}'; exit 0 ;;
    esac
    case "$NEWCLASS" in
        computer|laptop|phone|pad|television|watch|smartappliances|router|default) ;;
        *) printf '{"ok":false,"error":"bad class"}'; exit 0 ;;
    esac
    # The classmap is pipe-delimited and line-based, so a name may contain
    # neither LITERAL separator - tr strips those - and the length is capped so
    # one entry can't bloat the file. That filter alone is NOT what keeps a line
    # from gaining a field or a newline: the name used to travel into awk via
    # -v, which re-creates separators from their text forms (the two characters
    # backslash+n became a newline, forging a whole extra row with an arbitrary
    # MAC). It now travels via ENVIRON[], which does no such processing, and
    # the same goes for ip/zone, which are read back out of this very file.
    NEWNAME=$(printf '%s' "$NEWNAME" | tr -d '|\n\r\t' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | cut -c1-40)
    [ -n "$NEWNAME" ] || { printf '{"ok":false,"error":"name cannot be empty"}'; exit 0; }

    mkdir -p /etc/dashboard
    [ -f "$CLASSMAP" ] || : > "$CLASSMAP"
    # carry over ip/zone from the existing row, else infer from the live lease
    OLDIP=$(awk -F'|' -v m="$MAC" '!/^#/ && toupper($1)==m {print $4; exit}' "$CLASSMAP" 2>/dev/null)
    OLDZONE=$(awk -F'|' -v m="$MAC" '!/^#/ && toupper($1)==m {print $5; exit}' "$CLASSMAP" 2>/dev/null)
    if [ -z "$OLDIP" ]; then
        OLDIP=$(awk -v m="$(printf '%s' "$MAC" | tr 'A-F' 'a-f')" '$2==m {print $3; exit}' /tmp/dhcp.leases 2>/dev/null)
    fi
    if [ -z "$OLDZONE" ]; then
        OLDZONE=$(zone_of_ip "$OLDIP")
    fi

    # Serialise concurrent saves. NOTE two traps here, both hit for real:
    #  * flock on this box is BUSYBOX flock — it supports only -sxun, there is
    #    no -w/timeout flag, so `flock -w 5 9` fails instantly.
    #  * `exit` inside a ( subshell ) exits only the subshell, so an error path
    #    there would print its error and then fall through to print success too.
    # Hence: retry loop with -n, and no subshell around the critical section.
    exec 9>>/tmp/.classmap.lock
    locked=0; tries=0
    while [ "$tries" -lt 5 ]; do
        if flock -n 9 2>/dev/null; then locked=1; break; fi
        tries=$((tries+1)); sleep 1
    done
    [ "$locked" = 1 ] || { printf '{"ok":false,"error":"another save is holding the class map right now — wait a second and try again"}'; exit 0; }

    TMPF="$CLASSMAP.$$"
    NM="$NEWNAME" OIP="$OLDIP" OZN="$OLDZONE" awk -F'|' -v m="$MAC" -v cl="$NEWCLASS" '
      BEGIN { done=0; nm=ENVIRON["NM"]; ip=ENVIRON["OIP"]; zn=ENVIRON["OZN"] }
      /^#/ { print; next }
      NF < 3 { print; next }
      {
        if (toupper($1) == m) { printf "%s|%s|%s|%s|%s\n", m, nm, cl, ip, zn; done=1 }
        else print
        next
      }
      END { if (!done) printf "%s|%s|%s|%s|%s\n", m, nm, cl, ip, zn }
    ' "$CLASSMAP" > "$TMPF" 2>/dev/null
    if [ -s "$TMPF" ]; then
        mv "$TMPF" "$CLASSMAP"
        flock -u 9 2>/dev/null
    else
        rm -f "$TMPF"
        flock -u 9 2>/dev/null
        printf '{"ok":false,"error":"could not write the class map — the rename did not happen. That is a filesystem refusal; check overlay space over SSH (df /overlay)"}'; exit 0
    fi

    printf '{"ok":true,"action":"setdev","mac":"%s","name":"%s","class":"%s"}' \
        "$(esc "$MAC")" "$(esc "$NEWNAME")" "$(esc "$NEWCLASS")"
    exit 0
fi

# Which radio serves a band. This board enumerates radio0=2.4 GHz and
# radio1=5 GHz, but that ordering is a board convention, not a rule — plenty of
# hardware enumerates 5 GHz first, and there the name-based guess restarts the
# other radio: you ask for a 5 GHz reset and 2.4 GHz drops instead. Ask each
# radio what band it declares. Falling back to the first radio keeps a
# single-band board working rather than refusing outright.
#
# Kept byte-identical to the copy in repeater-api: two copies that drift are a
# new bug, so change both or neither.
radio_for_band() {   # $1 = 2g | 5g | 6g
    _first=""; _any=""
    for _r in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
        [ -n "$_first" ] || _first="$_r"
        _b=$(uci -q get wireless.$_r.band 2>/dev/null)
        [ -n "$_b" ] && _any=1
        [ "$_b" = "$1" ] && { printf '%s' "$_r"; return 0; }
    done
    # No match. Where the radios declare bands, the honest answer is "there is
    # no such radio" — returning an unrelated one turns "restart 6 GHz" into
    # "restart 2.4 GHz". Only a config that names no bands at all (the old
    # hwmode style) falls back to the first radio.
    [ -n "$_any" ] || printf '%s' "$_first"
}

# Radio restart. The caller names the radio and it is checked against the
# router's own list, so no band has to be inferred at all.
if [ "$ACTION" = "fixradio" ] || [ "$ACTION" = "fix24g" ] || [ "$ACTION" = "fix5g" ]; then
    case "$ACTION" in
        fixradio) R=$(qs_get radio) ;;
        # Kept so a browser still holding the older settings page, and the
        # archived console under /legacy/, keep working. They resolve by band
        # rather than assuming radio0 is the 2.4 GHz one.
        fix24g)   R=$(radio_for_band 2g) ;;
        *)        R=$(radio_for_band 5g) ;;
    esac
    _okr=0
    for _r in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
        [ "$_r" = "$R" ] && { _okr=1; break; }
    done
    [ "$_okr" = "1" ] || { printf '{"ok":false,"error":"unknown radio"}'; exit 0; }
    ( wifi down "$R" >/dev/null 2>&1; sleep 2; wifi up "$R" >/dev/null 2>&1 ) >/dev/null 2>&1 &
    printf '{"ok":true,"action":"%s","radio":"%s"}' "$ACTION" "$(esc "$R")"
    exit 0
fi

# block / unblock a MAC on a specific wifi-iface section
if [ "$ACTION" = "aclset" ]; then
    MAC=$(qs_get mac); SEC=$(qs_get sec); BLK=$(qs_get block)
    MAC=$(printf '%s' "$MAC" | sed 's/%3A/:/g; s/%3a/:/g' | tr 'a-f' 'A-F')
    case "$MAC" in
        [0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]:[0-9A-F][0-9A-F]) ;;
        *) printf '{"ok":false,"error":"bad mac"}'; exit 0 ;;
    esac
    case "$SEC" in *[!a-zA-Z0-9_]*|"") printf '{"ok":false,"error":"bad section"}'; exit 0 ;; esac
    [ "$(uci -q get wireless.$SEC)" = "wifi-iface" ] || { printf '{"ok":false,"error":"unknown section"}'; exit 0; }

    # runtime ifname for this section (for the live deauth)
    IFACE=$(ubus call network.wireless status 2>/dev/null | awk -v want="$SEC" '
        /"section":/ { gsub(/[",]/,""); s=$2 }
        /"ifname":/  { gsub(/[",]/,""); if (s==want) { print $2; exit } }')

    # Reload only the radio this SSID lives on. Unscoped, blocking a single
    # device restarted every radio and dropped every wireless client on the
    # router — a whole-house outage to ban one plug. Falls back to reloading
    # everything only if the section names no device.
    SECRADIO=$(uci -q get wireless.$SEC.device)
    reload_sec() {
        if [ -n "$SECRADIO" ]; then wifi reload "$SECRADIO" >/dev/null 2>&1 &
        else wifi reload >/dev/null 2>&1 & fi
    }

    if [ "$BLK" = "1" ]; then
        uci set wireless.$SEC.macfilter='deny'
        cur=$(uci -q get wireless.$SEC.maclist)
        case " $cur " in *" $MAC "*) ;; *) uci add_list wireless.$SEC.maclist="$MAC" ;; esac
        uci commit wireless
        [ -n "$IFACE" ] && ubus call hostapd.$IFACE del_client \
            "{\"addr\":\"$MAC\",\"deauth\":true,\"reason\":1,\"ban_time\":60000}" >/dev/null 2>&1
        reload_sec
        printf '{"ok":true,"action":"block","mac":"%s"}' "$(esc "$MAC")"
    else
        uci -q del_list wireless.$SEC.maclist="$MAC"
        [ -z "$(uci -q get wireless.$SEC.maclist)" ] && uci -q delete wireless.$SEC.macfilter
        uci commit wireless
        reload_sec
        printf '{"ok":true,"action":"unblock","mac":"%s"}' "$(esc "$MAC")"
    fi
    exit 0
fi

# =========================== READ / STATUS ===========================

# ---- system ----
UP=$(cut -d. -f1 /proc/uptime 2>/dev/null); UP=$(jnum "$UP")
TEMP=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null); TEMP=$(jnum "$TEMP")
LOAD=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
HOST=$(uci -q get system.@system[0].hostname || echo OpenWrt)
# Fan RPM — locate by hwmon *name*, not a fixed hwmonN index (numbering is not
# stable across boots). GL's firmware showed this under CPU temp.
FAN=0
for h in /sys/class/hwmon/hwmon*/; do
    [ "$(cat "$h/name" 2>/dev/null)" = "pwmfan" ] || continue
    FAN=$(cat "$h/fan1_input" 2>/dev/null); break
done
FAN=$(jnum "$FAN")
MEMT=$(awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null)
MEMA=$(awk '/MemAvailable/{print $2}' /proc/meminfo 2>/dev/null)

# ---- wan throughput (delta since last poll) ----
RXB=$(cat /sys/class/net/$WANIF/statistics/rx_bytes 2>/dev/null); RXB=$(jnum "$RXB")
TXB=$(cat /sys/class/net/$WANIF/statistics/tx_bytes 2>/dev/null); TXB=$(jnum "$TXB")
NOW=$(date +%s)
WRX=0; WTX=0
if [ -f "$STATE" ]; then
    read -r pt prx ptx pdev < "$STATE" 2>/dev/null
    pt=$(jnum "$pt"); prx=$(jnum "$prx"); ptx=$(jnum "$ptx")
    d=$((NOW - pt))
    # WANIF can now change under us when the uplink fails over, and the two
    # interfaces' counters have nothing to do with each other — so a delta is
    # only meaningful when the previous sample came from the same device.
    if [ "$d" -gt 0 ] && [ "$d" -lt 120 ] && [ "$pdev" = "$WANIF" ]; then
        [ "$RXB" -ge "$prx" ] && WRX=$(( (RXB - prx) / d ))
        [ "$TXB" -ge "$ptx" ] && WTX=$(( (TXB - ptx) / d ))
    fi
fi
printf '%s %s %s %s\n' "$NOW" "$RXB" "$TXB" "$WANIF" > "$STATE" 2>/dev/null

# The address of the interface actually carrying the default route — not
# whatever network.wan happens to hold. This was pinned to network.interface.wan
# for the same reason WANIF above once was, and it had the same failure: fail the
# Ethernet over to the Wi-Fi uplink and `wan` goes down with an empty address, so
# the Overview drew "Uplink / Wi-Fi / no address" while the very same payload said
# "Online via the Wi-Fi uplink" and streamed live throughput off that device. The
# address was never missing; it was 192.168.1.114, on the interface we were
# already reading counters from. Deriving it from $WANIF means the address and
# the throughput can never disagree about which uplink they describe.
WANIP=$(ip -4 addr show dev "$WANIF" 2>/dev/null | awk '/inet /{split($2,a,"/"); print a[1]; exit}')
# No default route at all (genuinely offline) leaves WANIF empty and the lookup
# blank; fall back to the logical interface so a wan that is up but not yet
# carrying the default route still reports its address rather than nothing.
[ -n "$WANIP" ] || WANIP=$(ubus call network.interface.wan status 2>/dev/null | awk -F'"' '/"address":/{print $4; exit}')

# ---- classmap -> json ----
CMJ="{}"
if [ -f "$CLASSMAP" ]; then
    CMJ=$(awk -F'|' '
        /^#/ || NF<3 { next }
        {
            mac=toupper($1); name=$2; cls=$3; ip=$4; zone=$5
            gsub(/\\/,"\\\\&",name); gsub(/"/,"\\\\&",name)
            printf "%s\"%s\":{\"name\":\"%s\",\"class\":\"%s\",\"ip\":\"%s\",\"zone\":\"%s\"}", (c++?",":""), mac, name, cls, ip, zone
        }
        END { }' "$CLASSMAP")
    CMJ="{$CMJ}"
fi

# ---- leases -> json (incl. expiry epoch for lease-remaining calc) ----
# NOTE: the expiry variable must NOT be called `exp` — that is awk's built-in
# exponential function, and assigning to it is a syntax error. awk then produced
# nothing at all, so this map silently came back empty and the client list lost
# every DHCP hostname and lease expiry while still looking plausible.
LJ=$(awk '{
        lexp=$1; mac=toupper($2); ip=$3; nm=$4
        gsub(/\\/,"\\\\&",nm); gsub(/"/,"\\\\&",nm)
        printf "%s\"%s\":{\"ip\":\"%s\",\"name\":\"%s\",\"exp\":%s}", (c++?",":""), mac, ip, nm, (lexp~/^[0-9]+$/?lexp:0)
    }' /tmp/dhcp.leases 2>/dev/null)
LJ="{$LJ}"

# ---- vpn policy map: MAC -> tunnel label ----
# Only devices whose policy is enabled AND whose tunnel interface actually exists
# count as "on VPN" — a parked policy (see sync_pbr in vpn-api) is not routing
# anything, so badging it would be a lie.
VPNJ=""
VPNSTALE=""     # devices whose tunnel is not actually carrying them
vidx=0
NOWTS=$(date +%s)

# Which pbr tables actually carry a route. A live tunnel is NOT the same thing
# as a tunnel something routes into — see the header of the helper for the
# failure this catches and how it was measured. Shared with vpn-api so the
# Overview and the VPN page cannot disagree about the same device.
PBRTBL=$(/usr/sbin/beryl-pbrtbl 2>/dev/null)
while [ "$vidx" -lt 64 ]; do
    pn=$(uci -q get pbr.@policy[$vidx].name 2>/dev/null) || break
    [ -n "$pn" ] || break
    case "$pn" in
        dash_*)
            sa=$(uci -q get pbr.@policy[$vidx].src_addr 2>/dev/null)
            inf=$(uci -q get pbr.@policy[$vidx].interface 2>/dev/null)
            en=$(uci -q get pbr.@policy[$vidx].enabled 2>/dev/null)
            if [ "$en" = "1" ] && [ -n "$inf" ] && ip link show "$inf" >/dev/null 2>&1; then
                lbl=$(uci -q get network.$inf.label 2>/dev/null); [ -n "$lbl" ] || lbl="${inf#wg_}"
                sa=$(printf '%s' "$sa" | tr 'a-f' 'A-F')
                VPNJ="$VPNJ${VPNJ:+,}\"$(esc "$sa")\":\"$(esc "$lbl")\""
                # TRAVEL TRAP: with pbr strict_enforcement=1 a device whose tunnel
                # is down is fail-closed = has NO internet, silently. Common when a
                # hotel/cafe blocks WireGuard, or before captive-portal sign-in.
                # Flag it so the UI can say "pause the VPN" instead of leaving the
                # owner staring at a dead device with no idea why.
                hs=$(wg show "$inf" latest-handshakes 2>/dev/null | awk 'NR==1{print $2+0}')
                : "${hs:=0}"
                # `reason` distinguishes two failures that look identical from the
                # outside but need opposite remedies: a dead tunnel is fixed by
                # pausing the VPN, whereas a live tunnel that nothing routes into
                # is a policy-routing fault and pausing would not help.
                vreason=""
                if [ "$hs" -eq 0 ] || [ $((NOWTS - hs)) -gt 200 ]; then
                    vreason="down"
                else
                    case "$PBRTBL" in
                        *"|pbr_$inf=route|"*)   vreason="" ;;
                        *"|pbr_$inf=blocked|"*) vreason="blocked" ;;
                        *)                      vreason="unrouted" ;;
                    esac
                fi
                if [ -n "$vreason" ]; then
                    VPNSTALE="$VPNSTALE${VPNSTALE:+,}{\"mac\":\"$(esc "$sa")\",\"label\":\"$(esc "$lbl")\",\"reason\":\"$vreason\"}"
                fi
            fi ;;
    esac
    vidx=$((vidx+1))
done
VPNJ="{$VPNJ}"
VPNSTALE="[$VPNSTALE]"

# ---- host hints (may be large but is valid json) ----
HH=$(ubus call luci-rpc getHostHints 2>/dev/null)
[ -n "$HH" ] || HH="{}"

# ---- access points ----
APS=""
for sec in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
    mode=$(uci -q get wireless.$sec.mode)
    [ "$mode" = "ap" ] || continue
    dis=$(uci -q get wireless.$sec.disabled)
    [ "$dis" = "1" ] && continue
    net=$(uci -q get wireless.$sec.network)
    dev=$(uci -q get wireless.$sec.device)
    band=$(uci -q get wireless.$dev.band)
    # runtime ifname for this section
    ifn=$(ubus call network.wireless status 2>/dev/null | awk -v want="$sec" '
        /"section":/ { gsub(/[",]/,""); s=$2 }
        /"ifname":/  { gsub(/[",]/,""); if (s==want) { print $2; exit } }')
    [ -n "$ifn" ] || continue
    info=$(ubus call iwinfo info "{\"device\":\"$ifn\"}" 2>/dev/null); [ -n "$info" ] || info="{}"
    assoc=$(ubus call iwinfo assoclist "{\"device\":\"$ifn\"}" 2>/dev/null); [ -n "$assoc" ] || assoc='{"results":[]}'
    mfilt=$(uci -q get wireless.$sec.macfilter)
    mlist=$(uci -q get wireless.$sec.maclist)
    mlj=""
    for m in $mlist; do mlj="$mlj${mlj:+,}\"$(esc "$m")\""; done
    APS="$APS${APS:+,}{\"section\":\"$(esc "$sec")\",\"ifname\":\"$(esc "$ifn")\",\"network\":\"$(esc "$net")\",\"band\":\"$(esc "$band")\",\"macfilter\":\"$(esc "$mfilt")\",\"maclist\":[$mlj],\"info\":$info,\"assoc\":$assoc}"
done

# ---- wireless interface names ----
# Never assume a naming scheme. mac80211 lets the driver/config choose: this
# board presents phy0.<radio>-ap<n>, stock OpenWrt presents wlan0/wlan1, and a
# renamed ifname in UCI produces something else again. Globbing /sys/class/net
# for a fixed prefix silently yields nothing on any of those, which would show
# an empty client list rather than an error. `iw dev` is authoritative.
WLIFS=$(iw dev 2>/dev/null | awk '/^\tInterface /{print $2}')

# One interface per phy is enough for a survey: the dump covers the whole radio,
# and on a single-phy dual-band device it returns both bands at once. Picking
# one per phy keeps the fork count at the number of radios, not interfaces.
SURVEYIFS=$(for _i in $WLIFS; do
        _p=$(cat "/sys/class/net/$_i/phy80211/name" 2>/dev/null); [ -n "$_p" ] || _p="$_i"
        printf '%s %s\n' "$_p" "$_i"
    done | sort -u -k1,1 | awk '{print $2}')

# ---- air / survey ----
AIRJ=$(for _i in $SURVEYIFS; do iw dev "$_i" survey dump 2>/dev/null; done | awk '
    /frequency:/ { inuse = ($0 ~ /\[in use\]/); if (inuse) f=$2+0 }
    inuse && /channel active time/ { a[f]=$4+0 }
    inuse && /channel busy time/   { b[f]=$4+0 }
    END {
        g24a=g24b=g5a=g5b=0
        for (f in a) if (f<3000) { g24a=a[f]; g24b=b[f] } else { g5a=a[f]; g5b=b[f] }
        printf "{\"g24\":{\"active\":%d,\"busy\":%d},\"g5\":{\"active\":%d,\"busy\":%d}}", g24a,g24b,g5a,g5b
    }')
[ -n "$AIRJ" ] || AIRJ='null'

# ---- per-station detail that ONLY `iw` exposes (assoclist has no equivalent) ----
# airtime durations, per-antenna RSSI, ack signal, DTIM/beacon, expected throughput.
# Bracket handling avoids awk char-classes entirely (busybox honours no escapes
# inside [...]); index()/substr() is the portable way to read "-56, -57".
STAJ=$(for _i in $WLIFS; do
        iw dev "$_i" station dump 2>/dev/null
      done | awk '
        /^Station/ { mac=toupper($2); next }
        mac=="" { next }
        /tx duration:/         { txd[mac]=$3+0; next }
        /rx duration:/         { rxd[mac]=$3+0; next }
        /last ack signal:/     { split($0,p,":"); split(p[2],q," "); ack[mac]=q[1]+0;  next }
        /avg ack signal:/      { split($0,p,":"); split(p[2],q," "); acka[mac]=q[1]+0; next }
        /airtime weight:/      { wt[mac]=$3+0; next }
        /DTIM period:/         { dtim[mac]=$3+0; next }
        /beacon interval:/     { split($0,p,":"); bi[mac]=p[2]+0; next }
        /expected throughput:/ { split($0,p,":"); v=p[2]; sub(/Mbps/,"",v); thr[mac]=v+0; next }
        /signal:/ {
            if ($0 !~ /ack/) {
                i=index($0,"["); j=index($0,"]")
                if (i>0 && j>i) { c=substr($0,i+1,j-i-1); gsub(/ /,"",c); ch[mac]=c }
            }
            next
        }
        END {
            for (m in txd)
                printf "%s\"%s\":{\"txd\":%d,\"rxd\":%d,\"ack\":%d,\"acka\":%d,\"wt\":%d,\"dtim\":%d,\"bi\":%d,\"ethr\":%d,\"chains\":\"%s\"}", \
                    (n++?",":""), m, txd[m], rxd[m], ack[m], acka[m], wt[m], dtim[m], bi[m], thr[m], ch[m]
        }')
STAJ="{$STAJ}"

# Per-client connection counts used to be built here by walking
# /proc/net/nf_conntrack. The only consumer was the "Open flows" row in the
# client detail, removed 2026-08-09, so the whole scan went with it — it cost
# ~12ms of the response for data nobody read.

# ---- neighbour reachability (REACHABLE / STALE / FAILED …) ----
NBJ=$(ip neigh show 2>/dev/null | awk '
        /lladdr/ { m=toupper($5); s=$NF; if (s!="" && m!="") printf "%s\"%s\":\"%s\"", (n++?",":""), m, s }')
NBJ="{$NBJ}"

# ---- non-Wi-Fi LAN devices (so the VPN page can route an Ethernet machine) ----
# pbr matches on `ether saddr`, so a wired PC is routable exactly like a Wi-Fi
# client — but the device picker was built purely from Wi-Fi assoclists, so an
# Ethernet machine could never be selected.
#
# "Not currently associated" is NOT the same as "wired": a sleeping iPhone keeps
# its DHCP lease and ARP entry and would be mislabelled Ethernet. The bridge FDB
# is authoritative — it records which bridge port each MAC was last seen on:
#   port eth1        -> genuinely wired
#   port <wireless>  -> Wi-Fi
#   absent           -> idle / aged out (FDB entries expire ~5 min), link unknown
# So each host is classified honestly rather than guessed at. The wireless side
# is matched against the real interface list (WLIFS) rather than a name prefix,
# because the prefix differs between builds — see the note at WLIFS.
WIFIMACS=$(for _i in $WLIFS; do
             iw dev "$_i" station dump 2>/dev/null | awk '/^Station/{print toupper($2)}'
           done)
FDBWIRED=$(bridge fdb show 2>/dev/null | awk -v wl="$WLIFS" '
    BEGIN { n=split(wl, a, "\n"); for (i=1; i<=n; i++) if (a[i] != "") WL[a[i]]=1 }
    $3 != "" && !($3 in WL) && !/permanent|self/ { print toupper($1), $3 }' | sort -u)
# What each wired bridge port actually negotiated. This is the ROUTER's end of
# the cable: it is the client's own link speed when the client is plugged
# straight in, and the trunk speed when a switch sits between them. The client
# can tell the two apart — more than one MAC on one port means a switch — so it
# labels the reading rather than overstating it.
#
# speed reads -1 and duplex "unknown" while a port is down, hence the guards;
# both are plain sysfs, no ethtool on the router.
PORTLINK=$(for _bp in /sys/class/net/$LANDEV/brif/*; do
    _bn=$(basename "$_bp" 2>/dev/null)
    [ "$_bn" = '*' ] && continue
    case " $(echo $WLIFS) " in *" $_bn "*) continue ;; esac
    _sp=$(cat "/sys/class/net/$_bn/speed" 2>/dev/null)
    _dx=$(cat "/sys/class/net/$_bn/duplex" 2>/dev/null)
    case "$_sp" in ''|*[!0-9]*) _sp=0 ;; esac
    case "$_dx" in full|half) : ;; *) _dx='' ;; esac
    echo "$_bn $_sp $_dx"
done)
LANPFX=$(uci -q get network.lan.ipaddr 2>/dev/null | cut -d. -f1-3)
WIREDJ=""
if [ -n "$LANPFX" ]; then
WIREDJ=$( {
    ip -4 neigh show dev "$LANDEV" 2>/dev/null | awk '/lladdr/{print toupper($3), $1}'
    awk '{print toupper($2), $3}' /tmp/dhcp.leases 2>/dev/null
  } | awk -v wifi="$WIFIMACS" -v wired="$FDBWIRED" -v plink="$PORTLINK" -v pfx="$LANPFX." '
      BEGIN {
        n=split(wifi,  w, "\n"); for (i=1; i<=n; i++) if (w[i] != "") W[w[i]]=1
        m=split(wired, e, "\n"); for (i=1; i<=m; i++) {
          if (e[i] == "") continue
          split(e[i], f, " "); if (f[1] != "") E[f[1]]=f[2]
        }
        p=split(plink, g, "\n"); for (i=1; i<=p; i++) {
          if (g[i] == "") continue
          split(g[i], h, " "); if (h[1] != "") { SP[h[1]]=h[2]+0; DX[h[1]]=h[3] }
        }
      }
      {
        mac=$1; ip=$2
        if (mac == "" || ip == "") next
        if (index(ip, pfx) != 1) next     # LAN subnet only (keeps iot/guest out)
        if (mac in W) next                # associated on Wi-Fi -> already listed
        if (mac in seen) next
        seen[mac]=1
        port = (mac in E) ? E[mac] : ""
        printf "%s{\"mac\":\"%s\",\"ip\":\"%s\",\"link\":\"%s\"", \
               (c++?",":""), mac, ip, (port != "" ? "wired" : "idle")
        if (port != "") {
          printf ",\"port\":\"%s\"", port
          if (SP[port] > 0)  printf ",\"speed\":%d", SP[port]
          if (DX[port] != "") printf ",\"duplex\":\"%s\"", DX[port]
        }
        printf "}"
      }')
fi
WIREDJ="[$WIREDJ]"

# ---- optional vendor map: /etc/dashboard/oui, lines "AA:BB:CC|Vendor" ----
# Deliberately empty by default — no OUI database ships on OpenWrt and guessing a
# vendor from memory would put fabricated data on screen. Populate to enable.
OUIJ=$(awk -F'|' '/^#/||NF<2{next}{
        v=$2; gsub(/\\/,"\\\\&",v); gsub(/"/,"\\\\&",v)
        printf "%s\"%s\":\"%s\"", (n++?",":""), toupper($1), v
      }' /etc/dashboard/oui 2>/dev/null)
OUIJ="{$OUIJ}"

# ---- WAN latency ring buffer (written by /usr/sbin/dashmon each minute) ----
# ---- WAN probe, summarised ---------------------------------------------------
# Just the last minute, as three numbers. The ring itself belongs to rate-api,
# which is polled once a second; sending it here as well would put 2 KB of
# duplicate history in every 5s payload for a chart that has a fresher copy.
#
# There used to be a 4-hour ring here too, written by dashmon a row a minute.
# Deleted 2026-08-11: five minutes is the window that gets looked at, and four
# hours of it was 6 KB a poll to draw a line nobody read.
#
# pingmon writes this line already computed, so two shell reads and no parser.
# loss=100 with no ring at all is the honest default — it drives the topology's
# "no route to the internet", and claiming reachability we cannot demonstrate is
# the wrong way to be wrong.
PROBE_LOSS=100; PROBE_PING=-1; PROBE_JIT=-1; PROBE_STATE=unknown
read -r _upnow _ < /proc/uptime 2>/dev/null; _upnow=${_upnow%.*}
case "$_upnow" in ''|*[!0-9]*) _upnow=0 ;; esac
if [ -f /tmp/.pingring ]; then
    { read -r _h; read -r _; read -r _sum; } < /tmp/.pingring 2>/dev/null
    set -- $_h
    if [ -n "$1" ] && [ $(( _upnow - $1 )) -le 90 ]; then
        PROBE_STATE=${3:-unknown}
        set -- $_sum
        case "$1$2$3" in
            ''|*[!0-9.-]*) : ;;
            *) PROBE_LOSS=$1; PROBE_PING=$2; PROBE_JIT=$3 ;;
        esac
    fi
fi

# ---- is there internet, decided WITHOUT the selectable probe target ---------
# The Overview lets you aim the probe at a game server or at your own gateway,
# and most game servers drop ICMP outright. If the hero panel took its verdict
# from whatever you happened to select, pointing the probe at a silent host
# would black out the whole page and claim you were offline.
#
# So it is the union of two things that fail differently:
#   * no default route at all  -> the cable or the upstream box is gone
#   * nothing reachable        -> the route is there and the internet is not
# `silent` is NOT offline: it means the chosen target does not answer pings,
# which is a fact about the target. Only `down` — set when neither public
# resolver replies — counts. dashmon's own independent probe is the fallback
# for pingmon being stopped, so the verdict never depends on one mechanism.
ONLINE=true
[ "$UPACT" = "none" ] && ONLINE=false
[ "$PROBE_STATE" = "down" ] && ONLINE=false
if [ "$PROBE_STATE" = "unknown" ] && [ -f /tmp/.wanreach ]; then
    read -r _wu _wl < /tmp/.wanreach 2>/dev/null
    case "$_wu" in ''|*[!0-9]*) _wu=-1 ;; esac
    if [ "$_wu" -ge 0 ] && [ $(( _upnow - _wu )) -le 150 ] && [ "$_wl" = "100" ]; then
        ONLINE=false
    fi
fi

# ---- join/leave events (dashmon), names joined from the classmap ----
EVJ=$(tail -n 12 /tmp/.presence 2>/dev/null | awk -F'|' '
    NR==FNR { if ($0 !~ /^#/ && NF>=2) n[toupper($1)]=$2; next }
    {
        split($0,x," "); if (x[1]!~/^[0-9]+$/) next
        ev=(x[2]=="join")?"join":"leave"; mac=toupper(x[3]); nm=(mac in n)?n[mac]:""
        gsub(/\\/,"\\\\&",nm); gsub(/"/,"\\\\&",nm)
        printf "%s{\"t\":%d,\"ev\":\"%s\",\"mac\":\"%s\",\"name\":\"%s\",\"band\":\"%s\"}", (c++?",":""), x[1], ev, mac, nm, x[4]
    }' "$CLASSMAP" -)
EVJ="[$EVJ]"

# ---- per-device traffic accounting (nlbwmon) --------------------------------
# Two problems with using nlbwmon's numbers as "today", both solved here.
#
# 1. Its accounting period is not a day. The default (database_interval=1) means
#    "restart on the 1st of the month", so a panel labelled today would quietly
#    show weeks. The period is therefore reported alongside the data and the
#    client titles the panel from it rather than assuming.
#
# 2. Even set to a daily period, nlbwmon anchors periods to UTC, so its counters
#    reset at 07:00 in this timezone rather than at local midnight.
#
# So dashmon records a baseline at the first minute of each LOCAL day, and the
# real figure is derived from it below. When anything about that baseline is
# missing or inconsistent, this falls back to nlbwmon's raw period totals and
# says so via nlbw_daily — reporting an honest wider window beats inventing a
# number.
#
# `-c list` is newest-first, so the current period is the FIRST line. Read once
# and split locally — this endpoint is polled every 5s, so a second fork here
# would be paid forever for a value already in hand. (Every nlbw call measured
# ~1.3-2.7 ms with `time` over 30 iterations; busybox `date` has no %N, so
# subtracting timestamps reports 0 and cannot measure anything at this scale.)
# The exit status separates "the accounting daemon is not answering" from "the
# day is young and nothing has been recorded yet". Both produce an empty table,
# and the panel said "No per-device accounting YET today" for both — true in the
# second case, and in the first a quiet network reported where a missing
# measurement should be. Measured: nlbwmon running gives exit 0 and a list of
# periods; stopped gives exit 247 and no output. Free, because this call was
# already being made.
NLLIST=$(nlbw -c list 2>/dev/null); NLOK=$?
NLPER=$(printf '%s\n' "$NLLIST" | head -1)
NLPREV=$(printf '%s\n' "$NLLIST" | sed -n '2p')
case "$NLPER" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
    *) NLPER="" ;;
esac

DAILYF=/etc/dashboard/nlbw-daily
NLDAILY=false
SNAPDAY=$(sed -n 's/^day=//p' "$DAILYF" 2>/dev/null | head -1)
SNAPPER=$(sed -n 's/^period=//p' "$DAILYF" 2>/dev/null | head -1)
CLOSED=""

if [ -n "$NLPER" ] && [ -n "$SNAPPER" ] && [ "$SNAPDAY" = "$(date +%Y-%m-%d)" ]; then
    if [ "$NLPER" = "$SNAPPER" ]; then
        NLDAILY=true                       # no rollover yet today
    elif [ "$NLPREV" = "$SNAPPER" ]; then
        # Rolled over once since local midnight, which is the normal case for a
        # daily period: the baseline's own period is now closed, so the part of
        # it that belongs to today is its final total minus the baseline.
        CLOSED=$(nlbw -c csv -g mac -t "$SNAPPER" 2>/dev/null | awk -F'\t' 'NR>1{
            gsub(/"/,"",$1); gsub(/"/,"",$3); gsub(/"/,"",$5)
            if ($1 != "") print $1, $3, $5 }')
        [ -n "$CLOSED" ] && NLDAILY=true
    fi
    # More than one rollover since midnight means the period is shorter than a
    # day and this arithmetic no longer holds — fall through to raw totals.
fi

if [ "$NLDAILY" = "true" ]; then
    NLJ=$( {
        awk '!/=/ && NF>=3 {print "B", $1, $2, $3}' "$DAILYF" 2>/dev/null
        [ -n "$CLOSED" ] && printf '%s\n' "$CLOSED" | awk '{print "C", $1, $2, $3}'
        nlbw -c csv -g mac 2>/dev/null | awk -F'\t' 'NR>1{
            for (i=1; i<=6; i++) gsub(/"/,"",$i)
            if ($1 != "") print "X", $1, $2, $3, $4, $5, $6 }'
      } | awk '
        $1=="B" { brx[$2]=$3+0; btx[$2]=$4+0; next }
        $1=="C" { crx[$2]=$3+0; ctx[$2]=$4+0; seenC[$2]=1; next }
        $1=="X" {
            m=$2; conns[m]=$3+0; rxp[m]=$5+0; txp[m]=$7+0
            rx[m]=$4+0; tx[m]=$6+0; seenX[m]=1
            next
        }
        function today(v, closed, base,   d) {
            # closed remainder (0 when no rollover) plus the current period
            d = (closed - base) + v
            return (d > 0) ? d : 0
        }
        END {
            printf "{\"columns\":[\"mac\",\"conns\",\"rx_bytes\",\"rx_pkts\",\"tx_bytes\",\"tx_pkts\"],\"data\":["
            n = 0
            for (m in seenX) {
                r = today(rx[m], crx[m], brx[m]); t = today(tx[m], ctx[m], btx[m])
                if (r == 0 && t == 0) continue
                # %.0f, never %d: busybox awk truncates %d at 2147483647, so every counter
                # past 2 GB pinned to exactly 2.0 GB - wrong, and wrong in the
                # believable direction. awk holds doubles and is exact to 2^53.
                printf "%s[\"%s\",%.0f,%.0f,%.0f,%.0f,%.0f]", (n++ ? "," : ""), m, conns[m], r, rxp[m], t, txp[m]
            }
            # A device that was busy before the rollover and silent since has no
            # row in the current period at all; without this it would vanish
            # from the day rather than show what it actually used.
            for (m in seenC) {
                if (m in seenX) continue
                r = crx[m] - brx[m]; t = ctx[m] - btx[m]
                if (r < 0) r = 0; if (t < 0) t = 0
                if (r == 0 && t == 0) continue
                printf "%s[\"%s\",0,%.0f,0,%.0f,0]", (n++ ? "," : ""), m, r, t
            }
            printf "]}"
        }')
    [ -n "$NLJ" ] || { NLJ=$(nlbw -c json -g mac 2>/dev/null); NLDAILY=false; }
else
    NLJ=$(nlbw -c json -g mac 2>/dev/null)
fi
case "$NLJ" in '{'*'}') ;; *) NLJ='null' ;; esac

printf '{"ok":true,"ts":%s,' "$NOW"

# ---- is there a firewall at all ---------------------------------------------
# Device-wide, so it belongs on the Overview rather than buried in the VPN page,
# which until now was the only place in the whole console that could tell you the
# firewall was missing — and it said so as though a tunnel were misconfigured.
#
# Every bullet of this project's stated security model rests on the firewall
# being loaded: WAN input DROP/REJECT is the only thing keeping a console with no
# login off the internet. fw4 loads in one nft transaction, so any malformed file
# under /etc/nftables.d/, from any package, means nothing loads at all.
#
# On dashboard-api and NOT rate-api on purpose. This endpoint already costs
# ~455ms at a 5s poll, so a ~5.6ms read is close to 1% of it. rate-api costs
# ~9ms at a 1s poll and does not even source this library; the same read there
# would roughly double the cheapest endpoint on the console, and that cost is
# the whole reason the 1-second charts are affordable.
#
# Once per request, never in a per-device loop. `unknown` is reported rather than
# guessed, and the page stays silent on it.
FWSTATE=$(fw_table_state)
# IPv6 reachability, written by dashmon. Reported separately from the v4 probe
# because they fail independently — the 2026-08-10 outage took v6 down while v4
# stayed perfect. -1 means dashmon has not sampled yet.
# AGE-CHECKED, like .wanreach and for the same reason. Without this the last
# sample was believed forever: stop cron and the Overview went on printing IPv6
# REACHABLE in the ok tone from a measurement that had stopped being taken. A
# dead gauge reading "fine" is worse than no gauge.
#
# 150s covers two missed cron cycles, matching the .wanreach guard. Both sides
# are now uptime, so the comparison is like-for-like; the negative test catches a
# file written before a reboot, which tmpfs makes theoretical but costs nothing.
#
# -1 means "not measured recently" and the page HIDES the row rather than
# claiming anything — the same path a router takes in its first minute of
# uptime. Deliberately not rendered as a fault: "nobody is measuring" and
# "IPv6 is down" are different facts and only one of them is about the network.
V6LOSS=-1
if [ -f /tmp/.wanlat6 ]; then
    read -r _v6u _v6l < /tmp/.wanlat6 2>/dev/null
    case "$_v6u" in ''|*[!0-9]*) _v6u=-1 ;; esac
    case "$_v6l" in ''|*[!0-9]*) _v6l=-1 ;; esac
    _v6age=$(( _upnow - _v6u ))
    [ "$_v6u" -ge 0 ] && [ "$_v6age" -ge 0 ] && [ "$_v6age" -le 150 ] && V6LOSS=$_v6l
fi

# ---- which uplink owns the default route, and how long it has owned it ------
# Sits here rather than beside the "uplink" key below because sys.wan_uptime
# needs it: how long the LINK has been up is a different fact from how long the
# ROUTER has, and the gap between them is the only thing on this page that says
# the connection dropped while nobody was watching. Same ubus call either way.
ACTDEV=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
UPACT="none"; UPSECS=-1
if [ -n "$ACTDEV" ]; then
    for _n in wan wwan tethering; do
        _st=$(ubus call network.interface.$_n status 2>/dev/null)
        _l=$(printf '%s' "$_st" | awk -F'"' '/"l3_device"/{print $4; exit}')
        if [ "$_l" = "$ACTDEV" ]; then
            UPACT="$_n"
            UPSECS=$(printf '%s' "$_st" | awk -F: '/"uptime"/{gsub(/[^0-9]/,"",$2); print $2+0; exit}')
            case "$UPSECS" in ''|*[!0-9]*) UPSECS=-1 ;; esac
            break
        fi
    done
fi

# Overlay usage. This is the writable half of the flash — everything uci
# commits and every installed package lands here, and when it fills, config
# writes start failing in ways that look like unrelated bugs. Nothing else on
# the console would say so. RAM and flash are different enough problems to be
# worth separate rows; MemAvailable above says nothing about this.
OVL=$(df /overlay 2>/dev/null | awk 'NR==2 {printf "%d %d", $2+0, $3+0}')
OVLT=${OVL%% *}; OVLU=${OVL##* }
case "$OVLT" in ''|*[!0-9]*) OVLT=0 ;; esac
case "$OVLU" in ''|*[!0-9]*) OVLU=0 ;; esac

printf '"sys":{"host":"%s","uptime":%s,"temp":%s,"fan_rpm":%s,"load":"%s","mem_total":%s,"mem_avail":%s,"v6_loss":%s,' \
    "$(esc "$HOST")" "$UP" "$TEMP" "$FAN" "$(esc "$LOAD")" "$(jnum "$MEMT")" "$(jnum "$MEMA")" "$V6LOSS"
printf '"ovl_total":%s,"ovl_used":%s,"wan_uptime":%s,"firewall":"%s"},' \
    "$OVLT" "$OVLU" "${UPSECS:--1}" "$FWSTATE"

# ---- are the background jobs still completing? ------------------------------
# dashmon, apwatch and vpnwatch share one crontab line each and therefore live or
# die together. Nothing surfaced whether any of them was alive, which matters
# most for apwatch: it exists because a failed radio reload leaves a traveller
# "with only a phone... no AP, no dashboard, no SSH", so its silent death removes
# the recovery the whole travelling story depends on.
#
# Each job stamps /tmp/.hb-<name> with the uptime at which it FINISHED its work.
# Freshness of that stamp is the observable; process presence is not, because
# vpnwatch exits immediately by design whenever the fail mode is closed.
#
# GRACE, 180s. The stamps live in RAM and are gone after a reboot, so before the
# first cron tick every job is "stale" and a bare check would cry wolf on every
# single start-up — the most frequent condition on a travel router. cron can take
# up to 60s to reach the first tick, the jobs take a moment, and one missed tick
# should not fire; 180s covers all of that. Deliberately NOT apwatch's
# MIN_UPTIME=600, which is the right number for leaving radios alone while boot
# settles and the wrong one here: it would blind this check for ten minutes after
# every boot. apwatch stamps from its very first run precisely so that standing
# back during those ten minutes reads as healthy rather than dead.
#
# STALE, 150s. The jobs run every minute and a slow one can stamp a few seconds
# late, so ~65s between stamps is normal; 150s tolerates a fully missed tick
# without complaining and still surfaces a dead cron inside three minutes. Same
# window as .wanreach, which is the same class of signal.
#
# The cron daemon is only asked about when a stamp is already stale — 40ms, and
# the healthy path should not pay it. It separates two diagnoses with different
# remedies: cron itself down, versus one job failing while the others run.
JOBS_STATE=ok; JOBS_STALE=""; JOBS_CRON=true
if [ "$_upnow" -lt 180 ]; then
    JOBS_STATE=grace
else
    # `read`, not `cat`: this is on the healthy path of a 5s poll and four forks
    # measured ~38ms, which is most of what this whole check costs.
    _fmj=""; [ -f /etc/dashboard/vpn-failmode ] && read -r _fmj < /etc/dashboard/vpn-failmode 2>/dev/null
    case "$_fmj" in open|closed) ;; *) _fmj=closed ;; esac
    for _j in dashmon apwatch vpnwatch; do
        # A dead vpnwatch under the CLOSED fail mode is latent, not present, harm:
        # it has nothing to release. Warning about it here would be warning about
        # something currently harmless, which is how an alarm earns a reflex to
        # dismiss it. The VPN page reports it where it actually bites — on the
        # promise that devices get released, which only exists under open.
        [ "$_j" = vpnwatch ] && [ "$_fmj" != open ] && continue
        _hbv=""; [ -f "/tmp/.hb-$_j" ] && read -r _hbv < "/tmp/.hb-$_j" 2>/dev/null
        case "$_hbv" in ''|*[!0-9]*) _hbv=-1 ;; esac
        _hbage=$((_upnow - _hbv))
        if [ "$_hbv" -lt 0 ] || [ "$_hbage" -lt 0 ] || [ "$_hbage" -gt 150 ]; then
            JOBS_STALE="$JOBS_STALE $_j"
        fi
    done
    if [ -n "$JOBS_STALE" ]; then
        JOBS_STATE=stale
        /etc/init.d/cron running >/dev/null 2>&1 || JOBS_CRON=false
    fi
fi
_jl=""
for _j in $JOBS_STALE; do _jl="$_jl${_jl:+,}\"$(esc "$_j")\""; done
printf '"jobs":{"state":"%s","cron":%s,"stale":[%s]},' "$JOBS_STATE" "$JOBS_CRON" "$_jl"
# ---- per-lane byte counters -------------------------------------------------
# Every lane drawn on the topology is exactly one netdev: each AP has its own
# wireless interface, and the wired lane is the LAN bridge's non-wireless port(s). One
# counter per lane lets the client answer "is this lane carrying traffic" the
# same way for all of them, instead of the three unrelated guesses it used to
# make (station idle time for Wi-Fi, a hardcoded false for IoT, and merely
# "a wired device exists" for Ethernet, which was true essentially always).
# Beacons do not appear in these counters — measured 4 B/s on an idle AP over
# 32 hours — so the numbers are real client traffic.
LBJ=""
lb_add() {   # $1 = key, $2 = netdev
    _lr=$(cat "/sys/class/net/$2/statistics/rx_bytes" 2>/dev/null)
    _lt=$(cat "/sys/class/net/$2/statistics/tx_bytes" 2>/dev/null)
    case "$_lr" in ''|*[!0-9]*) _lr=0 ;; esac
    case "$_lt" in ''|*[!0-9]*) _lt=0 ;; esac
    LBJ="$LBJ${LBJ:+,}\"$(esc "$1")\":$((_lr + _lt))"
}
for _wn in $WLIFS; do
    [ -d "/sys/class/net/$_wn" ] || continue
    lb_add "$_wn" "$_wn"
done
_wired=0
for _bp in /sys/class/net/$LANDEV/brif/*; do
    _bn=$(basename "$_bp" 2>/dev/null)
    [ "$_bn" = '*' ] && continue
    # skip the wireless ports; what remains is the genuinely wired lane
    case " $(echo $WLIFS) " in *" $_bn "*) continue ;; esac
    _br=$(cat "/sys/class/net/$_bn/statistics/rx_bytes" 2>/dev/null)
    _bt=$(cat "/sys/class/net/$_bn/statistics/tx_bytes" 2>/dev/null)
    case "$_br" in ''|*[!0-9]*) _br=0 ;; esac
    case "$_bt" in ''|*[!0-9]*) _bt=0 ;; esac
    _wired=$((_wired + _br + _bt))
done
LBJ="$LBJ${LBJ:+,}\"wired\":$_wired"
printf '"lanebytes":{%s},' "$LBJ"

printf '"wan":{"ip":"%s","rx_rate":%s,"tx_rate":%s,"rx_bytes":%s,"tx_bytes":%s},' \
    "$(esc "$WANIP")" "$WRX" "$WTX" "$RXB" "$TXB"


# ---- uplink data usage, as dashmon accumulated it ---------------------------
# Read, never computed here: this endpoint is polled from every open tab, and a
# counter that advanced once per reader would count the same bytes many times.
# dashmon owns the arithmetic and runs once a minute; this only reports.
#
# "month" is the calendar month for a wan uplink. On a repeater or a tethered
# phone the question is a different one — how much has THIS session used — so
# the payload carries `since` instead and the client titles it accordingly.
UUKIND="$UPACT"; UUTOTAL=0; UUMONTH=""; UUSINCE=0; UUOK=false
_uu_get() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1; }
if [ "$UPACT" = "wan" ]; then
    _uf=/tmp/.uplink-month; [ -s "$_uf" ] || _uf=/etc/dashboard/uplink-month
    _t=$(_uu_get "$_uf" total); _m=$(_uu_get "$_uf" month)
    case "$_t" in ''|*[!0-9]*) ;; *) UUTOTAL=$_t; UUMONTH=$_m; UUOK=true ;; esac
elif [ "$UPACT" = "wwan" ] || [ "$UPACT" = "tethering" ]; then
    _t=$(_uu_get /tmp/.uplink-session total); _s=$(_uu_get /tmp/.uplink-session since)
    case "$_t" in ''|*[!0-9]*) ;; *) UUTOTAL=$_t; UUOK=true ;; esac
    case "$_s" in ''|*[!0-9]*) UUSINCE=0 ;; *) UUSINCE=$_s ;; esac
fi

printf '"uplink":{"active":"%s","dev":"%s"},' "$UPACT" "$(esc "$ACTDEV")"
printf '"uplink_usage":{"kind":"%s","total":%s,"month":"%s","since":%s,"ok":%s},' "$(esc "$UUKIND")" "$UUTOTAL" "$(esc "$UUMONTH")" "$UUSINCE" "$UUOK"
printf '"air":%s,"sta":%s,"neigh":%s,"oui":%s,"wired":%s,"events":%s,"nlbw":%s,' \
    "$AIRJ" "$STAJ" "$NBJ" "$OUIJ" "$WIREDJ" "$EVJ" "$NLJ"
printf '"probe":{"loss":%s,"ping":%s,"jit":%s,"state":"%s","online":%s},' \
    "$PROBE_LOSS" "$PROBE_PING" "$PROBE_JIT" "$(esc "$PROBE_STATE")" "$ONLINE"
printf '"nlbw_period":%s,"nlbw_daily":%s,"nlbw_up":%s,' \
    "$( [ -n "$NLPER" ] && printf '"%s"' "$NLPER" || echo null )" "$NLDAILY" \
    "$( [ "${NLOK:-1}" = 0 ] && echo true || echo false )"
printf '"classmap":%s,' "$CMJ"
# Tunnel counts, so the shared navigation can say the same thing on every page.
# This page previously knew only which DEVICES were routed, so its nav label and
# the VPN page's disagreed whenever tunnels were up with nothing behind them -
# which is the normal resting state on this router.
#
# "Connected" is the HANDSHAKE, not the interface: a WireGuard device stays up
# forever once configured, so counting interfaces would report tunnels that
# stopped answering hours ago. 180s matches vpnwatch and beryl-vpndns.
TUN_TOTAL=0; TUN_UP=0; _tnow=$(date +%s)
for _ti in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=interface$/\1/p'); do
    [ "$(uci -q get network.$_ti.proto 2>/dev/null)" = "wireguard" ] || continue
    TUN_TOTAL=$((TUN_TOTAL + 1))
    _ths=$(wg show "$_ti" latest-handshakes 2>/dev/null | awk 'NR==1{print $2+0}')
    case "$_ths" in ''|*[!0-9]*) _ths=0 ;; esac
    [ "$_ths" -gt 0 ] && [ $((_tnow - _ths)) -le 200 ] && TUN_UP=$((TUN_UP + 1))
done
printf '"tunnels_up":%s,"tunnels_total":%s,' "$(jnum "$TUN_UP")" "$(jnum "$TUN_TOTAL")"
printf '"vpn":%s,' "$VPNJ"
printf '"vpn_stale":%s,' "$VPNSTALE"
printf '"leases":%s,' "$LJ"
printf '"hosts":%s,' "$HH"
printf '"aps":[%s]}' "$APS"
