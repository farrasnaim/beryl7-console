#!/bin/sh
# /www/cgi-bin/repeater-api  —  travel / hotel-uplink (WISP repeater) manager.
#
# Model: one wifi-iface in mode=sta joined to an upstream AP, attached to the
# `wwan` network (proto dhcp) which lives in the firewall's wan zone. Your own
# APs keep broadcasting, so room devices reach the internet through the uplink
# with no reconfiguration.
#
# DRIVER LIMITATION (verified on this MT7990 build): scanning on the 5 GHz radio
# returns nothing while its AP is up. 2.4 GHz scanning works, and the ubus scan
# path returns 2.4 GHz results regardless of which iface is asked. Uplinks are
# therefore discovered on 2.4 GHz; a 5 GHz uplink must be entered manually.

# esc, jnum, fail, read_body, urldec, qs_get, qs_get_dec, guard_post — one copy,
# shared with every other endpoint. Tested for readability rather than sourced
# blind: busybox ash treats `.` as a special builtin, so a missing file aborts
# the script outright and an `|| fallback` after it never runs. Without the
# check the failure is a 500 with an empty body and nothing in the log.
BERYL_LIB=/usr/share/beryl/cgi-lib.sh
if [ -r "$BERYL_LIB" ]; then
    . "$BERYL_LIB"
else
    printf 'Content-Type: application/json\r\n'
    printf 'Cache-Control: no-store\r\n\r\n'
    printf '{"ok":false,"error":"missing %s - reinstall the console"}' "$BERYL_LIB"
    exit 0
fi

POST_MAX=8192

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n\r\n'

read_body

ACTION=$(qs_get action)
# Writes MUST be POST. This endpoint is passwordless, so guard_post's same-origin
# check (POST-only) is the sole protection — but a GET write bypassed it. Reads
# (status) and the non-mutating `scan` stay GET-able; everything else needs POST.
case "$ACTION" in
    ""|scan) ;;
    *) [ "$REQUEST_METHOD" = "POST" ] || { printf '{"ok":false,"error":"POST required"}'; exit 0; } ;;
esac
[ "$REQUEST_METHOD" = "POST" ] && guard_post

# ---------- connection watchdog ----------
# Associating is not the same as working: the iPhone-hotspot case associated at
# L2 but never answered DHCP, leaving the router wedged on a dead uplink with no
# feedback. So after a connect attempt, wait for wwan to actually come UP (i.e.
# hold a lease). If it doesn't inside the window, undo the attempt, fall back to
# the ethernet WAN, and leave a message for the UI to show.
TRYMARK=/tmp/.repeater-trying
FAILMARK=/tmp/.repeater-fail
CONNECT_TIMEOUT=20

# Re-assert the ethernet WAN after dropping a Wi-Fi uplink.
#
# While an uplink is up the default route points at the STA (dev phy0.x-sta0).
# `ifdown wwan` removes that route, but netifd still believes `wan` is up and so
# never reinstalls ITS default route. The router is then left holding a WAN IP,
# able to reach the ONT on-link, and with no default route at all — no internet
# for any client. Observed live; costs a couple of seconds to prevent.
# Is an Ethernet cable actually plugged into the WAN port? On the road there
# usually isn't one, which changes what "no default route" means: away from home
# it is the expected consequence of dropping the only uplink, not a fault.
wan_has_carrier() {
    _dev=$(uci -q get network.wan.device 2>/dev/null); [ -n "$_dev" ] || _dev=eth0
    [ "$(cat /sys/class/net/$_dev/carrier 2>/dev/null)" = "1" ]
}

# ---------- remembered networks ----------
# Removing an uplink deletes the wifi-iface section, and the passphrase goes
# with it — so returning to the same hotel meant typing it again from a phone
# keyboard, which is exactly when you least want to. Keep what we have joined.
#
# THIS FILE HOLDS PLAINTEXT WI-FI PASSWORDS. Same class of secret as the restore
# bundles: 0600, never in the repository, never in a paste. It is no worse than
# wireless.uplink.key, which already stores the current one in the clear — this
# just keeps the previous ones too.
#
# TAB-delimited because an SSID may contain spaces, colons and pipes; a tab is
# the one printable-ASCII byte a WPA passphrase cannot hold, and SSIDs carrying
# one are vanishingly rare. Anything with a control character is refused rather
# than silently mangled.
KNOWN=/etc/dashboard/repeater-known
KNOWN_MAX=16

known_recall() {   # $1=ssid -> prints saved key, empty if unknown
    [ -s "$KNOWN" ] || return 0
    awk -F'\t' -v s="$1" '$1==s {print $3; exit}' "$KNOWN" 2>/dev/null
}
known_enc() {      # $1=ssid -> prints saved encryption
    [ -s "$KNOWN" ] || return 0
    awk -F'\t' -v s="$1" '$1==s {print $2; exit}' "$KNOWN" 2>/dev/null
}
known_forget() {   # $1=ssid
    [ -s "$KNOWN" ] || return 0
    awk -F'\t' -v s="$1" '$1!=s' "$KNOWN" > "$KNOWN.n" 2>/dev/null && mv "$KNOWN.n" "$KNOWN"
    chmod 600 "$KNOWN" 2>/dev/null
}
known_remember() { # $1=ssid $2=enc $3=key
    case "$1$3" in *"$(printf '\t')"*|*"$(printf '\r')"*) return 0 ;; esac
    [ -n "$1" ] || return 0
    mkdir -p "$(dirname "$KNOWN")"
    [ -f "$KNOWN" ] || { : > "$KNOWN"; chmod 600 "$KNOWN"; }
    # Newest first, one entry per SSID, oldest beyond the cap dropped. Rewriting
    # rather than appending keeps a re-join from stacking duplicates.
    { printf '%s\t%s\t%s\n' "$1" "$2" "$3"
      awk -F'\t' -v s="$1" '$1!=s' "$KNOWN" 2>/dev/null
    } | head -n "$KNOWN_MAX" > "$KNOWN.n" 2>/dev/null && mv "$KNOWN.n" "$KNOWN"
    chmod 600 "$KNOWN" 2>/dev/null
}
known_json() {     # ssids only — the keys never leave the router
    [ -s "$KNOWN" ] || { printf '[]'; return 0; }
    awk -F'\t' '{ s=$1; gsub(/\\/,"\\\\",s); gsub(/"/,"\\\"",s)
                  printf "%s\"%s\"", (NR>1?",":""), s }
                END{ }' "$KNOWN" 2>/dev/null | sed 's/^/[/; s/$/]/'
}

# `wifi reload` with no argument restarts EVERY radio, not just the one the
# uplink lives on. Joining a 5 GHz uplink therefore knocked every 2.4 GHz client
# off as well, and vice versa — measured during a travel rehearsal, where the
# iPad and the PC being used to drive the join both dropped at the moment of
# joining, on a band the uplink was not even using. settings-api has always
# scoped its reloads; this file never did.
#
# Falls back to reloading everything when the radio cannot be determined, which
# is the old behaviour and still correct, just broader than necessary.
reload_uplink_radio() {
    _r="${1:-$(uci -q get wireless.uplink.device 2>/dev/null)}"
    if [ -n "$_r" ]; then wifi reload "$_r"; else wifi reload; fi
}

restore_wan() {
    ip route show default 2>/dev/null | grep -q . && return 0
    # No cable => nothing to fall back to. Don't spend 10s retrying or log a
    # scary warning for a situation that is simply "you're travelling".
    wan_has_carrier || { logger -t repeater "uplink down and no Ethernet carrier — offline until another uplink is joined"; return 1; }
    ifup wan >/dev/null 2>&1
    _w=0
    while [ "$_w" -lt 10 ]; do
        ip route show default 2>/dev/null | grep -q . && return 0
        _w=$((_w+1)); sleep 1
    done
    logger -t repeater "WARNING: Ethernet is connected but no default route after uplink teardown"
    return 1
}

uplink_watchdog() {
    _ssid="$1"
    _i=0
    while [ "$_i" -lt "$CONNECT_TIMEOUT" ]; do
        if ubus call network.interface.wwan status 2>/dev/null | grep -q '"up": true'; then
            rm -f "$TRYMARK" "$FAILMARK"
            # Remember only what actually carried traffic. Saving at request
            # time would fill the store with passphrases that were mistyped —
            # a wrong one never reaches here, because association without a
            # lease is what this watchdog exists to catch.
            known_remember "$(uci -q get wireless.uplink.ssid)" \
                           "$(uci -q get wireless.uplink.encryption)" \
                           "$(uci -q get wireless.uplink.key)"
            return 0
        fi
        _i=$((_i+1)); sleep 1
    done
    # timed out — roll back so we are not left on a half-open uplink
    ifdown wwan >/dev/null 2>&1
    uci set wireless.uplink.disabled='1'
    uci commit wireless
    reload_uplink_radio >/dev/null 2>&1
    restore_wan
    rm -f "$TRYMARK"
    # Tailor the message to where you actually are. Telling someone in a hotel
    # that it "reverted to the Ethernet WAN" is useless — there is no cable.
    if wan_has_carrier; then
        printf 'Could not connect to “%s” within %ss. It associated but never got an IP address, or the password was rejected. Reverted to the Ethernet WAN — check the password and signal, then try again.' \
            "$_ssid" "$CONNECT_TIMEOUT" > "$FAILMARK"
    else
        printf 'Could not connect to “%s” within %ss. It associated but never got an IP address, or the password was rejected. No Ethernet is connected, so the router is offline until an uplink joins — double-check the password (watch for a captive portal that needs a browser sign-in) and try again.' \
            "$_ssid" "$CONNECT_TIMEOUT" > "$FAILMARK"
    fi
    logger -t repeater "uplink '$_ssid' failed within ${CONNECT_TIMEOUT}s; reverted"
}

ensure_wwan() {
    # wwan interface (dhcp client on the uplink)
    if [ -z "$(uci -q get network.wwan)" ]; then
        uci set network.wwan=interface
        uci set network.wwan.proto='dhcp'
        uci commit network
    fi
    # put wwan in the wan firewall zone so it's treated as untrusted + masqueraded
    for z in $(uci -q show firewall | sed -n 's/^firewall\.\(@zone\[[0-9]*\]\)\.name=.wan.$/\1/p'); do
        cur=$(uci -q get firewall.$z.network)
        case " $cur " in *" wwan "*) ;; *) uci add_list firewall.$z.network='wwan'; uci commit firewall ;; esac
    done
}

# ============================ SCAN ============================
# Uses `iw ... scan` directly, NOT iwinfo/ubus-iwinfo.
#
# Why: this is a Wi-Fi 7 multi-radio-single-PHY device (radio0 + radio1 both on
# phy0). iwinfo cannot scope a scan to radio 1 — `iwinfo <5g-iface> scan` dies
# with "Netlink error ... No event received", and `ubus call iwinfo scan` on the
# 5 GHz iface silently returns the 2.4 GHz radio's results (every entry band=2).
# Verified side by side: iw saw 11 genuine 5 GHz APs on the same interface where
# iwinfo saw none. Most hotel APs are 5 GHz, so this matters.
if [ "$ACTION" = "scan" ]; then
    # One AP interface per band, so both bands get scanned. Found by the
    # frequency each interface is running on rather than by section name —
    # main2g/main5g are this vendor's labels, not OpenWrt's.
    IF24=$(iw dev 2>/dev/null | awk '
        /^\tInterface / { ifc=$2 }
        /^\t\tchannel / { f=$3; sub(/\(/,"",f); if (f+0 < 3000) { print ifc; exit } }')
    IF5=$(iw dev 2>/dev/null | awk '
        /^\tInterface / { ifc=$2 }
        /^\t\tchannel / { f=$3; sub(/\(/,"",f); if (f+0 >= 3000) { print ifc; exit } }')

    # ONE ACTIVE SWEEP PER RADIO — not one for the whole PHY.
    #
    # This used to issue a single sweep from the 5 GHz interface, on the theory
    # that both radios share phy0 so one scan covers every channel in both bands.
    # That is not how this hardware behaves. Each radio is a separate scan domain
    # (`#channels <= 1` per radio in the wiphy's interface combinations), so a
    # sweep started on the 5 GHz vif only sweeps 5 GHz. Measured, flushed cache,
    # three alternating rounds:
    #
    #     sweep from 5 GHz vif  ->  2.4 GHz networks found: 3, 2, 2
    #     sweep from 2.4 GHz vif ->  2.4 GHz networks found: 10, 9, 8
    #
    # The 2.4 GHz half of the list was therefore whatever happened to be left in
    # the cached `scan dump` — often nothing. A 2.4 GHz-only AP could be missing
    # from the page entirely, which is precisely the hotel/travel case this
    # feature exists for. Found when the router could not see an ONT's 2.4 GHz
    # SSID that every phone in the room could.
    #
    # The old comment warned that a second sweep collides with "Resource busy
    # (-16)". That happens when two scans are in flight at once; these are
    # sequential and `iw ... scan` blocks until its results are ready, so the
    # second starts after the first has finished. Re-measured: 3/3 trials, both
    # sweeps rc=0, no busy error. The cost is one extra sweep's latency on a
    # button the user pressed deliberately.
    #
    # `scan dump` (the driver's cached table) is still folded in afterwards: it
    # costs nothing, can't fail, and means a click that lands while another scan
    # is in flight still returns results. Duplicates are removed below.
    ALL=$( { [ -n "$IF5" ]  && iw dev "$IF5"  scan 2>/dev/null
             [ -n "$IF24" ] && iw dev "$IF24" scan 2>/dev/null
             [ -n "$IF5" ]  && iw dev "$IF5"  scan dump 2>/dev/null
             [ -n "$IF24" ] && iw dev "$IF24" scan dump 2>/dev/null; } | awk '
        BEGIN { for (i=0; i<16; i++) { h=sprintf("%X",i); HX[h]=i; HX[tolower(h)]=i } }
        # iw prints any non-ASCII SSID byte as the LITERAL text \xNN (an iPhone
        # hotspot named "Alex’s iPhone" arrives as Alex\xe2\x80\x99s iPhone).
        # \x is not a valid JSON escape, so passing it through made the whole
        # response unparseable and the UI reported "Scan failed". Turn those
        # sequences back into the real bytes.
        function unhex(s,   out,i,n,c,a,b) {
            out=""; n=length(s)
            for (i=1; i<=n; i++) {
                c=substr(s,i,1)
                if (c=="\\" && substr(s,i+1,1)=="x" && i+3<=n) {
                    a=substr(s,i+2,1); b=substr(s,i+3,1)
                    if ((a in HX) && (b in HX)) {
                        out = out sprintf("%c", HX[a]*16 + HX[b]); i+=3; continue
                    }
                }
                out = out c
            }
            return out
        }
        # Escape by walking the string. gsub is deliberately NOT used: its
        # replacement text treats backslashes specially, so the usual
        # gsub(/\\/,"\\\\") is a silent no-op and leaves JSON broken.
        function jesc(s,   out,i,n,c) {
            out=""; n=length(s)
            for (i=1; i<=n; i++) {
                c=substr(s,i,1)
                if (c=="\\")      out = out "\\\\"
                else if (c=="\"") out = out "\\\""
                else if (c < " ") continue
                else              out = out c
            }
            return out
        }
        function flush_bss() {
            if (bssid == "") return
            if (ssid == "") ssid = "(hidden)"
            if (!(bssid in seen) || sig > bsig[bssid]) {
                seen[bssid]=1; bsig[bssid]=sig; bss[bssid]=ssid
                bfreq[bssid]=freq; benc[bssid]=enc
            }
            bssid=""; ssid=""; freq=0; sig=0; enc=0
        }
        /^BSS / { flush_bss(); bssid=$2; sub(/\(.*/, "", bssid); next }
        /^\tfreq:/    { freq = $2 + 0; next }
        /^\tsignal:/  { sig  = $2 + 0; next }
        /^\tSSID:/    { s=$0; sub(/^\tSSID: ?/, "", s); ssid=s; next }
        /^\tRSN:/     { enc=1; next }
        /^\tWPA:/     { enc=1; next }
        /capability:.*Privacy/ { enc=1; next }
        END {
            flush_bss()
            n=0
            for (b in seen) {
                f=bfreq[b]; s=bss[b]
                ch = 0
                if (f >= 4900) ch = int((f - 5000) / 5)
                else if (f == 2484) ch = 14
                else if (f >= 2400) ch = int((f - 2407) / 5)
                q = int((bsig[b] + 100) * 2); if (q < 0) q = 0; if (q > 100) q = 100
                s = jesc(unhex(s))
                printf "%s{\"ssid\":\"%s\",\"bssid\":\"%s\",\"channel\":%d,\"mhz\":%d,\"signal\":%d,\"quality\":%d,\"quality_max\":100,\"encryption\":{\"enabled\":%s}}",
                       (n++ ? "," : ""), s, b, ch, f, bsig[b], q, (benc[b] ? "true" : "false")
            }
        }')

    printf '{"ok":true,"iface24":"%s","iface5":"%s","scan":{"results":[%s]}}' \
        "$(esc "$IF24")" "$(esc "$IF5")" "$ALL"
    exit 0
fi

# Which radio serves a band. This board enumerates radio0=2.4 GHz and
# radio1=5 GHz, but that ordering is a board convention, not a rule — plenty of
# hardware enumerates 5 GHz first, and there the name-based guess silently
# builds the STA on the wrong radio: the join just fails, with nothing in the UI
# to say why. Ask each radio what band it declares instead. Falling back to the
# first radio keeps a single-band board working rather than refusing outright.
# Kept byte-identical to the copy in dashboard-api: two copies that drift are a
# new bug, so change both or neither.
radio_for_band() {   # $1 = 2g | 5g | 6g
    _first=""; _any=""
    for _r in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
        [ -n "$_first" ] || _first="$_r"
        _b=$(uci -q get wireless.$_r.band 2>/dev/null)
        [ -n "$_b" ] && _any=1
        [ "$_b" = "$1" ] && { printf '%s' "$_r"; return 0; }
    done
    # No match. Where the radios declare bands, the honest answer is "there is
    # no such radio" — returning an unrelated one turns "restart 6 GHz" into
    # "restart 2.4 GHz". Only a config that names no bands at all (the old
    # hwmode style) falls back to the first radio.
    [ -n "$_any" ] || printf '%s' "$_first"
}

# ============================ ADD UPLINK ============================
if [ "$ACTION" = "add" ]; then
    # No router password anywhere in this console, by explicit user choice:
    # joining an uplink is a travel convenience and an admin prompt is friction for no
    # gain. guard_post still enforces the origin check, and guest/iot are
    # input=REJECT so this endpoint is only reachable from the trusted LAN.
    SSID=$(qs_get_dec ssid)
    KEY=$(qs_get_dec key)
    ENC=$(qs_get enc)
    BAND=$(qs_get band)
    [ -n "$SSID" ] || { printf '{"ok":false,"error":"ssid required"}'; exit 0; }
    case "$BAND" in 5) RADIO=$(radio_for_band 5g) ;; 6) RADIO=$(radio_for_band 6g) ;; *) RADIO=$(radio_for_band 2g) ;; esac
    [ -n "$RADIO" ] || { printf '{"ok":false,"error":"no radio available"}'; exit 0; }
    # No password typed? If we have joined this network before, use what we
    # already know. This is the whole point of remembering: arriving back at a
    # place you have stayed should be one tap, not a passphrase typed on a
    # phone. An explicitly supplied key always wins, so correcting a changed
    # password still works.
    USED_SAVED=false
    if [ -z "$KEY" ]; then
        SAVED_KEY=$(known_recall "$SSID")
        if [ -n "$SAVED_KEY" ]; then
            KEY="$SAVED_KEY"
            USED_SAVED=true
            [ -n "$ENC" ] || ENC=$(known_enc "$SSID")
        fi
    fi
    case "$ENC" in
        none) ENCV='none' ;;
        psk|psk2) ENCV='psk2' ;;
        *)    ENCV=$([ -n "$KEY" ] && echo 'psk2' || echo 'none') ;;
    esac
    [ "$ENCV" != "none" ] && [ -z "$KEY" ] && { printf '{"ok":false,"error":"password required for encrypted network"}'; exit 0; }

    ensure_wwan
    # a single uplink section, replaced each time
    uci -q delete wireless.uplink
    uci set wireless.uplink=wifi-iface
    uci set wireless.uplink.device="$RADIO"
    uci set wireless.uplink.mode='sta'
    uci set wireless.uplink.network='wwan'
    uci set wireless.uplink.ssid="$SSID"
    uci set wireless.uplink.encryption="$ENCV"
    [ "$ENCV" != "none" ] && uci set wireless.uplink.key="$KEY"
    uci set wireless.uplink.disabled='0'
    uci commit wireless
    # `wifi reload` alone is NOT enough: after a failed association netifd marks
    # wwan disabled and never retries, so the STA interface is never recreated
    # and the uplink silently stays dead. An explicit ifup after the radios
    # settle is what actually revives it.
    date +%s > "$TRYMARK"; rm -f "$FAILMARK"
    ( reload_uplink_radio "$RADIO" >/dev/null 2>&1; sleep 8; ifup wwan >/dev/null 2>&1
      uplink_watchdog "$SSID" ) >/dev/null 2>&1 &
    printf '{"ok":true,"action":"add","ssid":"%s","radio":"%s","encryption":"%s","timeout":%s,"used_saved":%s}' \
        "$(esc "$SSID")" "$RADIO" "$ENCV" "$CONNECT_TIMEOUT" "$USED_SAVED"
    exit 0
fi

# ============================ REMOVE UPLINK ============================
if [ "$ACTION" = "del" ]; then
    # Also unauthenticated: removing an uplink just falls back to the ethernet
    # WAN, and re-adding it is a two-click operation.
    [ -n "$(uci -q get wireless.uplink)" ] || { printf '{"ok":false,"error":"no uplink configured"}'; exit 0; }
    # Read the radio before deleting the section that names it.
    URADIO=$(uci -q get wireless.uplink.device)
    uci -q delete wireless.uplink
    uci commit wireless
    ifdown wwan >/dev/null 2>&1
    rm -f "$TRYMARK" "$FAILMARK"
    ( reload_uplink_radio "$URADIO" >/dev/null 2>&1; restore_wan ) >/dev/null 2>&1 &
    printf '{"ok":true,"action":"del"}'
    exit 0
fi

# ============================ FORGET A SAVED NETWORK ============================
# Separate from `del`: dropping the uplink you are on is a routing decision,
# forgetting a password is a privacy one, and someone handing the router to a
# friend wants the second without the first.
if [ "$ACTION" = "forget" ]; then
    F_SSID=$(qs_get_dec ssid)
    [ -n "$F_SSID" ] || { printf '{"ok":false,"error":"ssid required"}'; exit 0; }
    known_forget "$F_SSID"
    printf '{"ok":true,"action":"forget","ssid":"%s","known":%s}' "$(esc "$F_SSID")" "$(known_json)"
    exit 0
fi

# dismiss a stale failure notice from the UI
if [ "$ACTION" = "clearerr" ]; then
    rm -f "$FAILMARK"
    printf '{"ok":true,"action":"clearerr"}'
    exit 0
fi

# ============================ ENABLE / DISABLE ============================
if [ "$ACTION" = "up" ] || [ "$ACTION" = "down" ]; then
    [ -n "$(uci -q get wireless.uplink)" ] || { printf '{"ok":false,"error":"no uplink configured"}'; exit 0; }
    [ "$ACTION" = "up" ] && uci set wireless.uplink.disabled='0' || uci set wireless.uplink.disabled='1'
    uci commit wireless
    if [ "$ACTION" = "down" ]; then
        ifdown wwan >/dev/null 2>&1
        rm -f "$TRYMARK" "$FAILMARK"
        ( reload_uplink_radio >/dev/null 2>&1; restore_wan ) >/dev/null 2>&1 &
    else
        # see the note in `add`: netifd will not re-create the STA on its own
        date +%s > "$TRYMARK"; rm -f "$FAILMARK"
        ( reload_uplink_radio >/dev/null 2>&1; sleep 8; ifup wwan >/dev/null 2>&1
          uplink_watchdog "$(uci -q get wireless.uplink.ssid)" ) >/dev/null 2>&1 &
    fi
    printf '{"ok":true,"action":"%s"}' "$ACTION"
    exit 0
fi

# ============================ STATUS (read) ============================
U_SSID=$(uci -q get wireless.uplink.ssid)
U_RADIO=$(uci -q get wireless.uplink.device)
# Send the band itself, not just the radio name. The UI used to infer "5 GHz"
# from the name radio1, which is the same wrong assumption radio_for_band()
# exists to remove.
U_BAND=$([ -n "$U_RADIO" ] && uci -q get wireless.$U_RADIO.band 2>/dev/null)
U_ENC=$(uci -q get wireless.uplink.encryption)
U_DIS=$(uci -q get wireless.uplink.disabled); [ -n "$U_DIS" ] || U_DIS=0

# runtime sta iface
STAIF=$(ubus call network.wireless status 2>/dev/null | awk '
    /"section":/ { gsub(/[",]/,""); s=$2 }
    /"ifname":/  { gsub(/[",]/,""); if (s=="uplink") { print $2; exit } }')

CONN=false; SIG=0; UPSSID=""; BSSID=""; QUAL=0
if [ -n "$STAIF" ]; then
    INFO=$(ubus call iwinfo info "{\"device\":\"$STAIF\"}" 2>/dev/null)
    UPSSID=$(printf '%s' "$INFO" | awk -F'"' '/"ssid":/{print $4; exit}')
    BSSID=$(printf '%s' "$INFO" | awk -F'"' '/"bssid":/{print $4; exit}')
    SIG=$(printf '%s' "$INFO" | awk -F'[:,]' '/"signal":/{gsub(/ /,"",$2); print $2; exit}')
    QUAL=$(printf '%s' "$INFO" | awk -F'[:,]' '/"quality":/{gsub(/ /,"",$2); print $2; exit}')
    case "$SIG" in ''|*[!0-9-]*) SIG=0 ;; esac
    case "$QUAL" in ''|*[!0-9-]*) QUAL=0 ;; esac
    # iwinfo's "bssid" is this interface's OWN MAC on this mt76 build — the
    # router's STA address, not the access point it joined. Reporting that puts
    # the router's own identity in the UI exactly where the uplink's belongs,
    # which is worse than showing nothing: it looks like a real answer. `iw dev
    # <sta> link` names the AP correctly, so prefer it and keep iwinfo only for
    # drivers where iw carries no link line.
    _lb=$(iw dev "$STAIF" link 2>/dev/null | awk '/^Connected to /{print toupper($3); exit}')
    [ -n "$_lb" ] && BSSID="$_lb"
    [ -n "$UPSSID" ] && [ "$BSSID" != "00:00:00:00:00:00" ] && CONN=true
fi

WIP=$(ubus call network.interface.wwan status 2>/dev/null | awk -F'"' '/"address":/{print $4; exit}')
WUP=$(ubus call network.interface.wwan status 2>/dev/null | grep -c '"up": true')
[ "$WUP" -gt 0 ] 2>/dev/null && WUPJ=true || WUPJ=false

# is the ethernet WAN currently the active default route?
DEFDEV=$(ip route show default 2>/dev/null | awk '{print $5; exit}')

printf '{"ok":true,"ts":%s,' "$(date +%s)"
printf '"uplink":{"configured":%s,"ssid":"%s","radio":"%s","band":"%s","encryption":"%s","enabled":%s,' \
    "$( [ -n "$U_SSID" ] && echo true || echo false )" \
    "$(esc "$U_SSID")" "$(esc "$U_RADIO")" "$(esc "$U_BAND")" "$(esc "$U_ENC")" \
    "$( [ "$U_DIS" = "1" ] && echo false || echo true )"
printf '"connected":%s,"assoc_ssid":"%s","bssid":"%s","signal":%s,"quality":%s},' \
    "$CONN" "$(esc "$UPSSID")" "$(esc "$BSSID")" "${SIG:-0}" "${QUAL:-0}"
printf '"wwan":{"up":%s,"ip":"%s"},' "$WUPJ" "$(esc "$WIP")"
printf '"default_route_dev":"%s",' "$(esc "$DEFDEV")"
# Surface a missing default route instead of leaving the user to discover it as
# "no internet". This is the exact state a teardown used to leave behind.
printf '"has_default_route":%s,' "$( [ -n "$DEFDEV" ] && echo true || echo false )"
printf '"wan_carrier":%s,' "$(wan_has_carrier && echo true || echo false)"

# ---- the three internet sources, in the same shape tethering-api emits ----
# Failover order is a property of BOTH uplink pages (it decides which of them
# wins), so this page serves the same panel rather than sending the user to the
# other one. Same field names on purpose: one renderer draws both.
# One ubus call per interface, not two: the status blob carries both the l3
# device and the up flag, so ask once and parse it twice.
_st_wan=$(ubus call network.interface.wan status 2>/dev/null)
_st_wwan=$(ubus call network.interface.wwan status 2>/dev/null)
_st_teth=$(ubus call network.interface.tethering status 2>/dev/null)
_l3() { printf '%s' "$1" | awk -F'"' '/"l3_device"/{print $4; exit}'; }
_wan_dev=$(_l3 "$_st_wan"); _wwan_dev=$(_l3 "$_st_wwan"); _teth_dev=$(_l3 "$_st_teth")
R_ACTIVE="none"
case "$DEFDEV" in
    "") ;;
    "$_wan_dev")  [ -n "$_wan_dev" ]  && R_ACTIVE="wan" ;;
    "$_wwan_dev") [ -n "$_wwan_dev" ] && R_ACTIVE="wwan" ;;
    "$_teth_dev") [ -n "$_teth_dev" ] && R_ACTIVE="tethering" ;;
esac
iface_json_r() {   # $1=uci name  $2=label  $3=l3 device  $4=status blob
    _u="$4"
    _up=$(printf '%s' "$_u" | awk -F: '/"up"/{gsub(/[ ,\t]/,"",$2); print $2; exit}')
    _ip=""; [ -n "$3" ] && _ip=$(ip -4 -o addr show dev "$3" 2>/dev/null | awk '{split($4,x,"/"); print x[1]; exit}')
    _m=$(uci -q get "network.$1.metric")
    printf '{"name":"%s","label":"%s","up":%s,"device":"%s","ip":"%s","metric":%s,"active":%s}' \
        "$1" "$(esc "$2")" "$(jbool "$_up")" "$(esc "$3")" "$(esc "$_ip")" \
        "$(jnum "$_m")" "$([ "$R_ACTIVE" = "$1" ] && echo true || echo false)"
}
printf '"active":"%s",' "$R_ACTIVE"
printf '"uplinks":[%s,%s,%s],' \
    "$(iface_json_r wan 'Ethernet' "$_wan_dev" "$_st_wan")" \
    "$(iface_json_r tethering 'USB' "$_teth_dev" "$_st_teth")" \
    "$(iface_json_r wwan 'Wi-Fi' "$_wwan_dev" "$_st_wwan")"
# connect-attempt state. A stale TRYMARK (watchdog killed, reboot mid-attempt)
# is ignored after timeout+15s so the UI can't get stuck on "Connecting…".
CONNECTING=false
if [ -f "$TRYMARK" ]; then
    _t=$(cat "$TRYMARK" 2>/dev/null); case "$_t" in ''|*[!0-9]*) _t=0 ;; esac
    _age=$(( $(date +%s) - _t ))
    [ "$_age" -lt $((CONNECT_TIMEOUT + 15)) ] && CONNECTING=true || rm -f "$TRYMARK"
fi
LASTERR=""
[ -f "$FAILMARK" ] && LASTERR=$(cat "$FAILMARK" 2>/dev/null)
printf '"connecting":%s,"connect_timeout":%s,"last_error":"%s",' \
    "$CONNECTING" "$CONNECT_TIMEOUT" "$(esc "$LASTERR")"
# The secondary SSID, if this router has one: the first AP that is not on the
# primary network. Auto-managed with the uplink — see the hotplug script at
# /etc/hotplug.d/iface/99-repeater-iot. Emits null where there is none.
IOTSEC=""
for _s in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
    _m=$(uci -q get wireless.$_s.mode 2>/dev/null)
    [ -z "$_m" ] || [ "$_m" = "ap" ] || continue
    _n=$(uci -q get wireless.$_s.network 2>/dev/null)
    [ -n "$_n" ] && [ "$_n" != "lan" ] && { IOTSEC="$_s"; break; }
done
if [ -n "$IOTSEC" ]; then
    IOTDIS=$(uci -q get wireless.$IOTSEC.disabled); [ -n "$IOTDIS" ] || IOTDIS=0
    printf '"iot_ssid":{"name":"%s","enabled":%s},' \
        "$(esc "$(uci -q get wireless.$IOTSEC.ssid)")" \
        "$( [ "$IOTDIS" = "1" ] && echo false || echo true )"
else
    printf '"iot_ssid":null,'
fi
# Has 33-uplink-width narrowed a radio to fit the uplink's channel? While you are
# travelling that is the necessary trade and needs no comment. Once a better
# uplink is carrying and this is STILL set, the owner is at home running half
# their 5 GHz with nothing on screen to say why — and the cause (a saved uplink
# that rejoins itself on every boot) is not something anyone would guess.
WSTATE=/etc/dashboard/uplink-width-orig
if [ -s "$WSTATE" ]; then
    read -r _wr _wh < "$WSTATE" 2>/dev/null
    printf '"width":{"radio":"%s","original":"%s","current":"%s","band":"%s"},' \
        "$(esc "$_wr")" "$(esc "$_wh")" \
        "$(esc "$(uci -q get wireless.$_wr.htmode)")" \
        "$(esc "$(uci -q get wireless.$_wr.band)")"
else
    printf '"width":null,'
fi
printf '"known":%s,' "$(known_json)"
printf '"scan_note":"Scans both bands via iw (iwinfo cannot scope a scan to the 5 GHz radio on this multi-radio PHY)."'
printf '}'
