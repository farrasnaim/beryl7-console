#!/bin/sh
# /www/cgi-bin/tools-api  —  the four things the control grid needed that no
# existing endpoint answered: the activity feed, a speed test, the guest QR
# payload, and the travel-mode flag.
#
# READ-ONLY EXCEPT WHERE SAID. `activity` and `guestqr` read; `speedtest`
# downloads and writes one small file in /tmp; `travel` writes one config file
# in /etc/dashboard. Nothing here touches wireless, firewall, services or uci
# state: travel mode's switching of networks and routing is done by the page
# through the endpoints that already own those actions (settings-api,
# vpn-api), so no new reload path exists on the router because of this file.

BERYL_LIB=/usr/share/beryl/cgi-lib.sh
if [ -r "$BERYL_LIB" ]; then
    . "$BERYL_LIB"
else
    printf 'Content-Type: application/json\r\n'
    printf 'Cache-Control: no-store\r\n\r\n'
    printf '{"ok":false,"error":"missing %s - reinstall the console"}' "$BERYL_LIB"
    exit 0
fi

CLASSMAP=/etc/dashboard/classmap
LEASES=/tmp/dhcp.leases
TRAVELCONF=/etc/dashboard/travel.conf
SPEEDLAST=/tmp/.speedlast
SPEEDLOCK=/tmp/.speedtest.lock

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n\r\n'

read_body
ACTION=$(qs_get action)
case "$ACTION" in
    ""|activity|guestqr|travel|speedprog) ;;
    *) [ "$REQUEST_METHOD" = "POST" ] || fail "POST required" ;;
esac
[ "$REQUEST_METHOD" = "POST" ] && guard_post

# ---------------------------------------------------------------- travel --
# The flag and what was true before it was set, so switching off can put
# things back. Parsed, never sourced.
travel_json() {
    TRAVEL_ON=0; TRAVEL_SINCE=0; TRAVEL_GUEST_WAS=""; TRAVEL_IOT_WAS=""; TRAVEL_VPN_WAS=""
    conf_load "$TRAVELCONF" >/dev/null 2>&1
    case "$TRAVEL_ON" in 1) _ton=true ;; *) _ton=false ;; esac
    printf '{"on":%s,"since":%s,"guest_was":"%s","iot_was":"%s","vpn_was":"%s"}' \
        "$_ton" "$(jnum "$TRAVEL_SINCE")" "$(esc "$TRAVEL_GUEST_WAS")" "$(esc "$TRAVEL_IOT_WAS")" "$(esc "$TRAVEL_VPN_WAS")"
}
if [ "$ACTION" = "travel" ] && [ "$REQUEST_METHOD" = "POST" ]; then
    TON=$(qs_get on)
    case "$TON" in 0|1) ;; *) fail "on must be 0 or 1" ;; esac
    GW=$(qs_get guest_was | tr -cd '01'); IW=$(qs_get iot_was | tr -cd '01'); VW=$(qs_get vpn_was | tr -cd '01')
    if [ "$TON" = "1" ]; then
        _since=$(date +%s)
    else
        _since=0; GW=""; IW=""; VW=""
    fi
    _new=$(printf 'TRAVEL_ON=%s\nTRAVEL_SINCE=%s\nTRAVEL_GUEST_WAS=%s\nTRAVEL_IOT_WAS=%s\nTRAVEL_VPN_WAS=%s\nX' "$TON" "$_since" "$GW" "$IW" "$VW")
    _new=${_new%X}
    mkdir -p /etc/dashboard
    rm -f "$TRAVELCONF.tmp"
    printf '%s' "$_new" > "$TRAVELCONF.tmp" 2>/dev/null || { rm -f "$TRAVELCONF.tmp"; fail "could not write $TRAVELCONF"; }
    _w=$(wc -c < "$TRAVELCONF.tmp"); _w=${_w##* }
    [ "$_w" = "${#_new}" ] || { rm -f "$TRAVELCONF.tmp"; fail "could not write $TRAVELCONF"; }
    mv -f "$TRAVELCONF.tmp" "$TRAVELCONF" || fail "could not write $TRAVELCONF"
    logger -t tools "travel mode $([ "$TON" = 1 ] && echo on || echo off) via web UI"
    printf '{"ok":true,"travel":%s}' "$(travel_json)"
    exit 0
fi
if [ "$ACTION" = "travel" ]; then
    printf '{"ok":true,"travel":%s}' "$(travel_json)"
    exit 0
fi

# ------------------------------------------------------------- speedprog --
if [ "$ACTION" = "speedprog" ]; then
    if [ -f /tmp/.speedtest.lock ] && [ -r /tmp/.speedprog ]; then cat /tmp/.speedprog; else printf '{"ok":true,"phase":"idle"}'; fi
    exit 0
fi

# --------------------------------------------------------------- guestqr --
# The string a phone camera understands, plus the parts for the page to show.
# The passphrase leaves the router here, to anyone on the main network with
# no login — which is the console's stated boundary, and the same person can
# read it in LuCI. Guest and IoT zones cannot reach this endpoint at all.
if [ "$ACTION" = "guestqr" ]; then
    _sid=""; _key=""; _enc=""; _dis=1
    for _s in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
        [ "$(uci -q get wireless.$_s.network)" = "guest" ] || continue
        _sid=$(uci -q get wireless.$_s.ssid); _key=$(uci -q get wireless.$_s.key)
        _enc=$(uci -q get wireless.$_s.encryption); _dis=$(uci -q get wireless.$_s.disabled); _dis=${_dis:-0}
        break
    done
    [ -n "$_sid" ] || { printf '{"ok":true,"present":false}'; exit 0; }
    case "$_enc" in none|owe*) _t="nopass" ;; *) _t="WPA" ;; esac
    # WIFI: escapes \ ; , " : with a backslash
    _qesc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/;/\\;/g; s/,/\\,/g; s/"/\\"/g; s/:/\\:/g'; }
    _wifi="WIFI:T:$_t;S:$(_qesc "$_sid");"
    [ "$_t" = "nopass" ] || _wifi="${_wifi}P:$(_qesc "$_key");"
    _wifi="${_wifi};"
    printf '{"ok":true,"present":true,"enabled":%s,"ssid":"%s","key":"%s","wifi":"%s"}' \
        "$([ "$_dis" = 1 ] && echo false || echo true)" "$(esc "$_sid")" "$(esc "$_key")" "$(esc "$_wifi")"
    exit 0
fi

# ------------------------------------------------------------- speedtest --
# What fast.com does, run from the router. DOWN: four parallel streams against
# Cloudflare's speed endpoint, each a loop of 25 MB requests (the endpoint
# returns 403 above some size — 100 MB was refused, 25 MB is what worked), the
# throughput read off the uplink's own byte counters once a second, the first
# two seconds (TCP ramp) dropped, the rest averaged. Counters rather than the
# fetcher's own figure, so the streams need no cooperation and are simply
# killed when the window closes. Everything through the uplink counts — a
# client streaming during the test inflates it, and the page says so.
# UP: iperf3, four streams, ten seconds, first two omitted, to the first public
# iperf3 server that is not busy. Not an HTTP POST because OpenWrt's wget is
# uclient-fetch, whose POST path measured 2.4 Mbit/s over plain HTTP and 0.3
# over TLS on this router while iperf3 pushed 70 — the tool, not the line.
# Progress is written to /tmp for the page to poll while it runs.
SPEEDPROG=/tmp/.speedprog
UPSERVERS="iperf.he.net:5201 ping.online.net:5202 ping.online.net:5206 speedtest.wtnet.de:5203 speedtest.wtnet.de:5207 speedtest.uztelecom.uz:5201"
if [ "$ACTION" = "speedtest" ]; then
    DUR=$(qs_get seconds); case "$DUR" in ''|*[!0-9]*) DUR=10 ;; esac; { [ "$DUR" -ge 5 ] && [ "$DUR" -le 15 ]; } || DUR=10
    NS=$(qs_get streams); case "$NS" in ''|*[!0-9]*) NS=4 ;; esac; { [ "$NS" -ge 2 ] && [ "$NS" -le 6 ]; } || NS=4
    if [ -f "$SPEEDLOCK" ]; then
        _lp=$(cat "$SPEEDLOCK" 2>/dev/null)
        if [ -n "$_lp" ] && [ -d "/proc/$_lp" ]; then fail "a test is already running"; fi
    fi
    printf '%s' "$$" > "$SPEEDLOCK"
    DEV=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
    if [ -z "$DEV" ] || [ ! -r "/sys/class/net/$DEV/statistics/rx_bytes" ]; then
        rm -f "$SPEEDLOCK"; fail "no default route — is the internet reachable?"
    fi
    _prog() {
        printf '{"ok":true,"phase":"%s","mbps":%s,"t":%s,"of":%s,"via":"%s"}' "$1" "$2" "$3" "$DUR" "$(esc "$4")" > "$SPEEDPROG.tmp" && mv -f "$SPEEDPROG.tmp" "$SPEEDPROG"
    }
    # mean of the samples after the two-second ramp, and the peak: "<mean> <peak>"
    _stats() { printf '%s\n' "$@" | awk '{v[NR]=$1; if($1>p)p=$1} END{st=(NR>2)?3:1; for(i=st;i<=NR;i++){s+=v[i];n++} printf "%.1f %.1f",(n?s/n:0),p+0}'; }

    # ---- down: N looping streams, sampled on rx_bytes, then killed (loop and fetcher both)
    _prog down 0 0 "Cloudflare"
    _pids=""; _i=0
    while [ "$_i" -lt "$NS" ]; do
        ( trap 'kill $_w 2>/dev/null; exit 0' TERM
          while :; do wget -q -O /dev/null -T 30 "https://speed.cloudflare.com/__down?bytes=25000000" & _w=$!; wait $_w || sleep 1; done ) >/dev/null 2>&1 &
        _pids="$_pids $!"; _i=$((_i + 1))
    done
    _ctr="/sys/class/net/$DEV/statistics/rx_bytes"
    _b0=$(cat "$_ctr"); _t0=$(cut -d' ' -f1 /proc/uptime); _s=""; _n=0
    while [ "$_n" -lt "$DUR" ]; do
        sleep 1
        _b1=$(cat "$_ctr"); _t1=$(cut -d' ' -f1 /proc/uptime)
        _m=$(awk -v a="$_b0" -v b="$_b1" -v x="$_t0" -v y="$_t1" 'BEGIN{d=y-x; if(d<0.2)d=0.2; printf "%.2f",(b-a)*8/d/1e6}')
        _n=$((_n + 1)); _s="$_s $_m"; _b0=$_b1; _t0=$_t1
        _prog down "$_m" "$_n" "Cloudflare"
    done
    kill $_pids 2>/dev/null; wait $_pids 2>/dev/null
    _R=$(_stats $_s); _down=${_R% *}; _dpeak=${_R#* }

    # ---- up: iperf3 to the first server that takes the test; its own per-second
    # [SUM] lines feed the progress file, its receiver summary is the figure
    _up=""; _upeak=0; _via=""
    for _srv in $UPSERVERS; do
        _h=${_srv%:*}; _p=${_srv#*:}
        _prog up 0 0 "$_h"
        _out=$(iperf3 -c "$_h" -p "$_p" -P "$NS" -t "$DUR" -O 2 -f m --connect-timeout 4000 2>&1 | while IFS= read -r _l; do
            case "$_l" in
                *SUM*sec*Mbits/sec*receiver*|*SUM*sec*Mbits/sec*sender*) printf '%s\n' "$_l" ;;
                *SUM*sec*Mbits/sec*)
                    _mb=$(printf '%s' "$_l" | awk '{for(i=1;i<=NF;i++) if($i=="Mbits/sec"){print $(i-1); exit}}')
                    _tt=$(printf '%s' "$_l" | awk '{for(i=1;i<=NF;i++) if($i=="sec"){split($(i-1),a,"-"); printf "%d", a[2]; exit}}')
                    [ -n "$_mb" ] && _prog up "$_mb" "${_tt:-0}" "$_h" ;;
                *busy*|*error*|*unable*|*refused*) printf 'ERR %s\n' "$_l" ;;
            esac
        done)
        _recv=$(printf '%s\n' "$_out" | awk '/receiver/{for(i=1;i<=NF;i++) if($i=="Mbits/sec"){print $(i-1)}}' | tail -n1)
        [ -n "$_recv" ] || _recv=$(printf '%s\n' "$_out" | awk '/sender/{for(i=1;i<=NF;i++) if($i=="Mbits/sec"){print $(i-1)}}' | tail -n1)
        if [ -n "$_recv" ]; then _up=$(printf '%s' "$_recv" | awk '{printf "%.1f",$1}'); _via=$_h; break; fi
    done
    rm -f "$SPEEDPROG" "$SPEEDLOCK"
    case "$_down" in 0|0.0) fail "nothing came through — is the internet reachable?" ;; esac
    _at=$(date +%s)
    printf 'SPEED_DOWN=%s\nSPEED_UP=%s\nSPEED_DPEAK=%s\nSPEED_VIA=%s\nSPEED_SECS=%s\nSPEED_STREAMS=%s\nSPEED_AT=%s\n' \
        "$_down" "$_up" "$_dpeak" "$_via" "$DUR" "$NS" "$_at" > "$SPEEDLAST" 2>/dev/null
    logger -t tools "speed test: $_down Mbit/s down (Cloudflare), ${_up:-no} Mbit/s up (${_via:-no server answered}); $NS streams, ${DUR}s each way, $DEV, via web UI"
    _upj=null; [ -n "$_up" ] && _upj=$_up
    printf '{"ok":true,"down":%s,"up":%s,"down_peak":%s,"up_via":"%s","seconds":%s,"streams":%s,"dev":"%s","at":%s}' \
        "$_down" "$_upj" "$_dpeak" "$(esc "$_via")" "$DUR" "$NS" "$(esc "$DEV")" "$_at"
    exit 0
fi

# -------------------------------------------------------------- activity --
# The last things that happened, newest first, named. Read from the ring
# buffer rather than from a file this console would have to keep: the log
# already holds every join, leave, uplink change and console action, and
# reading it costs one logread, which the Settings page already does.
speed_json() {
    SPEED_DOWN=""; SPEED_UP=""; SPEED_DPEAK=""; SPEED_VIA=""; SPEED_SECS=""; SPEED_STREAMS=""; SPEED_AT=""
    if [ -r "$SPEEDLAST" ]; then
        while IFS= read -r _l; do
            case "$_l" in
                SPEED_DOWN=*) SPEED_DOWN=${_l#*=} ;; SPEED_UP=*) SPEED_UP=${_l#*=} ;; SPEED_DPEAK=*) SPEED_DPEAK=${_l#*=} ;;
                SPEED_VIA=*) SPEED_VIA=${_l#*=} ;; SPEED_SECS=*) SPEED_SECS=${_l#*=} ;; SPEED_STREAMS=*) SPEED_STREAMS=${_l#*=} ;; SPEED_AT=*) SPEED_AT=${_l#*=} ;;
            esac
        done < "$SPEEDLAST"
    fi
    _dec() { case "$1" in ''|*[!0-9.]*|.|*.*.*) printf 'null' ;; *) printf '%s' "$1" ;; esac; }
    case "$SPEED_DOWN" in ''|*[!0-9.]*) printf 'null'; return ;; esac
    printf '{"down":%s,"up":%s,"down_peak":%s,"up_via":"%s","seconds":%s,"streams":%s,"at":%s}' \
        "$(_dec "$SPEED_DOWN")" "$(_dec "$SPEED_UP")" "$(_dec "$SPEED_DPEAK")" "$(esc "$SPEED_VIA")" "$(_dec "$SPEED_SECS")" "$(_dec "$SPEED_STREAMS")" "$(_dec "$SPEED_AT")"
}

N=$(qs_get n); case "$N" in ''|*[!0-9]*) N=60 ;; esac; [ "$N" -gt 200 ] && N=200
printf '{"ok":true,"now":%s,"travel":%s,"speed":%s,"events":[' "$(date +%s)" "$(travel_json)" "$(speed_json)"
# classmap: MAC|Name|class|ip|zone ; leases: expiry MAC ip hostname clientid
logread 2>/dev/null | tail -n 600 | awk -v N="$N" -v CM="$CLASSMAP" -v LZ="$LEASES" '
function esc(s){ gsub(/\\/,"\\\\",s); gsub(/"/,"\\\"",s); gsub(/[\001-\037\177]/,"",s); return s }
function nameof(m,  n){ m=tolower(m); if (m in NAME) return NAME[m]; if (m in HOST) return HOST[m]; return toupper(m) }
BEGIN{
  while ((getline l < CM) > 0) { if (l ~ /^#/ || l == "") continue; split(l, f, "|"); if (f[1] != "" && f[2] != "") NAME[tolower(f[1])] = f[2] }
  close(CM)
  while ((getline l < LZ) > 0) { split(l, f, " "); if (f[2] != "" && f[4] != "" && f[4] != "*") HOST[tolower(f[2])] = f[4] }
  close(LZ)
  n=0
}
{
  # "Tue Sep 15 00:56:40 2026 daemon.notice hostapd: phy0.1-ap0: AP-STA-CONNECTED 70:13:84:47:31:bf auth_alg=sae"
  day=$2" "$3; t=$4; kind=""; who=""; text=""; tone=""; band=""
  if ($0 ~ /AP-STA-CONNECTED/) { kind="join"; mac=$(NF-1); if (mac !~ /:/) mac=$NF; who=nameof(mac); band=($6 ~ /phy0\.1/) ? "5 GHz" : "2.4 GHz"; if ($6 ~ /ap1/) band="IoT"; text="joined on " band; tone="ok" }
  else if ($0 ~ /AP-STA-DISCONNECTED/) { kind="leave"; mac=$NF; who=nameof(mac); band=($6 ~ /phy0\.1/) ? "5 GHz" : "2.4 GHz"; if ($6 ~ /ap1/) band="IoT"; text="left " band; tone="" }
  else if ($0 ~ /wifiwatch: flapping:/) { kind="flap"; mac=$8; who=nameof(mac); text="keeps dropping"; tone="warn" }
  else if ($0 ~ /Interface .[a-z0-9]+. is now (up|down)/) { kind="uplink"; who=$0; sub(/.*Interface ./,"",who); sub(/. is now.*/,"",who); text=($0 ~ /now up/) ? "came up" : "went down"; tone=($0 ~ /now up/) ? "ok" : "bad"; if (who == "lan" || who == "loopback" || who == "iot" || who == "guest") next }
  else if ($0 ~ / settings: /) { kind="change"; who="Settings"; text=$0; sub(/.* settings: /,"",text); tone="" }
  else if ($0 ~ / tools: /) { kind="change"; who="Console"; text=$0; sub(/.* tools: /,"",text); tone="" }
  else if ($0 ~ / notifymon: /) { kind="alert"; who="Alert"; text=$0; sub(/.* notifymon: /,"",text); tone="warn" }
  else if ($0 ~ / beryl-iperf: /) { kind="change"; who="iPerf"; text=$0; sub(/.* beryl-iperf: /,"",text); tone="" }
  else next
  n++; E[n]=sprintf("{\"day\":\"%s\",\"time\":\"%s\",\"kind\":\"%s\",\"who\":\"%s\",\"text\":\"%s\",\"tone\":\"%s\"}", esc(day), esc(t), kind, esc(who), esc(text), tone)
}
END{ c=0; for (i=n; i>=1 && c<N; i--) { printf "%s%s", (c?",":""), E[i]; c++ } }'
printf ']}'
