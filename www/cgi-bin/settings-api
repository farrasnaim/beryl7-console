#!/bin/sh
# /www/cgi-bin/settings-api  —  curated router configuration.
#
# Read: one JSON with the configured values, the live radio state, and the
# capability data the UI needs to offer only REAL choices (channel list and
# per-channel maximum width are derived from `iw` at request time, never from
# a hardcoded Wi-Fi table).
#
# Writes are POST + same-origin, because every action here rewrites /etc/config
# and reloads a service. There is no password: the console is unauthenticated on
# the trusted LAN by design, and the same-origin check is what stops a web page
# you happen to be visiting from driving these endpoints through your browser.
#
# Validation lives HERE, not in the browser: channel must be one the radio can
# legally use, the width must fit that channel's contiguous block, the PHY
# generation must exist on that band. The UI filters for clarity; this file
# filters for safety.

POST_MAX=4096

# ---- wireless topology discovery --------------------------------------------
# Nothing below may assume a vendor's section names or radio ordering. GL.iNet
# ships main2g/main5g/iot2g; stock OpenWrt generates default_radio0/1; a
# hand-written config uses whatever the author typed. Likewise radio0 is not
# necessarily 2.4 GHz — band comes from the radio, never from the index.
LANNET=lan

wifi_sections() { uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'; }
RADIOS=$(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p')

# The AP section a radio's SSID settings belong to: prefer one on the primary
# network, else the radio's first AP. Empty means the radio has no AP at all.
ap_section_of() {   # $1 = radioN
    _first=""
    for _s in $(wifi_sections); do
        [ "$(uci -q get wireless.$_s.device 2>/dev/null)" = "$1" ] || continue
        _m=$(uci -q get wireless.$_s.mode 2>/dev/null)
        [ -z "$_m" ] || [ "$_m" = "ap" ] || continue
        [ -n "$_first" ] || _first="$_s"
        if [ "$(uci -q get wireless.$_s.network 2>/dev/null)" = "$LANNET" ]; then
            printf '%s' "$_s"; return 0
        fi
    done
    printf '%s' "$_first"
}

# The first AP that is NOT on the primary network — the "IoT"/secondary SSID.
# Most routers have none, and the UI hides the panel when this is empty.
secondary_section() {
    for _s in $(wifi_sections); do
        _m=$(uci -q get wireless.$_s.mode 2>/dev/null)
        [ -z "$_m" ] || [ "$_m" = "ap" ] || continue
        _n=$(uci -q get wireless.$_s.network 2>/dev/null)
        [ -n "$_n" ] && [ "$_n" != "$LANNET" ] && { printf '%s' "$_s"; return 0; }
    done
}

# The mac80211 phy backing a radio — `iw phy` capability queries are per-phy.
# Single-phy boards (this one, and most dual-band routers) short-circuit; only
# genuinely multi-phy hardware pays for the ubus lookup.
phy_of() {   # $1 = radioN
    _n=0; _only=""
    for _p in /sys/class/ieee80211/*; do
        [ -d "$_p" ] || continue
        _n=$((_n+1)); _only=${_p##*/}
    done
    [ "$_n" = "1" ] && { printf '%s' "$_only"; return 0; }
    _if=$(ubus call network.wireless status 2>/dev/null | awk -v want="$1" '
        /^\t"/ { gsub(/[\t":{ ]/,""); dev=$0 }
        /"ifname":/ { if (dev==want) { gsub(/[",]/,""); print $2; exit } }')
    if [ -n "$_if" ]; then
        _pn=$(cat "/sys/class/net/$_if/phy80211/name" 2>/dev/null)
        [ -n "$_pn" ] && { printf '%s' "$_pn"; return 0; }
    fi
    printf 'phy%s' "${1#radio}"
}
PHY=$(phy_of "$(printf '%s' "$RADIOS" | head -n1)")

# JSON forbids a raw control byte inside a string, and JSON.parse enforces it —
# one such byte anywhere in a payload invalidates the WHOLE response, so the page
# renders nothing and the cause is invisible. Stripping only \n\r\t left BEL, VT,
# FF, ESC and the rest passing through verbatim; reachable through any name the
# router did not author, e.g. a device renamed via setdev, whose own filter also
# only removes \n\r\t.
#
# The range is spelled in octal, NOT as [:cntrl:]. busybox tr does not implement
# POSIX classes and silently treats [:cntrl:] as the literal set { [ : c n t r l ] },
# so `tr -d '[:cntrl:]'` turns "hello world" into "heo wod" — measured on this
# router. That would have quietly corrupted every name containing c, n, t, r or l.
esc() { printf '%s' "$1" | tr -d '\001-\037\177' | sed 's/\\/\\\\/g; s/"/\\"/g'; }
jnum() { case "$1" in ''|*[!0-9]*) printf '0' ;; *) printf '%s' "$1" ;; esac; }
fail() { printf '{"ok":false,"error":"%s"}' "$(esc "$1")"; exit 0; }

# ------------------------------------------------------------------ backup --
# Handled before the JSON headers because this response is a file, not JSON.
# A GET, like `logs`: it reads configuration and changes nothing. The archive
# does hold secrets — Wi-Fi keys, tunnel keys — but every page of this console
# already does, it is unauthenticated on the trusted LAN by design, and a
# foreign origin can cause the request without ever being handed the bytes.
# This is the same archive `sysupgrade -b` writes and LuCI hands you, so the
# restore path is the ordinary one and nothing here invents a format.
case "&$QUERY_STRING&" in
    *"&action=backup&"*)
        BK="/tmp/beryl-backup-$$.tar.gz"
        if sysupgrade -b "$BK" >/dev/null 2>&1 && [ -s "$BK" ]; then
            printf 'Content-Type: application/x-gzip\r\n'
            printf 'Content-Disposition: attachment; filename="%s-backup-%s.tar.gz"\r\n' \
                "$(uci -q get system.@system[0].hostname 2>/dev/null || echo openwrt)" \
                "$(date +%Y%m%d-%H%M%S)"
            printf 'Content-Length: %s\r\n' "$(wc -c < "$BK")"
            printf 'Cache-Control: no-store\r\n\r\n'
            cat "$BK"
        else
            printf 'Content-Type: application/json\r\n'
            printf 'Cache-Control: no-store\r\n\r\n'
            printf '{"ok":false,"error":"could not create the archive"}'
        fi
        rm -f "$BK"
        exit 0
        ;;
esac

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n\r\n'

BODY=""
if [ "$REQUEST_METHOD" = "POST" ]; then
    CL="${CONTENT_LENGTH:-0}"; case "$CL" in ''|*[!0-9]*) CL=0 ;; esac
    [ "$CL" -gt "$POST_MAX" ] && fail "body too large"
    [ "$CL" -gt 0 ] && BODY=$(dd bs=1 count="$CL" 2>/dev/null)
fi

urldec() {
    printf '%s' "$1" | awk '
    BEGIN{ for(i=0;i<16;i++){ h=sprintf("%X",i); H[h]=i; H[tolower(h)]=i } }
    { gsub(/\+/," "); s=$0; n=length(s); out=""
      for(i=1;i<=n;i++){ c=substr(s,i,1)
        if(c=="%" && i+2<=n){ a=substr(s,i+1,1); b=substr(s,i+2,1)
          if((a in H) && (b in H)){ out=out sprintf("%c",H[a]*16+H[b]); i+=2; continue } }
        out=out c }
      printf "%s", out }'
}
qs_get() {
    printf '%s' "${QUERY_STRING}&${BODY}" | tr '&' '\n' \
      | awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); print; exit}'
}
qs_get_dec() { urldec "$(qs_get "$1")"; }

guard_post() {
    [ "$REQUEST_METHOD" = "POST" ] || fail "POST required"
    gp_src="${HTTP_ORIGIN:-$HTTP_REFERER}"
    gp_src="${gp_src#*://}"; gp_src="${gp_src%%[:/]*}"
    # DNS is case-insensitive and a browser echoes back whatever was typed
    # in the address bar, so Beryl7.lan and beryl7.lan are one host. The
    # address list is already lowercase, so this cannot affect IP matching.
    gp_src=$(printf '%s' "$gp_src" | tr 'A-Z' 'a-z')
    gp_ok=0
    case "$gp_src" in
        "") gp_ok=0 ;;
        localhost|127.0.0.1|::1) gp_ok=1 ;;
        *) for gp_ip in $(ip -o addr 2>/dev/null | awk '{split($4,x,"/"); print x[1]}'); do
             [ "$gp_ip" = "$gp_src" ] && { gp_ok=1; break; }
           done
           # ...and the names this router answers to. Opening the console by
           # name is an ordinary thing to do, and settings-api even offers a
           # control to CHANGE the hostname — so the console hands you a way to
           # create the condition that disables it. Without this the page loads
           # (GET is unguarded) and every button then fails "bad origin" with
           # nothing pointing at the cause.
           #
           # Read from uci at runtime, never written literally: this repository
           # is public and a hostname baked in here is one deployment's private
           # detail published.
           #
           # NOT Origin == HTTP_HOST, which is the usual fix and is wrong here.
           # That compares two headers the caller controls to each other, so an
           # attacker domain pointed at this router matches itself and passes.
           # Checking against addresses the router actually owns is precisely
           # what defeats DNS rebinding, so it stays an allowlist.
           if [ "$gp_ok" = 0 ]; then
               gp_h=$(uci -q get system.@system[0].hostname | tr 'A-Z' 'a-z')
               gp_d=$(uci -q get dhcp.@dnsmasq[0].domain | tr 'A-Z' 'a-z')
               [ -n "$gp_d" ] || gp_d=lan
               [ -n "$gp_h" ] && { [ "$gp_src" = "$gp_h" ] || [ "$gp_src" = "$gp_h.$gp_d" ]; } && gp_ok=1
           fi ;;
    esac
    [ "$gp_ok" = 1 ] || fail "bad origin"
}

ACTION=$(qs_get action)
case "$ACTION" in
    "") ;;
    # `logs` reads the ring buffer and changes nothing, so it stays a GET like
    # repeater `scan` does. The POST rule exists to stop a foreign page issuing
    # a write through your browser; a read cannot be turned into one, and the
    # browser will not hand the response to another origin anyway.
    logs) ;;
    *) [ "$REQUEST_METHOD" = "POST" ] || fail "POST required" ;;
esac
[ "$REQUEST_METHOD" = "POST" ] && guard_post

UPDCACHE=/tmp/.updcheck

# ------------------------------------------------------------------- logs --
# Away from home the honest answer to "why is there no internet" lives in the
# ring buffer, and reaching it used to mean SSH — i.e. a laptop. Newest first,
# because the reason you are looking is almost always the last thing that
# happened. Filtering is by severity rather than by text: on a quiet router the
# interesting lines are rare and you do not know the word to search for yet.
if [ "$ACTION" = "logs" ]; then
    LVL=$(qs_get level); N=$(qs_get n)
    case "$N" in ''|*[!0-9]*) N=200 ;; esac
    [ "$N" -gt 300 ] && N=300
    case "$LVL" in err|warn) ;; *) LVL=all ;; esac
    printf '{"ok":true,"level":"%s","lines":' "$LVL"
    # One `logread`, not two. This endpoint is polled every few seconds, and
    # dumping the whole ring buffer a second time just to count its lines was
    # most of the cost. Snapshot to tmpfs, then count and filter from that.
    LT="/tmp/.logsnap.$$"
    # Ask logd for the WINDOW, not the whole ring. `logread -l N` returns the
    # last N messages, so this cost stays flat however large log_size grows —
    # the full dump scaled with it, and this endpoint is re-read every 4s the
    # whole time the log panel is on screen. Measured against a 242KB buffer:
    # full dump 89ms, `-l 900` 40ms, and the gap widens as the buffer fills.
    # Falls back to the full dump if a build's logread lacks -l, rather than
    # rendering an empty log.
    logread -l 900 > "$LT" 2>/dev/null
    [ -s "$LT" ] || logread > "$LT" 2>/dev/null
    # The true buffer depth is the one thing that still needs a full read, so it
    # is computed only when asked for. The panel wants it once, to say "150 of
    # N lines"; it does not need it recomputed on every four-second refresh.
    if [ "$(qs_get total)" = "1" ]; then
        LTOT=$(logread 2>/dev/null | wc -l); case "$LTOT" in ''|*[!0-9]*) LTOT=0 ;; esac
    else
        LTOT=-1
    fi
    # Read a wide window and filter inside awk: a severity filter applied after
    # `tail` would return almost nothing, since warnings are sparse by design.
    tail -n 900 "$LT" | awk -v want="$LVL" -v lim="$N" '
        function jesc(s) {
            # Both of these use the "\\&" form — emit a literal backslash, then
            # re-emit the matched character — because it is the only spelling
            # POSIX actually defines and both awks implement.
            #
            # The obvious spellings are each broken here:
            #   gsub(/"/,  "\\\"", s)  busybox drops the backslash entirely (a
            #                          backslash before a non-special char is
            #                          undefined), so quotes came through raw
            #                          and any log line containing one produced
            #                          invalid JSON. gawk kept it, and gawk was
            #                          on this router until banip took it away.
            #   gsub(/\\/, "\\\\", s)  emits ONE backslash, not two — a no-op
            #                          that never escaped anything, on any awk.
            #
            # Order matters: backslashes first, or the ones added by the quote
            # pass would be escaped a second time.
            gsub(/\\/, "\\\\&", s); gsub(/"/, "\\\\&", s)
            # [[:cntrl:]], not [\000-\037]: busybox awk cannot parse an octal
            # escape inside a bracket expression and dies with "bad regex '['",
            # taking the whole array with it and emitting "lines":, — invalid
            # JSON, so the panel reports the log as unreadable. gawk accepted
            # it, and gawk was on this router until it was pulled in as an
            # orphaned dependency of banip on 2026-08-11. POSIX class works on
            # both.
            gsub(/\t/, " ", s); gsub(/[[:cntrl:]]/, "", s)
            return s
        }
        NF > 7 {
            lvl = $6; sub(/^[^.]*\./, "", lvl)
            keep = (want == "all")
            if (!keep && lvl ~ /^(emerg|alert|crit|err)/) keep = 1
            if (!keep && want == "warn" && lvl ~ /^warn/) keep = 1
            if (!keep) next
            src = $7; sub(/:$/, "", src)
            msg = ""
            for (i = 8; i <= NF; i++) msg = msg (i > 8 ? " " : "") $i
            buf[++n] = "{\"t\":\"" $4 "\",\"d\":\"" $2 " " $3 "\",\"lvl\":\"" jesc(lvl) \
                       "\",\"src\":\"" jesc(src) "\",\"msg\":\"" jesc(msg) "\"}"
        }
        END {
            printf "["
            c = 0
            for (i = n; i > 0 && c < lim; i--) { printf "%s%s", (c++ ? "," : ""), buf[i] }
            printf "]"
        }'
    rm -f "$LT"
    printf ',"total":%s}' "$LTOT"
    exit 0
fi

# ---------------------------------------------------------- update check --
# owut talks to the ASU build server, so this is seconds, not milliseconds — far
# too slow for the 5s poll. It runs only when asked and caches the reading; the
# status payload serves that cache for free, and the panel says when it was
# taken. An instrument that cannot say how old its reading is invites you to
# trust a stale one.
if [ "$ACTION" = "updcheck" ]; then
    if ! command -v owut >/dev/null 2>&1; then
        printf '{"ok":false,"error":"owut is not installed — add attendedsysupgrade-common"}'
        exit 0
    fi
    if command -v timeout >/dev/null 2>&1; then
        OUT=$(timeout 60 owut check --verbose 2>&1)
    else
        OUT=$(owut check --verbose 2>&1)
    fi
    # owut's verbose output is sectioned, and the same facts are worded
    # differently with and without --verbose. Parse by section rather than by
    # sentence: a header opens one, any unindented line closes it, and the
    # indented rows between are the data. Guessing from a summary sentence is
    # how "1 modified default package" got read as something it was not.
    UJ=$(printf '%s\n' "$OUT" | awk -v ts="$(date +%s)" '
        function jesc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
        /^Package version changes:/  { sec = "ver"; next }
        /^Default package analysis:/ { sec = "def"; next }
        /^There are currently package build failures/ { sec = ""; next }
        /^[^ \t]/ { sec = "" }
        /^Version-from/ { $1 = ""; sub(/^ +/, ""); from  = $0 }
        /^Version-to/   { $1 = ""; sub(/^ +/, ""); to    = $0 }
        /^Target/       { tgt   = $2 }
        /^Profile/      { prof  = $2 }
        /^Build-at/     { $1 = ""; sub(/^ +/, ""); built = $0 }
        /^Image-file/   { img   = $2 }
        /packages are out-of-date/ { ood = $1 + 0 }
        # Keep owut'"'"'s own closing sentence rather than reducing it to a guess.
        # The first version matched only "It is safe to proceed", so the better
        # outcome — "There are no changes, upgrade not necessary" — was read as
        # unsafe. Only an explicit "not safe" is treated as one.
        /safe to proceed|upgrade not necessary|not safe/ {
            verdict = $0
            safe = ($0 ~ /not safe/) ? 0 : 1
        }
        # "name  installed  available"
        sec == "ver" && /^[ \t]+[A-Za-z0-9]/ && NF == 3 {
            pk = pk (pc++ ? "," : "") "{\"name\":\"" jesc($1) "\",\"from\":\"" jesc($2) "\",\"to\":\"" jesc($3) "\"}"
        }
        # "default-package  provided-by" — a stock package satisfied by a
        # different one. Its own column header is skipped by name.
        sec == "def" && /^[ \t]+[A-Za-z0-9]/ && NF == 2 && $1 != "Default" {
            sb = sb (sc++ ? "," : "") "{\"name\":\"" jesc($1) "\",\"by\":\"" jesc($2) "\"}"
        }
        END {
            printf "{\"checked\":%s,\"from\":\"%s\",\"to\":\"%s\",\"target\":\"%s\",\"profile\":\"%s\",", \
                ts, jesc(from), jesc(to), jesc(tgt), jesc(prof)
            printf "\"built\":\"%s\",\"image\":\"%s\",\"safe\":%s,\"verdict\":\"%s\",\"outdated\":%d,", \
                jesc(built), jesc(img), (safe ? "true" : "false"), jesc(verdict), ood
            printf "\"packages\":[%s],\"substituted\":[%s]}", pk, sb
        }')
    case "$UJ" in
        '{'*) printf '%s' "$UJ" > "$UPDCACHE"; printf '{"ok":true,"update":%s}' "$UJ" ;;
        *)    printf '{"ok":false,"error":"could not read owut output"}' ;;
    esac
    exit 0
fi

# -------------------------------------------------------- package upgrade --
# Named packages only, never a blanket upgrade. The check above already says
# exactly which ones are behind, and upgrading only those keeps the blast radius
# equal to what the panel showed — a bare `apk upgrade` would be a different,
# larger action than the one the button offered.
if [ "$ACTION" = "pkgupgrade" ]; then
    command -v apk >/dev/null 2>&1 || fail "apk is not available on this build"
    NAMES=$(qs_get_dec names)
    [ -n "$NAMES" ] || fail "nothing to upgrade"
    # Package names, spaces between. Anything else is refused rather than
    # escaped: this string reaches a command line.
    printf '%s' "$NAMES" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._+ -]*$' || fail "bad package list"
    apk update >/dev/null 2>&1 || fail "could not refresh the package index — is the router online?"
    OUT=$(apk upgrade $NAMES 2>&1)
    RC=$?
    # The cached reading is now wrong whatever happened; drop it rather than
    # let the panel keep showing a version that may have just changed.
    rm -f "$UPDCACHE"
    if [ "$RC" = "0" ]; then
        printf '{"ok":true,"action":"pkgupgrade","detail":"%s"}' \
            "$(esc "$(printf '%s' "$OUT" | grep -iE '^\([0-9]+/[0-9]+\)|^OK:' | tr '\n' ' ')")"
    else
        printf '{"ok":false,"error":"%s"}' \
            "$(esc "$(printf '%s' "$OUT" | grep -iE 'error|ERROR' | head -1)")"
    fi
    exit 0
fi

# ---------------------------------------------------------------- capability --
# Channel list with a computed per-channel MAXIMUM width. A width is valid only
# when every channel of its standard contiguous block is present and usable, so
# regulatory gaps (disabled ranges, No-IR) shrink the offer automatically.
# One awk owns the block maths for both the read and the write path, so the
# browser can never smuggle a width past what the offer was computed from.
# With pick="" it prints the channel list as JSON; with pick=<channel> it
# prints that channel's maximum width as a bare number.
chan_calc() {   # $1 = iw band number (1=2.4GHz, 2=5GHz), $2 = pick (optional)
    iw phy $PHY channels 2>/dev/null | awk -v want="$1" -v pick="${2:-}" '
    /^[\t ]*Band [0-9]+:/ { band=$2+0; next }
    /\* [0-9]+ MHz \[[0-9]+\]/ {
        if (band != want) { cur=0; next }
        f=$2+0; match($0,/\[[0-9]+\]/); c=substr($0,RSTART+1,RLENGTH-2)+0
        cur=c; freq[c]=f; disab[c]=($0 ~ /\(disabled\)/)?1:0; order[++n]=c; next
    }
    /No IR/          { if (band==want && cur) disab[cur]=1 }
    /[Rr]adar detection/ { if (band==want && cur) dfs[cur]=1 }
    END {
        for (i=1;i<=n;i++) { c=order[i]; if (!disab[c]) ok[c]=1 }
        for (i=1;i<=n;i++) {
            c=order[i]; if (disab[c]) continue
            w=20
            if (want==1) {
                if (ok[c-4] || ok[c+4]) w=40
            } else {
                base = (c>=149) ? 149 : 36
                b40 = c - ((c-base)%8);  if (ok[b40] && ok[b40+4]) w=40
                b80 = c - ((c-base)%16)
                if (w==40 && ok[b80] && ok[b80+4] && ok[b80+8] && ok[b80+12]) w=80
                if (w==80) { b160 = c - ((c-base)%32); good=1
                    for (m=0;m<32;m+=4) if (!ok[b160+m]) good=0
                    if (good) w=160
                }
            }
            maxw[c]=w
        }
        if (pick != "") { print (pick in maxw) ? maxw[pick] : 0; exit }
        printf "["
        out=0
        for (i=1;i<=n;i++) {
            c=order[i]; if (disab[c]) continue
            printf "%s{\"c\":%d,\"f\":%d,\"maxw\":%d%s}", (out++?",":""), c, freq[c], maxw[c], (dfs[c]?",\"dfs\":true":"")
        }
        printf "]"
    }'
}
chan_json() { chan_calc "$1"; }
maxw_of()  { chan_calc "$1" "$2"; }

# PHY generations actually present on a band, from the capability blocks.
# The HT marker is its MCS table — `iw` prints HT caps as a bare
# "Capabilities:" line, so the literal string "HT Capabilities" never appears.
gens_of() {     # $1 = iw band number
    iw phy $PHY info 2>/dev/null | awk -v want="$1" '
    /^[\t ]*Band [0-9]+:/ { band=$2+0; next }
    band==want && /HT TX\/RX MCS rate indexes/ { g["HT"]=1 }
    band==want && /VHT Capabilities/           { g["VHT"]=1 }
    band==want && /HE PHY Capabilities/        { g["HE"]=1 }
    band==want && /EHT PHY Capabilities/       { g["EHT"]=1 }
    END {
        printf "["
        n=0
        split("HT VHT HE EHT", ord, " ")
        for (i=1;i<=4;i++) if (ord[i] in g) printf "%s\"%s\"", (n++?",":""), ord[i]
        printf "]"
    }'
}
# iw band numbers: 1 = 2.4 GHz, 2 = 5 GHz, 4 = 6 GHz (3 is 60 GHz).
band_num() { case "$1" in 2g) echo 1 ;; 6g) echo 4 ;; *) echo 2 ;; esac; }

# --------------------------------------------------------- subnet arithmetic --
ip2int() {   # dotted quad -> 32-bit integer
    _o1=${1%%.*}; _r=${1#*.}; _o2=${_r%%.*}; _r=${_r#*.}; _o3=${_r%%.*}; _o4=${_r##*.}
    printf '%s' $(( (_o1 << 24) + (_o2 << 16) + (_o3 << 8) + _o4 ))
}
mask2pfx() {   # dotted netmask -> prefix length; a contiguous mask's length is
               # just its population count. Unparseable falls back to /24, the
               # only netmask this endpoint ever writes.
    case "$1" in ''|*[!0-9.]*) printf 24; return ;; esac
    _m=$(ip2int "$1"); _p=0; _i=0
    while [ "$_i" -lt 32 ]; do _p=$(( _p + ((_m >> _i) & 1) )); _i=$((_i + 1)); done
    printf '%s' "$_p"
}
# Do a.b.c.d/24 and $2/$3 share any address?
overlaps24() {   # $1 = new LAN address  $2 = other address  $3 = other prefix
    [ "$3" -ge 8 ] 2>/dev/null || return 1
    _p=$3; [ "$_p" -gt 24 ] && _p=24
    _k=$(( (4294967295 << (32 - _p)) & 4294967295 ))
    [ $(( $(ip2int "$1") & _k )) -eq $(( $(ip2int "$2") & _k )) ]
}

# ------------------------------------------------------------------- writes --
if [ "$ACTION" = "setwifi" ]; then
    RADIO=$(qs_get_dec radio)
    _okr=0
    for _r in $RADIOS; do [ "$_r" = "$RADIO" ] && { _okr=1; break; }; done
    [ "$_okr" = "1" ] || fail "bad radio"
    BAND=$(uci -q get wireless.$RADIO.band)
    BN=$(band_num "$BAND")
    PHY=$(phy_of "$RADIO")
    IFSEC=$(ap_section_of "$RADIO")
    [ -n "$IFSEC" ] || fail "this radio has no access point configured"

    EN=$(qs_get_dec enabled); case "$EN" in 0|1) ;; *) fail "bad enabled flag" ;; esac
    SSID=$(qs_get_dec ssid | tr -d '\n\r\t')
    KEY=$(qs_get_dec key | tr -d '\n\r')
    CH=$(qs_get_dec channel)
    HT=$(qs_get_dec htmode)
    TX=$(qs_get_dec txpower)

    SLEN=$(printf '%s' "$SSID" | wc -c)
    [ "$SLEN" -ge 1 ] && [ "$SLEN" -le 32 ] || fail "network name must be 1-32 characters"
    if [ -n "$KEY" ]; then
        KLEN=$(printf '%s' "$KEY" | wc -c)
        [ "$KLEN" -ge 8 ] && [ "$KLEN" -le 63 ] || fail "password must be 8-63 characters"
    fi
    case "$CH" in ''|*[!0-9]*) fail "bad channel" ;; esac
    MAXW=$(maxw_of "$BN" "$CH"); MAXW=$(jnum "$MAXW")
    [ "$MAXW" -ge 20 ] || fail "channel $CH is not available on this band"

    GEN=$(printf '%s' "$HT" | sed 's/[0-9]*$//'); W=$(printf '%s' "$HT" | sed 's/^[A-Z]*//')
    case "$GEN" in HT|VHT|HE|EHT) ;; *) fail "bad mode" ;; esac
    case "$W" in 20|40|80|160) ;; *) fail "bad width" ;; esac
    [ "$GEN" = "HT" ] && [ "$W" -gt 40 ] && fail "HT supports 20 or 40 MHz only"
    gens_of "$BN" | grep -q "\"$GEN\"" || fail "$GEN is not supported on this band"
    [ "$W" -le "$MAXW" ] || fail "channel $CH supports at most $MAXW MHz"

    if [ -n "$TX" ]; then
        case "$TX" in *[!0-9]*) fail "bad transmit power" ;; esac
        [ "$TX" -ge 1 ] && [ "$TX" -le 30 ] || fail "transmit power out of range"
    fi

    uci set wireless.$RADIO.disabled="$([ "$EN" = "1" ] && echo 0 || echo 1)"
    uci set wireless.$RADIO.channel="$CH"
    uci set wireless.$RADIO.htmode="$HT"
    if [ -n "$TX" ]; then uci set wireless.$RADIO.txpower="$TX"
    else uci -q delete wireless.$RADIO.txpower; fi
    uci set wireless.$IFSEC.ssid="$SSID"
    [ -n "$KEY" ] && uci set wireless.$IFSEC.key="$KEY"
    uci commit wireless
    logger -t settings "wifi $RADIO applied via web UI (ch=$CH $HT)"
    # the whole subshell must drop stdout, or uhttpd holds the response open
    # until the reload finishes
    ( sleep 1; wifi reload $RADIO ) >/dev/null 2>&1 &
    # Echo the committed values back: proof the write landed, not just that the
    # request arrived. The radio itself confirms on the next status poll.
    printf '{"ok":true,"applied":{"channel":"%s","htmode":"%s","ssid":"%s"}}' \
        "$(esc "$CH")" "$(esc "$HT")" "$(esc "$SSID")"
    exit 0
fi

if [ "$ACTION" = "setiot" ]; then
    IOTSEC=$(secondary_section)
    [ -n "$IOTSEC" ] || fail "no secondary network is configured on this router"
    IOTRADIO=$(uci -q get wireless.$IOTSEC.device)
    EN=$(qs_get_dec enabled); case "$EN" in 0|1) ;; *) fail "bad enabled flag" ;; esac
    SSID=$(qs_get_dec ssid | tr -d '\n\r\t')
    KEY=$(qs_get_dec key | tr -d '\n\r')
    SLEN=$(printf '%s' "$SSID" | wc -c)
    [ "$SLEN" -ge 1 ] && [ "$SLEN" -le 32 ] || fail "network name must be 1-32 characters"
    if [ -n "$KEY" ]; then
        KLEN=$(printf '%s' "$KEY" | wc -c)
        [ "$KLEN" -ge 8 ] && [ "$KLEN" -le 63 ] || fail "password must be 8-63 characters"
    fi
    uci set wireless.$IOTSEC.disabled="$([ "$EN" = "1" ] && echo 0 || echo 1)"
    uci set wireless.$IOTSEC.ssid="$SSID"
    [ -n "$KEY" ] && uci set wireless.$IOTSEC.key="$KEY"
    uci commit wireless
    logger -t settings "secondary network ($IOTSEC) applied via web UI"
    ( sleep 1; wifi reload ${IOTRADIO:-} ) >/dev/null 2>&1 &
    printf '{"ok":true}'
    exit 0
fi

if [ "$ACTION" = "setlan" ]; then
    IP=$(qs_get_dec ipaddr)
    DSTART=$(qs_get_dec start); DLIMIT=$(qs_get_dec limit); DLEASE=$(qs_get_dec leasetime)
    # IPv4, each octet 0-255, and a private /24 whose host part is not .0/.255
    printf '%s' "$IP" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || fail "bad router address"
    O1=${IP%%.*}; R=${IP#*.}; O2=${R%%.*}; R=${R#*.}; O3=${R%%.*}; O4=${R##*.}
    for o in $O1 $O2 $O3 $O4; do [ "$o" -le 255 ] || fail "bad router address"; done
    case "$O1.$O2" in 10.*|192.168|172.1[6-9]|172.2[0-9]|172.3[01]) ;; *) fail "router address must be a private range" ;; esac
    [ "$O4" -ge 1 ] && [ "$O4" -le 254 ] || fail "router address host part must be 1-254"
    case "$DSTART" in ''|*[!0-9]*) fail "bad DHCP start" ;; esac
    case "$DLIMIT" in ''|*[!0-9]*) fail "bad DHCP size" ;; esac
    [ "$DSTART" -ge 2 ] && [ "$DSTART" -le 254 ] || fail "DHCP start must be 2-254"
    [ "$DLIMIT" -ge 1 ] && [ $((DSTART + DLIMIT - 1)) -le 254 ] || fail "DHCP range runs past .254"
    # The router must not sit inside its own pool
    [ "$O4" -ge "$DSTART" ] && [ "$O4" -le $((DSTART + DLIMIT - 1)) ] && fail "the pool would contain the router address"
    case "$DLEASE" in 30m|1h|6h|12h|24h|72h) ;; *) fail "bad lease time" ;; esac

    OLDIP=$(uci -q get network.lan.ipaddr)

    # The new subnet must not overlap anything else this router routes. Nothing
    # here used to check, and there are two distinct ways it bites:
    #
    #   live addresses  — the WAN, a tethered modem, a joined hotel uplink. This
    #                     is the quiet one: the console still answers on the new
    #                     address while the default route stops leaving the
    #                     house, and nothing on screen says why. 192.168.1.1 is
    #                     the obvious thing to type and the likeliest upstream.
    #   configured ones — guest and iot hold addresses in UCI with no interface
    #                     up. Taking one of their subnets is a trap that springs
    #                     months later, the first time that network is enabled.
    #
    # Deliberately stricter than 31-tethering-clash, which weighs live routes
    # only: there, refusing an uplink over a dormant network would strand a
    # traveller, whereas here refusing an address costs one retype.
    if [ "$IP" != "$OLDIP" ]; then
        LANDEV=$(uci -q get network.$LANNET.device 2>/dev/null); [ -n "$LANDEV" ] || LANDEV=br-lan
        CONFLICT=$( {
            ip -4 -o addr show 2>/dev/null | awk -v skip="$LANDEV" '
                $2 != skip && $2 != "lo" { split($4, a, "/"); print a[1], a[2], $2 }'
            for _s in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=interface$/\1/p'); do
                [ "$_s" = "$LANNET" ] && continue
                _a=$(uci -q get network.$_s.ipaddr 2>/dev/null)
                case "$_a" in
                    ''|127.*) continue ;;
                    */*)      _pf=${_a#*/}; _a=${_a%%/*} ;;
                    *)        _pf=$(mask2pfx "$(uci -q get network.$_s.netmask 2>/dev/null)") ;;
                esac
                printf '%s %s %s\n' "$_a" "$_pf" "$_s"
            done
        } | while read -r _oa _op _on; do
            overlaps24 "$IP" "$_oa" "$_op" && { printf '%s (%s/%s)' "$_on" "$_oa" "$_op"; break; }
        done )
        [ -n "$CONFLICT" ] && fail "that subnet is already in use by $CONFLICT"
    fi

    uci set dhcp.lan.start="$DSTART"
    uci set dhcp.lan.limit="$DLIMIT"
    uci set dhcp.lan.leasetime="$DLEASE"
    uci commit dhcp
    if [ "$IP" != "$OLDIP" ]; then
        uci set network.lan.ipaddr="$IP"
        uci commit network
        # uhttpd binds the LAN address literally (2026-08-11, so it is not
        # exposed on WAN or a public IPv6). That address is about to change, so
        # it must move with it — otherwise the console keeps listening on an
        # address that no longer exists and this action locks the user out of
        # the very page they used to trigger it.
        if uci -q get uhttpd.main.listen_http | grep -q "$OLDIP"; then
            for _proto in http https; do
                _cur=$(uci -q get uhttpd.main.listen_$_proto)
                uci set uhttpd.main.listen_$_proto="$(printf '%s' "$_cur" | sed "s/$OLDIP/$IP/g")"
            done
            uci commit uhttpd
        fi
        logger -t settings "LAN address change $OLDIP -> $IP via web UI"
        # Answer first, move the network afterwards — the response must escape
        # on the old address before it stops existing.
        ( sleep 2; /etc/init.d/network reload; sleep 2; /etc/init.d/uhttpd reload; /etc/init.d/dnsmasq restart ) >/dev/null 2>&1 &
        printf '{"ok":true,"moved":"%s"}' "$(esc "$IP")"
    else
        logger -t settings "DHCP settings applied via web UI"
        /etc/init.d/dnsmasq restart >/dev/null 2>&1
        printf '{"ok":true}'
    fi
    exit 0
fi

if [ "$ACTION" = "setsys" ]; then
    HN=$(qs_get_dec hostname)
    ZN=$(qs_get_dec zonename)
    printf '%s' "$HN" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,22}[A-Za-z0-9])?$' || fail "hostname: letters, digits and hyphens only"
    TZ=""
    case "$ZN" in
        "Asia/Jakarta")        TZ="WIB-7" ;;
        "Asia/Makassar")       TZ="WITA-8" ;;
        "Asia/Jayapura")       TZ="WIT-9" ;;
        "Asia/Singapore")      TZ="<+08>-8" ;;
        "Asia/Tokyo")          TZ="JST-9" ;;
        "Asia/Dubai")          TZ="<+04>-4" ;;
        "Europe/London")       TZ="GMT0BST,M3.5.0/1,M10.5.0" ;;
        "Europe/Amsterdam")    TZ="CET-1CEST,M3.5.0,M10.5.0/3" ;;
        "America/New_York")    TZ="EST5EDT,M3.2.0,M11.1.0" ;;
        "America/Los_Angeles") TZ="PST8PDT,M3.2.0,M11.1.0" ;;
        "Australia/Sydney")    TZ="AEST-10AEDT,M10.1.0,M4.1.0/3" ;;
        "UTC")                 TZ="UTC0" ;;
        *) fail "unsupported time zone" ;;
    esac
    uci set system.@system[0].hostname="$HN"
    uci set system.@system[0].zonename="$ZN"
    uci set system.@system[0].timezone="$TZ"
    uci commit system
    /etc/init.d/system reload >/dev/null 2>&1
    echo "$HN" > /proc/sys/kernel/hostname 2>/dev/null
    logger -t settings "system settings applied via web UI (host=$HN tz=$ZN)"
    printf '{"ok":true}'
    exit 0
fi

if [ "$ACTION" = "reboot" ]; then
    logger -t settings "reboot requested via web UI"
    ( sleep 2; reboot ) >/dev/null 2>&1 &
    printf '{"ok":true}'
    exit 0
fi

[ -n "$ACTION" ] && fail "unknown action"

# --------------------------------------------------------------------- read --
NOW=$(date +%s)
UP=$(cut -d. -f1 /proc/uptime)

radio_json() {  # $1 = radioN
    R="$1"
    BAND=$(uci -q get wireless.$R.band)
    BN=$(band_num "$BAND")
    PHY=$(phy_of "$R")
    IFSEC=$(ap_section_of "$R")
    DIS=$(uci -q get wireless.$R.disabled); [ "$DIS" = "1" ] || DIS=0
    CH=$(uci -q get wireless.$R.channel)
    HT=$(uci -q get wireless.$R.htmode)
    TX=$(uci -q get wireless.$R.txpower)
    CTRY=$(uci -q get wireless.$R.country)
    SSID=$(uci -q get wireless.$IFSEC.ssid)
    ENC=$(uci -q get wireless.$IFSEC.encryption)
    IDIS=$(uci -q get wireless.$IFSEC.disabled); [ "$IDIS" = "1" ] || IDIS=0

    # live state: first AP interface on this band from `iw dev`
    CUR=$(iw dev 2>/dev/null | awk -v want="$BN" '
        /^\tInterface/ { isap=0; ch=0; band=0; next }
        /type AP/ { isap=1; next }
        /channel/ {
            ch=$2+0; g=$3; sub(/\(/,"",g); f=g+0
            match($0,/width: [0-9]+/); w=substr($0,RSTART+7,RLENGTH-7)+0
            match($0,/center1: [0-9]+/); c1=substr($0,RSTART+9,RLENGTH-9)+0
            band=(f<3000)?1:2; next
        }
        /txpower/ && isap && band==want && ch {
            printf "{\"channel\":%d,\"freq\":%d,\"width\":%d,\"center\":%d,\"txpower\":%d}", ch, f, w, c1, $2+0
            exit
        }')
    [ -n "$CUR" ] || CUR=null

    printf '{"id":"%s","band":"%s","disabled":%s,"channel":"%s","htmode":"%s","txpower":%s,"country":"%s",' \
        "$R" "$(esc "$BAND")" "$([ "$DIS" = "1" ] && echo true || echo false)" \
        "$(esc "$CH")" "$(esc "$HT")" \
        "$([ -n "$TX" ] && jnum "$TX" || echo null)" "$(esc "$CTRY")"
    printf '"gens":%s,"channels":%s,"current":%s,' "$(gens_of "$BN")" "$(chan_json "$BN")" "$CUR"
    printf '"ssid":"%s","enc":"%s","iface_disabled":%s}' \
        "$(esc "$SSID")" "$(esc "$ENC")" "$([ "$IDIS" = "1" ] && echo true || echo false)"
}

printf '{"ok":true,"ts":%s,' "$NOW"

RJ=""
for _r in $RADIOS; do RJ="$RJ${RJ:+,}$(radio_json "$_r")"; done
printf '"wireless":{"radios":[%s],' "$RJ"

# The secondary network is optional: emit null (not an empty object) so the UI
# can drop the panel entirely rather than render a form with nothing behind it.
IOTSEC=$(secondary_section)
if [ -n "$IOTSEC" ]; then
    IOT_SSID=$(uci -q get wireless.$IOTSEC.ssid)
    IOT_DIS=$(uci -q get wireless.$IOTSEC.disabled); [ "$IOT_DIS" = "1" ] || IOT_DIS=0
    IOT_DEV=$(uci -q get wireless.$IOTSEC.device)
    IOT_BAND=$(uci -q get wireless.$IOT_DEV.band)
    printf '"iot":{"ssid":"%s","disabled":%s,"band":"%s","network":"%s"}},' \
        "$(esc "$IOT_SSID")" "$([ "$IOT_DIS" = "1" ] && echo true || echo false)" \
        "$(esc "$IOT_BAND")" "$(esc "$(uci -q get wireless.$IOTSEC.network)")"
else
    printf '"iot":null},'
fi
printf '"lan":{"ipaddr":"%s","netmask":"%s","dhcp":{"start":%s,"limit":%s,"leasetime":"%s"}},' \
    "$(esc "$(uci -q get network.lan.ipaddr)")" "$(esc "$(uci -q get network.lan.netmask)")" \
    "$(jnum "$(uci -q get dhcp.lan.start)")" "$(jnum "$(uci -q get dhcp.lan.limit)")" \
    "$(esc "$(uci -q get dhcp.lan.leasetime)")"
printf '"system":{"hostname":"%s","zonename":"%s","uptime":%s,"ntp":%s},' \
    "$(esc "$(uci -q get system.@system[0].hostname)")" \
    "$(esc "$(uci -q get system.@system[0].zonename)")" \
    "$(jnum "$UP")" \
    "$([ "$(uci -q get system.ntp.enabled)" = "1" ] && echo true || echo false)"

# Whatever the last check found, plus the running firmware read locally so the
# panel can state that much even if nothing has ever been checked. `null` means
# never checked — distinct from "checked and up to date", which the UI must not
# blur into the same sentence.
. /etc/openwrt_release 2>/dev/null
printf '"software":{"running":"%s","revision":"%s","target":"%s","owut":%s,"check":%s}}' \
    "$(esc "$DISTRIB_RELEASE")" "$(esc "$DISTRIB_REVISION")" "$(esc "$DISTRIB_TARGET")" \
    "$(command -v owut >/dev/null 2>&1 && echo true || echo false)" \
    "$(cat "$UPDCACHE" 2>/dev/null || echo null)"
