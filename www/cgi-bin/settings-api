#!/bin/sh
# /www/cgi-bin/settings-api  —  curated router configuration.
#
# Read: one JSON with the configured values, the live radio state, and the
# capability data the UI needs to offer only REAL choices (channel list and
# per-channel maximum width are derived from `iw` at request time, never from
# a hardcoded Wi-Fi table).
#
# Writes are POST + same-origin, because every action here rewrites /etc/config
# and reloads a service. There is no password: the console is unauthenticated on
# the trusted LAN by design, and the same-origin check is what stops a web page
# you happen to be visiting from driving these endpoints through your browser.
#
# Validation lives HERE, not in the browser: channel must be one the radio can
# legally use, the width must fit that channel's contiguous block, the PHY
# generation must exist on that band. The UI filters for clarity; this file
# filters for safety.

# esc, jnum, fail, read_body, urldec, qs_get, qs_get_dec, guard_post — one copy,
# shared with every other endpoint. Tested for readability rather than sourced
# blind: busybox ash treats `.` as a special builtin, so a missing file aborts
# the script outright and an `|| fallback` after it never runs. Without the
# check the failure is a 500 with an empty body and nothing in the log.
BERYL_LIB=/usr/share/beryl/cgi-lib.sh
if [ -r "$BERYL_LIB" ]; then
    . "$BERYL_LIB"
else
    printf 'Content-Type: application/json\r\n'
    printf 'Cache-Control: no-store\r\n\r\n'
    printf '{"ok":false,"error":"missing %s - reinstall the console"}' "$BERYL_LIB"
    exit 0
fi

POST_MAX=4096

# ---- wireless topology discovery --------------------------------------------
# Nothing below may assume a vendor's section names or radio ordering. GL.iNet
# ships main2g/main5g/iot2g; stock OpenWrt generates default_radio0/1; a
# hand-written config uses whatever the author typed. Likewise radio0 is not
# necessarily 2.4 GHz — band comes from the radio, never from the index.
LANNET=lan

wifi_sections() { uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'; }
RADIOS=$(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p')

# The AP section a radio's SSID settings belong to: prefer one on the primary
# network, else the radio's first AP. Empty means the radio has no AP at all.
ap_section_of() {   # $1 = radioN
    _first=""
    for _s in $(wifi_sections); do
        [ "$(uci -q get wireless.$_s.device 2>/dev/null)" = "$1" ] || continue
        _m=$(uci -q get wireless.$_s.mode 2>/dev/null)
        [ -z "$_m" ] || [ "$_m" = "ap" ] || continue
        [ -n "$_first" ] || _first="$_s"
        if [ "$(uci -q get wireless.$_s.network 2>/dev/null)" = "$LANNET" ]; then
            printf '%s' "$_s"; return 0
        fi
    done
    printf '%s' "$_first"
}

# EVERY AP that is not on the primary network, one per line, in uci order.
#
# This used to return the FIRST one and stop, which was true right up until there
# were two. Adding a guest SSID beside the IoT one made "the secondary network"
# an ordering accident: whichever section uci happened to list first became the
# one the Settings page edited and the one the repeater hook switched off, and
# the other was invisible and unmanaged. Nothing announced the swap.
#
# So the plural is the honest shape, and it is derived at runtime rather than
# from any list of names — a router with none emits an empty list and the UI
# renders no panel, exactly as before; a router with three gets three.
secondary_sections() {
    for _s in $(wifi_sections); do
        _m=$(uci -q get wireless.$_s.mode 2>/dev/null)
        [ -z "$_m" ] || [ "$_m" = "ap" ] || continue
        _n=$(uci -q get wireless.$_s.network 2>/dev/null)
        [ -n "$_n" ] && [ "$_n" != "$LANNET" ] && printf '%s\n' "$_s"
    done
}

# The distinct NETWORKS those sections belong to, in first-seen order.
#
# A network is the unit the owner thinks in - "my guest Wi-Fi" - while a section
# is one AP on one radio, and a single SSID on 2.4 and 5 GHz is two sections. If
# the page were keyed on sections it would show two panels both titled "Guest
# network", and changing the password on one and not the other would leave one
# SSID with two passwords: a failure that looks like a broken client.
secondary_networks() {
    _seen=""
    for _s in $(secondary_sections); do
        _n=$(uci -q get wireless.$_s.network 2>/dev/null)
        [ -n "$_n" ] || continue
        case " $_seen " in *" $_n "*) continue ;; esac
        _seen="$_seen $_n"
        printf '%s\n' "$_n"
    done
}

# Every secondary section on one network - what a write has to apply to.
sections_of_net() {   # $1 = network name
    for _s in $(secondary_sections); do
        [ "$(uci -q get wireless.$_s.network 2>/dev/null)" = "$1" ] && printf '%s\n' "$_s"
    done
}

# Is this a network the forms below are allowed to touch? Every write takes the
# network from the request, so this is what stops a hand-made POST naming the
# primary network and reconfiguring it through the guest form.
is_secondary_net() {
    [ -n "$1" ] || return 1
    secondary_networks | grep -qxF "$1"
}

# The mac80211 phy backing a radio — `iw phy` capability queries are per-phy.
# Single-phy boards (this one, and most dual-band routers) short-circuit; only
# genuinely multi-phy hardware pays for the ubus lookup.
phy_of() {   # $1 = radioN
    _n=0; _only=""
    for _p in /sys/class/ieee80211/*; do
        [ -d "$_p" ] || continue
        _n=$((_n+1)); _only=${_p##*/}
    done
    [ "$_n" = "1" ] && { printf '%s' "$_only"; return 0; }
    _if=$(ubus call network.wireless status 2>/dev/null | awk -v want="$1" '
        /^\t"/ { gsub(/[\t":{ ]/,""); dev=$0 }
        /"ifname":/ { if (dev==want) { gsub(/[",]/,""); print $2; exit } }')
    if [ -n "$_if" ]; then
        _pn=$(cat "/sys/class/net/$_if/phy80211/name" 2>/dev/null)
        [ -n "$_pn" ] && { printf '%s' "$_pn"; return 0; }
    fi
    printf 'phy%s' "${1#radio}"
}
PHY=$(phy_of "$(printf '%s' "$RADIOS" | head -n1)")

# -------------------------------------------------------------------- IPv6 --
# Four modes, deliberately the same four a GL.iNet router offers, because that
# is the vocabulary the owner already has. What differs is that this file will
# not offer a mode the uplink cannot actually deliver — see v6_can_native.
#
#   off          LAN devices get no IPv6 at all. The router keeps its own v6
#                uplink (DoH resolvers and ping targets use it), so this is
#                "my devices have no IPv6", not "the router has none".
#   passthrough  odhcpd relays the uplink's RA/DHCPv6 and proxies NDP, so LAN
#                clients take addresses straight out of the ISP's /64. The only
#                mode that yields real public IPv6 without prefix delegation.
#   native       odhcpd serves a subnet of a DELEGATED prefix. Needs the ISP to
#                hand out a prefix; Indosat does not, hence the capability probe.
#   nat6         LAN uses the ULA and the uplink zone masquerades v6. Works with
#                no delegation, but every client is behind a v6 NAT.
#
# Nothing below hardcodes "wan6", "br-lan" or a zone index: the v6 uplink is
# whichever dhcp section declares itself master, the LAN device comes from ubus,
# and the firewall zone is found by name because @zone[N] shifts when a zone is
# added.
v6_master() {
    uci -q show dhcp 2>/dev/null | sed -n "s/^dhcp\.\([^.=]*\)\.master='1'$/\1/p" | head -n1
}
wan_zone_idx() {
    _i=0
    while :; do
        _zn=$(uci -q get firewall.@zone[$_i].name 2>/dev/null)
        [ -n "$_zn" ] || break
        [ "$_zn" = "wan" ] && { printf '%s' "$_i"; return 0; }
        _i=$((_i+1))
        [ "$_i" -gt 32 ] && break
    done
    printf ''
}
lan_dev() {
    _d=$(ubus call network.interface.$LANNET status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
    [ -n "$_d" ] && printf '%s' "$_d" || printf 'br-%s' "$LANNET"
}
v6_mode() {
    _ra=$(uci -q get dhcp.$LANNET.ra 2>/dev/null)
    _z=$(wan_zone_idx); _m6=""
    [ -n "$_z" ] && _m6=$(uci -q get firewall.@zone[$_z].masq6 2>/dev/null)
    case "$_ra" in
        relay)  printf 'passthrough' ;;
        server) [ "$_m6" = "1" ] && printf 'nat6' || printf 'native' ;;
        *)      printf 'off' ;;
    esac
}
# A delegated prefix is what separates "native will work" from "native gives
# your devices a ULA and no route out". Read live, never assumed.
v6_can_native() {
    _m=$(v6_master); [ -n "$_m" ] || { printf 'false'; return; }
    _pd=$(ubus call network.interface.$_m status 2>/dev/null |
          jsonfilter -e '@["ipv6-prefix"][*].address' 2>/dev/null | head -n1)
    [ -n "$_pd" ] && printf 'true' || printf 'false'
}
v6_uplink_up() {
    _m=$(v6_master); [ -n "$_m" ] || { printf 'false'; return; }
    _a=$(ubus call network.interface.$_m status 2>/dev/null |
         jsonfilter -e '@["ipv6-address"][*].address' 2>/dev/null | head -n1)
    [ -n "$_a" ] && printf 'true' || printf 'false'
}

# ---- the RA DNS on-link check ------------------------------------------------
# Why this exists: in relay mode odhcpd copies the uplink's RA verbatim, RDNSS
# option included. Indosat advertises fe80::1 — its own link-local, meaningful
# only on the WAN link. Relayed onto the LAN it names an address no host there
# holds, so every client is told to use a DNS server that can never answer.
# Android treats an RA-learned DNS server going unreachable as loss of
# provisioning and restarts its whole stack, which cost a day to find by packet
# capture. A link-local that the router does not itself hold is the signature,
# and it is decidable from configuration alone — no probing, no packets, cheap
# enough to run on every poll.
ra6_json() {
    _mode=$(v6_mode)
    if [ "$_mode" = "off" ]; then
        printf '{"verdict":"off","source":null,"servers":[]}'; return
    fi
    _dev=$(lan_dev)
    # What the router itself holds on the LAN link. An advertised address in
    # this set is answerable by definition.
    _own=$(ip -6 addr show dev "$_dev" 2>/dev/null | sed -n 's#^ *inet6 \([^/ ]*\)/.*#\1#p')
    # Precedence matches odhcpd's: an explicit list wins; otherwise relay hands
    # on whatever the uplink said; otherwise odhcpd announces itself.
    _src=override
    _list=$(uci -q get dhcp.$LANNET.dns 2>/dev/null)
    if [ -z "$_list" ]; then
        if [ "$_mode" = "passthrough" ]; then
            _src=upstream
            _m=$(v6_master)
            [ -n "$_m" ] && _list=$(ubus call network.interface.$_m status 2>/dev/null |
                jsonfilter -e '@["dns-server"][*]' 2>/dev/null | tr '\n' ' ')
        else
            _src=router
            _list=$(printf '%s' "$_own" | grep -v '^fe80' | head -n1)
        fi
    fi
    _bad=0; _n=0; _out=""
    for _a in $_list; do
        [ -n "$_a" ] || continue
        _cls=remote
        if printf '%s\n' "$_own" | grep -qx "$_a"; then
            _cls=router
        else
            case "$_a" in
                fe80:*|FE80:*)
                    # A foreign link-local on this link. Nothing can make this
                    # work: link-local scope does not cross the router.
                    _cls=offlink; _bad=1 ;;
            esac
        fi
        _out="$_out${_out:+,}{\"addr\":\"$(esc "$_a")\",\"class\":\"$_cls\"}"
        _n=$((_n+1))
    done
    if [ "$_n" = 0 ]; then
        _v=none
    elif [ "$_bad" = 1 ]; then
        _v=fault
    else
        _v=ok
    fi
    printf '{"verdict":"%s","source":"%s","device":"%s","servers":[%s]}' \
        "$_v" "$_src" "$(esc "$_dev")" "$_out"
}

# ------------------------------------------------------------------ backup --
# Handled before the JSON headers because this response is a file, not JSON.
# A GET, like `logs`: it reads configuration and changes nothing. The archive
# does hold secrets — Wi-Fi keys, tunnel keys — but every page of this console
# already does, it is unauthenticated on the trusted LAN by design, and a
# foreign origin can cause the request without ever being handed the bytes.
# This is the same archive `sysupgrade -b` writes and LuCI hands you, so the
# restore path is the ordinary one and nothing here invents a format.
case "&$QUERY_STRING&" in
    *"&action=backup&"*)
        BK="/tmp/beryl-backup-$$.tar.gz"
        if sysupgrade -b "$BK" >/dev/null 2>&1 && [ -s "$BK" ]; then
            printf 'Content-Type: application/x-gzip\r\n'
            printf 'Content-Disposition: attachment; filename="%s-backup-%s.tar.gz"\r\n' \
                "$(uci -q get system.@system[0].hostname 2>/dev/null || echo openwrt)" \
                "$(date +%Y%m%d-%H%M%S)"
            printf 'Content-Length: %s\r\n' "$(wc -c < "$BK")"
            printf 'Cache-Control: no-store\r\n\r\n'
            cat "$BK"
        else
            printf 'Content-Type: application/json\r\n'
            printf 'Cache-Control: no-store\r\n\r\n'
            printf '{"ok":false,"error":"sysupgrade -b failed, so there is no archive to download. Run it over SSH to see its own error — usually the overlay is full."}'
        fi
        rm -f "$BK"
        exit 0
        ;;
esac

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n\r\n'

read_body

ACTION=$(qs_get action)
case "$ACTION" in
    "") ;;
    # `logs` reads the ring buffer and changes nothing, so it stays a GET like
    # repeater `scan` does. The POST rule exists to stop a foreign page issuing
    # a write through your browser; a read cannot be turned into one, and the
    # browser will not hand the response to another origin anyway.
    logs) ;;
    *) [ "$REQUEST_METHOD" = "POST" ] || fail "POST required" ;;
esac
[ "$REQUEST_METHOD" = "POST" ] && guard_post

UPDCACHE=/tmp/.updcheck

# ------------------------------------------------------------------- logs --
# Away from home the honest answer to "why is there no internet" lives in the
# ring buffer, and reaching it used to mean SSH — i.e. a laptop. Newest first,
# because the reason you are looking is almost always the last thing that
# happened. Filtering is by severity rather than by text: on a quiet router the
# interesting lines are rare and you do not know the word to search for yet.
if [ "$ACTION" = "logs" ]; then
    LVL=$(qs_get level); N=$(qs_get n)
    case "$N" in ''|*[!0-9]*) N=200 ;; esac
    [ "$N" -gt 300 ] && N=300
    case "$LVL" in err|warn) ;; *) LVL=all ;; esac
    printf '{"ok":true,"level":"%s","lines":' "$LVL"
    # One `logread`, not two. This endpoint is polled every few seconds, and
    # dumping the whole ring buffer a second time just to count its lines was
    # most of the cost. Snapshot to tmpfs, then count and filter from that.
    LT="/tmp/.logsnap.$$"
    # Ask logd for the WINDOW, not the whole ring. `logread -l N` returns the
    # last N messages, so this cost stays flat however large log_size grows —
    # the full dump scaled with it, and this endpoint is re-read every 4s the
    # whole time the log panel is on screen. Measured against a 242KB buffer:
    # full dump 89ms, `-l 900` 40ms, and the gap widens as the buffer fills.
    # Falls back to the full dump if a build's logread lacks -l, rather than
    # rendering an empty log.
    logread -l 900 > "$LT" 2>/dev/null
    [ -s "$LT" ] || logread > "$LT" 2>/dev/null
    # The true buffer depth is the one thing that still needs a full read, so it
    # is computed only when asked for. The panel wants it once, to say "150 of
    # N lines"; it does not need it recomputed on every four-second refresh.
    if [ "$(qs_get total)" = "1" ]; then
        LTOT=$(logread 2>/dev/null | wc -l); case "$LTOT" in ''|*[!0-9]*) LTOT=0 ;; esac
    else
        LTOT=-1
    fi
    # Read a wide window and filter inside awk: a severity filter applied after
    # `tail` would return almost nothing, since warnings are sparse by design.
    tail -n 900 "$LT" | awk -v want="$LVL" -v lim="$N" '
        function jesc(s) {
            # Both of these use the "\\&" form — emit a literal backslash, then
            # re-emit the matched character — because it is the only spelling
            # POSIX actually defines and both awks implement.
            #
            # The obvious spellings are each broken here:
            #   gsub(/"/,  "\\\"", s)  busybox drops the backslash entirely (a
            #                          backslash before a non-special char is
            #                          undefined), so quotes came through raw
            #                          and any log line containing one produced
            #                          invalid JSON. gawk kept it, and gawk was
            #                          on this router until banip took it away.
            #   gsub(/\\/, "\\\\", s)  emits ONE backslash, not two — a no-op
            #                          that never escaped anything, on any awk.
            #
            # Order matters: backslashes first, or the ones added by the quote
            # pass would be escaped a second time.
            gsub(/\\/, "\\\\&", s); gsub(/"/, "\\\\&", s)
            # [[:cntrl:]], not [\000-\037]: busybox awk cannot parse an octal
            # escape inside a bracket expression and dies with "bad regex '['",
            # taking the whole array with it and emitting "lines":, — invalid
            # JSON, so the panel reports the log as unreadable. gawk accepted
            # it, and gawk was on this router until it was pulled in as an
            # orphaned dependency of banip on 2026-08-11. POSIX class works on
            # both.
            gsub(/\t/, " ", s); gsub(/[[:cntrl:]]/, "", s)
            return s
        }
        NF > 7 {
            lvl = $6; sub(/^[^.]*\./, "", lvl)
            keep = (want == "all")
            if (!keep && lvl ~ /^(emerg|alert|crit|err)/) keep = 1
            if (!keep && want == "warn" && lvl ~ /^warn/) keep = 1
            if (!keep) next
            src = $7; sub(/:$/, "", src)
            msg = ""
            for (i = 8; i <= NF; i++) msg = msg (i > 8 ? " " : "") $i
            buf[++n] = "{\"t\":\"" $4 "\",\"d\":\"" $2 " " $3 "\",\"lvl\":\"" jesc(lvl) \
                       "\",\"src\":\"" jesc(src) "\",\"msg\":\"" jesc(msg) "\"}"
        }
        END {
            printf "["
            c = 0
            for (i = n; i > 0 && c < lim; i--) { printf "%s%s", (c++ ? "," : ""), buf[i] }
            printf "]"
        }'
    rm -f "$LT"
    printf ',"total":%s}' "$LTOT"
    exit 0
fi

# ---------------------------------------------------------- update check --
# owut talks to the ASU build server, so this is seconds, not milliseconds — far
# too slow for the 5s poll. It runs only when asked and caches the reading; the
# status payload serves that cache for free, and the panel says when it was
# taken. An instrument that cannot say how old its reading is invites you to
# trust a stale one.
if [ "$ACTION" = "updcheck" ]; then
    if ! command -v owut >/dev/null 2>&1; then
        printf '{"ok":false,"error":"owut is not installed — add attendedsysupgrade-common"}'
        exit 0
    fi
    if command -v timeout >/dev/null 2>&1; then
        OUT=$(timeout 60 owut check --verbose 2>&1)
    else
        OUT=$(owut check --verbose 2>&1)
    fi
    # owut's verbose output is sectioned, and the same facts are worded
    # differently with and without --verbose. Parse by section rather than by
    # sentence: a header opens one, any unindented line closes it, and the
    # indented rows between are the data. Guessing from a summary sentence is
    # how "1 modified default package" got read as something it was not.
    UJ=$(printf '%s\n' "$OUT" | awk -v ts="$(date +%s)" '
        function jesc(s) { gsub(/\\/, "\\\\&", s); gsub(/"/, "\\\\&", s); return s }
        /^Package version changes:/  { sec = "ver"; next }
        /^Default package analysis:/ { sec = "def"; next }
        /^There are currently package build failures/ { sec = ""; next }
        /^[^ \t]/ { sec = "" }
        /^Version-from/ { $1 = ""; sub(/^ +/, ""); from  = $0 }
        /^Version-to/   { $1 = ""; sub(/^ +/, ""); to    = $0 }
        /^Target/       { tgt   = $2 }
        /^Profile/      { prof  = $2 }
        /^Build-at/     { $1 = ""; sub(/^ +/, ""); built = $0 }
        /^Image-file/   { img   = $2 }
        /packages are out-of-date/ { ood = $1 + 0 }
        # Keep owut'"'"'s own closing sentence rather than reducing it to a guess.
        # The first version matched only "It is safe to proceed", so the better
        # outcome — "There are no changes, upgrade not necessary" — was read as
        # unsafe. Only an explicit "not safe" is treated as one.
        /safe to proceed|upgrade not necessary|not safe/ {
            verdict = $0
            safe = ($0 ~ /not safe/) ? 0 : 1
        }
        # "name  installed  available"
        sec == "ver" && /^[ \t]+[A-Za-z0-9]/ && NF == 3 {
            pk = pk (pc++ ? "," : "") "{\"name\":\"" jesc($1) "\",\"from\":\"" jesc($2) "\",\"to\":\"" jesc($3) "\"}"
        }
        # "default-package  provided-by" — a stock package satisfied by a
        # different one. Its own column header is skipped by name.
        sec == "def" && /^[ \t]+[A-Za-z0-9]/ && NF == 2 && $1 != "Default" {
            sb = sb (sc++ ? "," : "") "{\"name\":\"" jesc($1) "\",\"by\":\"" jesc($2) "\"}"
        }
        END {
            printf "{\"checked\":%s,\"from\":\"%s\",\"to\":\"%s\",\"target\":\"%s\",\"profile\":\"%s\",", \
                ts, jesc(from), jesc(to), jesc(tgt), jesc(prof)
            printf "\"built\":\"%s\",\"image\":\"%s\",\"safe\":%s,\"verdict\":\"%s\",\"outdated\":%d,", \
                jesc(built), jesc(img), (safe ? "true" : "false"), jesc(verdict), ood
            printf "\"packages\":[%s],\"substituted\":[%s]}", pk, sb
        }')
    case "$UJ" in
        '{'*) printf '%s' "$UJ" > "$UPDCACHE"; printf '{"ok":true,"update":%s}' "$UJ" ;;
        *)    printf '{"ok":false,"error":"owut ran but printed nothing this page can parse — the check result is unknown, not \\"up to date\\". Run owut check over SSH to see the raw output."}' ;;
    esac
    exit 0
fi

# -------------------------------------------------------- package upgrade --
# Named packages only, never a blanket upgrade. The check above already says
# exactly which ones are behind, and upgrading only those keeps the blast radius
# equal to what the panel showed — a bare `apk upgrade` would be a different,
# larger action than the one the button offered.
if [ "$ACTION" = "pkgupgrade" ]; then
    command -v apk >/dev/null 2>&1 || fail "apk is not available on this build"
    NAMES=$(qs_get_dec names)
    [ -n "$NAMES" ] || fail "nothing to upgrade"
    # Package names, spaces between. Anything else is refused rather than
    # escaped: this string reaches a command line.
    printf '%s' "$NAMES" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._+ -]*$' || fail "bad package list"
    apk update >/dev/null 2>&1 || fail "could not refresh the package index — is the router online?"
    OUT=$(apk upgrade $NAMES 2>&1)
    RC=$?
    # The cached reading is now wrong whatever happened; drop it rather than
    # let the panel keep showing a version that may have just changed.
    rm -f "$UPDCACHE"
    if [ "$RC" = "0" ]; then
        printf '{"ok":true,"action":"pkgupgrade","detail":"%s"}' \
            "$(esc "$(printf '%s' "$OUT" | grep -iE '^\([0-9]+/[0-9]+\)|^OK:' | tr '\n' ' ')")"
    else
        printf '{"ok":false,"error":"%s"}' \
            "$(esc "$(printf '%s' "$OUT" | grep -iE 'error|ERROR' | head -1)")"
    fi
    exit 0
fi

# ---------------------------------------------------------------- capability --
# Channel list with a computed per-channel MAXIMUM width. A width is valid only
# when every channel of its standard contiguous block is present and usable, so
# regulatory gaps (disabled ranges, No-IR) shrink the offer automatically.
# One awk owns the block maths for both the read and the write path, so the
# browser can never smuggle a width past what the offer was computed from.
# With pick="" it prints the channel list as JSON; with pick=<channel> it
# prints that channel's maximum width as a bare number.
chan_calc() {   # $1 = iw band number (1=2.4GHz, 2=5GHz), $2 = pick (optional)
    iw phy $PHY channels 2>/dev/null | awk -v want="$1" -v pick="${2:-}" '
    /^[\t ]*Band [0-9]+:/ { band=$2+0; next }
    /\* [0-9]+ MHz \[[0-9]+\]/ {
        if (band != want) { cur=0; next }
        f=$2+0; match($0,/\[[0-9]+\]/); c=substr($0,RSTART+1,RLENGTH-2)+0
        cur=c; freq[c]=f; disab[c]=($0 ~ /\(disabled\)/)?1:0; order[++n]=c; next
    }
    /No IR/          { if (band==want && cur) disab[cur]=1 }
    /[Rr]adar detection/ { if (band==want && cur) dfs[cur]=1 }
    END {
        for (i=1;i<=n;i++) { c=order[i]; if (!disab[c]) ok[c]=1 }
        for (i=1;i<=n;i++) {
            c=order[i]; if (disab[c]) continue
            w=20
            if (want==1) {
                if (ok[c-4] || ok[c+4]) w=40
            } else {
                base = (c>=149) ? 149 : 36
                b40 = c - ((c-base)%8);  if (ok[b40] && ok[b40+4]) w=40
                b80 = c - ((c-base)%16)
                if (w==40 && ok[b80] && ok[b80+4] && ok[b80+8] && ok[b80+12]) w=80
                if (w==80) { b160 = c - ((c-base)%32); good=1
                    for (m=0;m<32;m+=4) if (!ok[b160+m]) good=0
                    if (good) w=160
                }
            }
            maxw[c]=w
        }
        if (pick != "") { print (pick in maxw) ? maxw[pick] : 0; exit }
        printf "["
        out=0
        for (i=1;i<=n;i++) {
            c=order[i]; if (disab[c]) continue
            printf "%s{\"c\":%d,\"f\":%d,\"maxw\":%d%s}", (out++?",":""), c, freq[c], maxw[c], (dfs[c]?",\"dfs\":true":"")
        }
        printf "]"
    }'
}
chan_json() { chan_calc "$1"; }
maxw_of()  { chan_calc "$1" "$2"; }

# PHY generations actually present on a band, from the capability blocks.
# The HT marker is its MCS table — `iw` prints HT caps as a bare
# "Capabilities:" line, so the literal string "HT Capabilities" never appears.
gens_of() {     # $1 = iw band number
    iw phy $PHY info 2>/dev/null | awk -v want="$1" '
    /^[\t ]*Band [0-9]+:/ { band=$2+0; next }
    band==want && /HT TX\/RX MCS rate indexes/ { g["HT"]=1 }
    band==want && /VHT Capabilities/           { g["VHT"]=1 }
    band==want && /HE PHY Capabilities/        { g["HE"]=1 }
    band==want && /EHT PHY Capabilities/       { g["EHT"]=1 }
    END {
        printf "["
        n=0
        split("HT VHT HE EHT", ord, " ")
        for (i=1;i<=4;i++) if (ord[i] in g) printf "%s\"%s\"", (n++?",":""), ord[i]
        printf "]"
    }'
}
# iw band numbers: 1 = 2.4 GHz, 2 = 5 GHz, 4 = 6 GHz (3 is 60 GHz).
band_num() { case "$1" in 2g) echo 1 ;; 6g) echo 4 ;; *) echo 2 ;; esac; }

# --------------------------------------------------------- subnet arithmetic --
ip2int() {   # dotted quad -> 32-bit integer
    _o1=${1%%.*}; _r=${1#*.}; _o2=${_r%%.*}; _r=${_r#*.}; _o3=${_r%%.*}; _o4=${_r##*.}
    printf '%s' $(( (_o1 << 24) + (_o2 << 16) + (_o3 << 8) + _o4 ))
}
mask2pfx() {   # dotted netmask -> prefix length; a contiguous mask's length is
               # just its population count. Unparseable falls back to /24, the
               # only netmask this endpoint ever writes.
    case "$1" in ''|*[!0-9.]*) printf 24; return ;; esac
    _m=$(ip2int "$1"); _p=0; _i=0
    while [ "$_i" -lt 32 ]; do _p=$(( _p + ((_m >> _i) & 1) )); _i=$((_i + 1)); done
    printf '%s' "$_p"
}
# Do a.b.c.d/24 and $2/$3 share any address?
overlaps24() {   # $1 = new LAN address  $2 = other address  $3 = other prefix
    [ "$3" -ge 8 ] 2>/dev/null || return 1
    _p=$3; [ "$_p" -gt 24 ] && _p=24
    _k=$(( (4294967295 << (32 - _p)) & 4294967295 ))
    [ $(( $(ip2int "$1") & _k )) -eq $(( $(ip2int "$2") & _k )) ]
}

# ------------------------------------------------------------------- writes --
if [ "$ACTION" = "setwifi" ]; then
    RADIO=$(qs_get_dec radio)
    _okr=0
    for _r in $RADIOS; do [ "$_r" = "$RADIO" ] && { _okr=1; break; }; done
    [ "$_okr" = "1" ] || fail "bad radio"
    BAND=$(uci -q get wireless.$RADIO.band)
    BN=$(band_num "$BAND")
    PHY=$(phy_of "$RADIO")
    IFSEC=$(ap_section_of "$RADIO")
    [ -n "$IFSEC" ] || fail "this radio has no access point configured"

    EN=$(qs_get_dec enabled); case "$EN" in 0|1) ;; *) fail "bad enabled flag" ;; esac
    SSID=$(qs_get_dec ssid | tr -d '\n\r\t')
    KEY=$(qs_get_dec key | tr -d '\n\r')
    CH=$(qs_get_dec channel)
    HT=$(qs_get_dec htmode)
    TX=$(qs_get_dec txpower)

    SLEN=$(printf '%s' "$SSID" | wc -c)
    [ "$SLEN" -ge 1 ] && [ "$SLEN" -le 32 ] || fail "network name must be 1-32 characters"
    if [ -n "$KEY" ]; then
        KLEN=$(printf '%s' "$KEY" | wc -c)
        [ "$KLEN" -ge 8 ] && [ "$KLEN" -le 63 ] || fail "password must be 8-63 characters"
    fi
    case "$CH" in ''|*[!0-9]*) fail "bad channel" ;; esac
    MAXW=$(maxw_of "$BN" "$CH"); MAXW=$(jnum "$MAXW")
    [ "$MAXW" -ge 20 ] || fail "channel $CH is not available on this band"

    GEN=$(printf '%s' "$HT" | sed 's/[0-9]*$//'); W=$(printf '%s' "$HT" | sed 's/^[A-Z]*//')
    case "$GEN" in HT|VHT|HE|EHT) ;; *) fail "bad mode" ;; esac
    case "$W" in 20|40|80|160) ;; *) fail "bad width" ;; esac
    [ "$GEN" = "HT" ] && [ "$W" -gt 40 ] && fail "HT supports 20 or 40 MHz only"
    gens_of "$BN" | grep -q "\"$GEN\"" || fail "$GEN is not supported on this band"
    [ "$W" -le "$MAXW" ] || fail "channel $CH supports at most $MAXW MHz"

    if [ -n "$TX" ]; then
        case "$TX" in *[!0-9]*) fail "bad transmit power" ;; esac
        [ "$TX" -ge 1 ] && [ "$TX" -le 30 ] || fail "transmit power out of range"
    fi

    uci set wireless.$RADIO.disabled="$([ "$EN" = "1" ] && echo 0 || echo 1)"
    uci set wireless.$RADIO.channel="$CH"
    uci set wireless.$RADIO.htmode="$HT"
    if [ -n "$TX" ]; then uci set wireless.$RADIO.txpower="$TX"
    else uci -q delete wireless.$RADIO.txpower; fi
    uci set wireless.$IFSEC.ssid="$SSID"
    [ -n "$KEY" ] && uci set wireless.$IFSEC.key="$KEY"
    uci commit wireless
    logger -t settings "wifi $RADIO applied via web UI (ch=$CH $HT)"
    # the whole subshell must drop stdout, or uhttpd holds the response open
    # until the reload finishes
    wifi_reloading
    ( sleep 1; wifi reload $RADIO ) >/dev/null 2>&1 &
    # Echo the committed values back: proof the write landed, not just that the
    # request arrived. The radio itself confirms on the next status poll.
    printf '{"ok":true,"applied":{"channel":"%s","htmode":"%s","ssid":"%s"}}' \
        "$(esc "$CH")" "$(esc "$HT")" "$(esc "$SSID")"
    exit 0
fi

if [ "$ACTION" = "setiot" ]; then
    # Named by NETWORK, and applied to every AP on it. A guest SSID that lives
    # on both radios is two wifi-iface sections and one network, and they have
    # to move together: a client caches its security profile per SSID, so two
    # bands under one name with different passwords is a device that connects
    # on one band and silently fails on the other.
    IOTNET=$(qs_get_dec network | tr -d '\n\r\t')
    [ -n "$IOTNET" ] || IOTNET=$(secondary_networks | head -1)
    [ -n "$IOTNET" ] || fail "no secondary network is configured on this router"
    is_secondary_net "$IOTNET" || fail "that is not a secondary network on this router"
    IOTSECS=$(sections_of_net "$IOTNET")
    [ -n "$IOTSECS" ] || fail "that network has no access point to configure"
    EN=$(qs_get_dec enabled); case "$EN" in 0|1) ;; *) fail "bad enabled flag" ;; esac
    SSID=$(qs_get_dec ssid | tr -d '\n\r\t')
    KEY=$(qs_get_dec key | tr -d '\n\r')
    SLEN=$(printf '%s' "$SSID" | wc -c)
    [ "$SLEN" -ge 1 ] && [ "$SLEN" -le 32 ] || fail "network name must be 1-32 characters"
    if [ -n "$KEY" ]; then
        KLEN=$(printf '%s' "$KEY" | wc -c)
        [ "$KLEN" -ge 8 ] && [ "$KLEN" -le 63 ] || fail "password must be 8-63 characters"
    fi
    IOTRADIOS=""
    for _sec in $IOTSECS; do
        uci set wireless.$_sec.disabled="$([ "$EN" = "1" ] && echo 0 || echo 1)"
        uci set wireless.$_sec.ssid="$SSID"
        [ -n "$KEY" ] && uci set wireless.$_sec.key="$KEY"
        _rd=$(uci -q get wireless.$_sec.device 2>/dev/null)
        case " $IOTRADIOS " in *" $_rd "*) ;; *) IOTRADIOS="$IOTRADIOS $_rd" ;; esac
    done
    uci commit wireless
    logger -t settings "secondary network '$IOTNET' applied via web UI ($(printf '%s' "$IOTSECS" | tr '\n' ' '))"
    wifi_reloading
    # One reload per DISTINCT radio: reloading per section would restart a
    # shared radio twice and the second would land mid-flight on the first.
    ( sleep 1; for _rd in $IOTRADIOS; do [ -n "$_rd" ] && wifi reload "$_rd"; done ) >/dev/null 2>&1 &
    printf '{"ok":true}'
    exit 0
fi

if [ "$ACTION" = "setlan" ]; then
    IP=$(qs_get_dec ipaddr)
    DSTART=$(qs_get_dec start); DLIMIT=$(qs_get_dec limit); DLEASE=$(qs_get_dec leasetime)
    # IPv4, each octet 0-255, and a private /24 whose host part is not .0/.255
    printf '%s' "$IP" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || fail "bad router address"
    O1=${IP%%.*}; R=${IP#*.}; O2=${R%%.*}; R=${R#*.}; O3=${R%%.*}; O4=${R##*.}
    for o in $O1 $O2 $O3 $O4; do [ "$o" -le 255 ] || fail "bad router address"; done
    case "$O1.$O2" in 10.*|192.168|172.1[6-9]|172.2[0-9]|172.3[01]) ;; *) fail "router address must be a private range" ;; esac
    [ "$O4" -ge 1 ] && [ "$O4" -le 254 ] || fail "router address host part must be 1-254"
    case "$DSTART" in ''|*[!0-9]*) fail "bad DHCP start" ;; esac
    case "$DLIMIT" in ''|*[!0-9]*) fail "bad DHCP size" ;; esac
    [ "$DSTART" -ge 2 ] && [ "$DSTART" -le 254 ] || fail "DHCP start must be 2-254"
    [ "$DLIMIT" -ge 1 ] && [ $((DSTART + DLIMIT - 1)) -le 254 ] || fail "DHCP range runs past .254"
    # The router must not sit inside its own pool
    [ "$O4" -ge "$DSTART" ] && [ "$O4" -le $((DSTART + DLIMIT - 1)) ] && fail "the pool would contain the router address"
    case "$DLEASE" in 30m|1h|6h|12h|24h|72h) ;; *) fail "bad lease time" ;; esac

    OLDIP=$(uci -q get network.lan.ipaddr)

    # The new subnet must not overlap anything else this router routes. Nothing
    # here used to check, and there are two distinct ways it bites:
    #
    #   live addresses  — the WAN, a tethered modem, a joined hotel uplink. This
    #                     is the quiet one: the console still answers on the new
    #                     address while the default route stops leaving the
    #                     house, and nothing on screen says why. 192.168.1.1 is
    #                     the obvious thing to type and the likeliest upstream.
    #   configured ones — guest and iot hold addresses in UCI with no interface
    #                     up. Taking one of their subnets is a trap that springs
    #                     months later, the first time that network is enabled.
    #
    # Deliberately stricter than 31-tethering-clash, which weighs live routes
    # only: there, refusing an uplink over a dormant network would strand a
    # traveller, whereas here refusing an address costs one retype.
    if [ "$IP" != "$OLDIP" ]; then
        LANDEV=$(uci -q get network.$LANNET.device 2>/dev/null); [ -n "$LANDEV" ] || LANDEV=br-lan
        CONFLICT=$( {
            ip -4 -o addr show 2>/dev/null | awk -v skip="$LANDEV" '
                $2 != skip && $2 != "lo" { split($4, a, "/"); print a[1], a[2], $2 }'
            for _s in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=interface$/\1/p'); do
                [ "$_s" = "$LANNET" ] && continue
                _a=$(uci -q get network.$_s.ipaddr 2>/dev/null)
                case "$_a" in
                    ''|127.*) continue ;;
                    */*)      _pf=${_a#*/}; _a=${_a%%/*} ;;
                    *)        _pf=$(mask2pfx "$(uci -q get network.$_s.netmask 2>/dev/null)") ;;
                esac
                printf '%s %s %s\n' "$_a" "$_pf" "$_s"
            done
        } | while read -r _oa _op _on; do
            overlaps24 "$IP" "$_oa" "$_op" && { printf '%s (%s/%s)' "$_on" "$_oa" "$_op"; break; }
        done )
        [ -n "$CONFLICT" ] && fail "that subnet is already in use by $CONFLICT"
    fi

    # Read the pool BEFORE overwriting it. The else arm below needs to tell a
    # real pool change from a form submitted with these fields untouched, and
    # after the `uci set` there is nothing left to compare against.
    OLDSTART=$(uci -q get dhcp.lan.start); OLDLIMIT=$(uci -q get dhcp.lan.limit)
    OLDLEASE=$(uci -q get dhcp.lan.leasetime)
    uci set dhcp.lan.start="$DSTART"
    uci set dhcp.lan.limit="$DLIMIT"
    uci set dhcp.lan.leasetime="$DLEASE"
    uci commit dhcp
    if [ "$IP" != "$OLDIP" ]; then
        uci set network.lan.ipaddr="$IP"
        uci commit network
        # uhttpd binds the LAN address literally (2026-08-11, so it is not
        # exposed on WAN or a public IPv6). That address is about to change, so
        # it must move with it — otherwise the console keeps listening on an
        # address that no longer exists and this action locks the user out of
        # the very page they used to trigger it.
        if uci -q get uhttpd.main.listen_http | grep -q "$OLDIP"; then
            for _proto in http https; do
                _cur=$(uci -q get uhttpd.main.listen_$_proto)
                uci set uhttpd.main.listen_$_proto="$(printf '%s' "$_cur" | sed "s/$OLDIP/$IP/g")"
            done
            uci commit uhttpd
        fi
        # AdGuard's admin UI binds the LAN address the same literal way the
        # console does (F-029) — but its config is YAML owned by AdGuard, not
        # uci, so it gets an ANCHORED one-line substitution, never a blind
        # s/old/new/ across the file (which could touch upstreams or rewrite
        # rules). Only the http bind moves: DNS lives on loopback in the same
        # file and is untouched by design. FAIL-SAFE by construction - every
        # branch falls through, because a filtering UI must never be able to
        # abort a LAN move; the failure line says where the UI was left.
        if [ -f /etc/adguardhome/adguardhome.yaml ] &&
           grep -q "^  address: $OLDIP:3010\$" /etc/adguardhome/adguardhome.yaml 2>/dev/null; then
            if sed -i "s|^  address: $OLDIP:3010\$|  address: $IP:3010|" /etc/adguardhome/adguardhome.yaml 2>/dev/null; then
                logger -t settings "AdGuard UI bind moved to $IP with the LAN"
                AGH_MOVED=1
            else
                logger -t settings "AdGuard UI bind rewrite FAILED - UI stays on $OLDIP until fixed by hand"
            fi
        fi
        logger -t settings "LAN address change $OLDIP -> $IP via web UI"
        # Answer first, move the network afterwards — the response must escape
        # on the old address before it stops existing. AdGuard restarts last
        # and only when its bind moved: the restart is what re-binds the UI,
        # and the seconds it costs sit inside a window where dnsmasq is being
        # restarted anyway.
        #
        # THE AdGuard RESTART IS VERIFIED, AND HAS A LADDER UNDER IT.
        #
        # Every LAN client resolves through AdGuard: dnsmasq runs no-resolv with
        # 127.0.0.1:5300 as its only upstream, so an AdGuard that does not come
        # back takes ALL DNS with it - at the exact moment the console has moved
        # to an address the owner may not be able to reach yet. Firing a restart
        # and never looking is how that becomes silent. Measured on this router
        # on 2026-08-31, from a config edit rather than a LAN move: AdGuard
        # refused to start, procd respawned it three times, and DNS was down for
        # about fifteen seconds with nothing but the system log saying so.
        #
        # The likely cause here is not a bad config but a race: the new address
        # may not be up yet when AdGuard tries to bind it. So the ladder is
        # patience first, and only then a retreat that keeps DNS alive:
        #
        #   1. restart, then poll for up to 20s for it to answer
        #   2. still silent - wait and restart once more (the address has had
        #      another 20s to appear by now)
        #   3. still silent - bind the UI to loopback and restart again. The
        #      admin UI is then reachable only through an SSH tunnel, which is
        #      a bad day; DNS for the whole house working is worth more than
        #      the panel being clickable, and this is recorded plainly in the
        #      log rather than quietly repaired.
        #
        # Every branch logs what it did, and the /vpn page reports AdGuard down
        # independently of anything written here.
        ( sleep 2; /etc/init.d/network reload; sleep 2; /etc/init.d/uhttpd reload; /etc/init.d/dnsmasq restart
          if [ "$AGH_MOVED" = 1 ]; then
              # THE PROBE MUST NOT NEED THE INTERNET.
              #
              # An answer on the port is still the test, not the process being
              # alive: it stayed alive through all three failed starts, so a
              # `pgrep` or a procd status would have called that healthy.
              #
              # But the probe used to be `openwrt.org`, which is a RECURSIVE
              # lookup. With the uplink down — a travel router in a hotel whose
              # WAN has not come up, exactly when someone is moving the LAN — a
              # perfectly healthy AdGuard answers SERVFAIL, no `Name:` line
              # appears, three 20s waits expire, and the ladder's last rung
              # rebinds the admin UI to 127.0.0.1 and logs that all DNS is down.
              # That turns "the internet is down" into "the panel now needs an
              # SSH tunnel", which is the worst possible outcome to hand someone
              # who is already offline.
              #
              # `localhost` is answered by AdGuard itself out of the system
              # hosts file (hostsfile_enabled), never forwarded: its query log
              # entry carries a DNSRewriteResult and NO Upstream field, where an
              # external name records Upstream 127.0.0.1:5053. So it proves the
              # listener parsed a query and built a response, with no uplink in
              # the path. It cannot be a .invalid name instead — those are not
              # AdGuard's to answer, and dnsmasq owns them per RFC 6761 anyway.
              #
              # The external name is kept as ONE last-chance probe after the
              # loop, so an install that has the hosts file source switched off
              # is still judged on a real answer rather than on our assumption.
              # It runs once, not twenty times, so a wedged listener cannot
              # multiply its timeout by the loop count.
              agh_probe() { nslookup "$1" 127.0.0.1:5300 2>&1 | grep -qE '^Name:'; }
              agh_alive() {
                  _n=0
                  while [ "$_n" -lt 20 ]; do
                      agh_probe localhost && return 0
                      _n=$((_n + 1)); sleep 1
                  done
                  agh_probe openwrt.org && return 0
                  return 1
              }
              /etc/init.d/adguardhome restart
              if agh_alive; then
                  logger -t settings "AdGuard answering on $IP after the LAN move"
              else
                  logger -t settings "AdGuard did NOT answer after the LAN move - retrying once"
                  sleep 5; /etc/init.d/adguardhome restart
                  if agh_alive; then
                      logger -t settings "AdGuard answering after the second restart"
                  else
                      logger -t settings "AdGuard still dead and ALL DNS is down - binding its UI to loopback to get DNS back"
                      sed -i "s|^  address: $IP:3010\$|  address: 127.0.0.1:3010|" /etc/adguardhome/adguardhome.yaml 2>/dev/null
                      /etc/init.d/adguardhome restart
                      if agh_alive; then
                          logger -t settings "DNS restored - AdGuard UI is on 127.0.0.1:3010 and needs an SSH tunnel until its bind is fixed by hand"
                      else
                          logger -t settings "AdGuard will not start at all - DNS is DOWN; fix /etc/adguardhome/adguardhome.yaml over SSH"
                      fi
                  fi
              fi
          fi ) >/dev/null 2>&1 &
        printf '{"ok":true,"moved":"%s"}' "$(esc "$IP")"
    else
        # The restart is NOT unconditional. dnsmasq derives its dhcp-range from
        # exactly these three values, so a pool change does need it — but this
        # arm also runs whenever the address was left alone, which is what
        # happens every time the owner edits any other field on this form and
        # saves. Restarting then takes name resolution away from every device on
        # the network to apply a change that was not made.
        if [ "$DSTART" != "$OLDSTART" ] || [ "$DLIMIT" != "$OLDLIMIT" ] || \
           [ "$DLEASE" != "$OLDLEASE" ]; then
            logger -t settings "DHCP pool changed via web UI: $OLDSTART/$OLDLIMIT/$OLDLEASE -> $DSTART/$DLIMIT/$DLEASE"
            /etc/init.d/dnsmasq restart >/dev/null 2>&1
        else
            logger -t settings "LAN settings submitted via web UI with nothing changed"
        fi
        printf '{"ok":true}'
    fi
    exit 0
fi

if [ "$ACTION" = "setsys" ]; then
    HN=$(qs_get_dec hostname)
    ZN=$(qs_get_dec zonename)
    printf '%s' "$HN" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,22}[A-Za-z0-9])?$' || fail "hostname: letters, digits and hyphens only"
    TZ=""
    case "$ZN" in
        "Asia/Jakarta")        TZ="WIB-7" ;;
        "Asia/Makassar")       TZ="WITA-8" ;;
        "Asia/Jayapura")       TZ="WIT-9" ;;
        "Asia/Singapore")      TZ="<+08>-8" ;;
        "Asia/Tokyo")          TZ="JST-9" ;;
        "Asia/Dubai")          TZ="<+04>-4" ;;
        "Europe/London")       TZ="GMT0BST,M3.5.0/1,M10.5.0" ;;
        "Europe/Amsterdam")    TZ="CET-1CEST,M3.5.0,M10.5.0/3" ;;
        "America/New_York")    TZ="EST5EDT,M3.2.0,M11.1.0" ;;
        "America/Los_Angeles") TZ="PST8PDT,M3.2.0,M11.1.0" ;;
        "Australia/Sydney")    TZ="AEST-10AEDT,M10.1.0,M4.1.0/3" ;;
        "UTC")                 TZ="UTC0" ;;
        *) fail "unsupported time zone" ;;
    esac
    uci set system.@system[0].hostname="$HN"
    uci set system.@system[0].zonename="$ZN"
    uci set system.@system[0].timezone="$TZ"
    uci commit system
    /etc/init.d/system reload >/dev/null 2>&1
    echo "$HN" > /proc/sys/kernel/hostname 2>/dev/null
    logger -t settings "system settings applied via web UI (host=$HN tz=$ZN)"
    printf '{"ok":true}'
    exit 0
fi

if [ "$ACTION" = "reboot" ]; then
    logger -t settings "reboot requested via web UI"
    ( sleep 2; reboot ) >/dev/null 2>&1 &
    printf '{"ok":true}'
    exit 0
fi

# ---- reload a firewall that failed to load -----------------------------------
# One malformed file anywhere under /etc/nftables.d/, from any package, takes the
# whole fw4 ruleset down: nft loads it in a single transaction. The router then
# runs with nothing filtered, and the console — which has no login — is protected
# only by uhttpd being bound to the LAN address.
#
# Why this is a button and not an SSH instruction. This is a travel router. It
# exists to be operable from a phone in a hotel room, which is the same reason
# apwatch exists ("with only a phone has no way in: no AP, no dashboard, no
# SSH"). Telling someone to open a terminal is not a remedy in the situation the
# device is FOR.
#
# Why handing this to whoever can reach the console is acceptable:
#   - the action closes its own door. It RESTORES filtering; there is no attack
#     whose payload is "make the victim's firewall work".
#   - it creates no new exposure. In this state every other write here is
#     equally reachable and strictly more dangerous — reboot is directly above.
#   - the worst case is bounded by the rate limit below: repeated presses mean
#     repeated restarts of a firewall that is already down.
#
# `restart`, never `start`. Measured: after a failed boot-time load procd already
# considers the service started, so `start` answers "The fw4 firewall appears to
# be already loaded." and exits 0 while the ruleset stays empty.
FWSTAMP=/tmp/.fwrestart
if [ "$ACTION" = "fwrestart" ]; then
    _now=$(date +%s)
    _last=$(cat "$FWSTAMP" 2>/dev/null); case "$_last" in ''|*[!0-9]*) _last=0 ;; esac
    if [ $((_now - _last)) -lt 20 ]; then
        fail "just tried that — give it a few seconds before trying again"
    fi
    printf '%s' "$_now" > "$FWSTAMP" 2>/dev/null
    logger -t settings "firewall restart requested via web UI"
    /etc/init.d/firewall restart >/dev/null 2>&1
    # Report what actually happened, not that the command was issued. A restart
    # cannot succeed while the broken file is still there, and saying "done"
    # when nothing changed is the failure this whole surface exists to correct.
    _st=$(fw_table_state)
    if [ "$_st" = "ok" ]; then
        logger -t settings "firewall reloaded successfully"
        printf '{"ok":true,"firewall":"ok"}'
    else
        logger -t settings "firewall still not loaded after restart"
        printf '{"ok":false,"firewall":"%s","error":"the firewall still will not load. A file under /etc/nftables.d/ is broken and has to be removed — that needs SSH."}' "$_st"
    fi
    exit 0
fi

# ---- IPv6 mode ---------------------------------------------------------------
# Validation is here rather than only in the browser, for the usual reason: the
# UI greys out a mode the uplink cannot deliver, but nothing stops a hand-made
# POST, and picking `native` with no delegated prefix leaves every device on the
# LAN with a ULA and no way out — a failure that looks like "IPv6 is broken"
# long after anyone remembers changing this.
if [ "$ACTION" = "setipv6" ]; then
    MODE=$(qs_get mode)
    ZI=$(wan_zone_idx)
    case "$MODE" in
        off)
            uci set dhcp.$LANNET.ra='disabled'
            uci set dhcp.$LANNET.dhcpv6='disabled'
            uci set dhcp.$LANNET.ndp='disabled'
            uci -q delete dhcp.$LANNET.ra_default
            [ -n "$ZI" ] && uci -q delete firewall.@zone[$ZI].masq6
            ;;
        passthrough)
            uci set dhcp.$LANNET.ra='relay'
            uci set dhcp.$LANNET.dhcpv6='relay'
            uci set dhcp.$LANNET.ndp='relay'
            uci -q delete dhcp.$LANNET.ra_default
            [ -n "$ZI" ] && uci -q delete firewall.@zone[$ZI].masq6
            ;;
        native)
            [ "$(v6_can_native)" = "true" ] || \
                fail "this uplink delegates no prefix, so native would leave your devices without a route out"
            uci set dhcp.$LANNET.ra='server'
            uci set dhcp.$LANNET.dhcpv6='server'
            uci -q delete dhcp.$LANNET.ndp
            uci -q delete dhcp.$LANNET.ra_default
            [ -n "$ZI" ] && uci -q delete firewall.@zone[$ZI].masq6
            ;;
        nat6)
            uci set dhcp.$LANNET.ra='server'
            uci set dhcp.$LANNET.dhcpv6='server'
            uci -q delete dhcp.$LANNET.ndp
            # Without ra_default odhcpd advertises no default route when the
            # only prefix it serves is a ULA, and the LAN gets addresses that
            # go nowhere. This is what makes nat6 differ from a broken native.
            uci set dhcp.$LANNET.ra_default='1'
            [ -n "$ZI" ] || fail "no firewall zone named 'wan' — cannot masquerade IPv6"
            uci set firewall.@zone[$ZI].masq6='1'
            ;;
        *) fail "unknown IPv6 mode" ;;
    esac
    uci commit dhcp
    uci commit firewall
    # odhcpd is the ipv6-only build here, so this cannot disturb IPv4 DHCP —
    # dnsmasq owns that and is not touched.
    /etc/init.d/odhcpd restart >/dev/null 2>&1
    /etc/init.d/firewall reload >/dev/null 2>&1
    logger -t settings "IPv6 mode set to $MODE via web UI"
    printf '{"ok":true,"mode":"%s"}' "$(esc "$MODE")"
    exit 0
fi

# ---- repair a poisoned RA DNS ------------------------------------------------
# Points the advertised RDNSS at the router's own LAN address, which is both
# reachable and the resolver you actually want (dnsmasq -> DoH -> banip).
# Prefers the ULA: it is stable in /etc/config/network, whereas a WAN-derived
# global address changes when the ISP rotates the prefix.
if [ "$ACTION" = "ra6fix" ]; then
    DEV=$(lan_dev)
    ADDR=$(ip -6 addr show dev "$DEV" 2>/dev/null |
           sed -n 's#^ *inet6 \(f[cd][0-9a-f:]*\)/.*#\1#p' | head -n1)
    [ -n "$ADDR" ] || ADDR=$(ip -6 addr show dev "$DEV" 2>/dev/null |
           sed -n 's#^ *inet6 \([^/ ]*\)/.*#\1#p' | grep -v '^fe80' | head -n1)
    [ -n "$ADDR" ] || fail "the LAN has no usable IPv6 address to advertise"
    uci -q delete dhcp.$LANNET.dns
    uci set dhcp.$LANNET.ra_dns='1'
    uci add_list dhcp.$LANNET.dns="$ADDR"
    uci commit dhcp
    /etc/init.d/odhcpd restart >/dev/null 2>&1
    logger -t settings "RA DNS pinned to $ADDR via web UI"
    printf '{"ok":true,"addr":"%s"}' "$(esc "$ADDR")"
    exit 0
fi

# ---- push notifications ------------------------------------------------------
# The URL is a shared secret in practice: on the public ntfy service anyone who
# learns the topic can read this router's notifications. It therefore lives in
# /etc/dashboard (0600) and never in the repo, and the only things ever sent
# are interface and service STATES - no addresses, keys, device names or
# traffic contents.
# ---- is this address unguessable enough to be a shared secret? ----------
#
# A FUNCTION rather than an inline check, because two callers need the same
# answer and they must not be able to disagree: the write path refuses a weak
# address, and the read path has to TELL the console the stored one is weak.
# Enforcement that only exists at write time is enforcement the owner cannot
# see, and the alerts now carry network names and the names of devices joining
# them - so a weak topic he knows about and a weak topic the console hides are
# very different situations.
#
# It prints a verdict and never the value. Nothing here may log, echo or emit
# the address: proving a secret is weak by showing it is not a trade worth
# making.
#
url_strong() {   # $1 = url -> prints 1 if it carries an unguessable part
    _ushn=$(uci -q get system.@system[0].hostname 2>/dev/null | tr "A-Z" "a-z")
    printf '%s\n%s\n' "$_ushn" "$1" | awk '
        NR == 1 { hn = tolower($0); next }
        NR == 2 {
            u = $0
            sub("^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*", "", u)
            n = split(u, seg, "[/?&=#:]")
            for (i = 1; i <= n; i++) {
                s = seg[i]
                if (length(s) < 12) continue
                if (s !~ /[a-z]/ || s !~ /[A-Z]/) continue
                d = 0; delete seen
                for (j = 1; j <= length(s); j++) {
                    c = substr(s, j, 1)
                    if (!(c in seen)) { seen[c] = 1; d++ }
                }
                if (d < 8) continue
                if (length(hn) >= 4 && index(tolower(s), hn) > 0) continue
                wordy = 1
                m = split(s, ch, "[-_.]")
                for (k = 1; k <= m; k++) {
                    if (ch[k] == "") continue
                    if (ch[k] !~ /^[A-Za-z][a-z]*[0-9]*$/) { wordy = 0; break }
                }
                if (wordy) continue
                print "1"; exit
            }
            print "0"
        }'
}

NOTIFYCONF=/etc/dashboard/notify.conf
if [ "$ACTION" = "setnotify" ]; then
    NENABLED=$(qs_get enabled)
    # KEEP means "I am not changing the address", which is a different request
    # from "here is an address". The page sends it whenever the field still holds
    # what the router already has, so switching notifications off does not
    # resubmit the stored value and get refused by a bar it was never being asked
    # to clear. It is not a grandfather clause: an address that fails the bar can
    # be kept and switched OFF, never switched back ON, and never re-saved as a
    # new value.
    NKEEP=$(qs_get_dec keepurl | tr -d '\n\r')
    # CR and LF are stripped before anything else looks at the value, the same
    # way ssid and key are handled above. This file is line-structured: a
    # newline inside a value does not corrupt a string, it forges a whole extra
    # LINE, and every defence that reasons about "the value" would be reasoning
    # about only the first one.
    NURL=$(qs_get_dec url | tr -d '\n\r')
    if [ "$NKEEP" = "1" ]; then
        conf_load "$NOTIFYCONF" >/dev/null 2>&1
        NURL=$NOTIFY_URL
        [ -n "$NURL" ] || fail "there is no address stored to keep — enter one"
        # Arming a weak address is still refused; only keeping it while switching
        # off is allowed. Checked here rather than below because the shared
        # validation is skipped for a value the owner is not introducing.
        if [ "$NENABLED" = "1" ] && [ "$(url_strong "$NURL")" != "1" ]; then
            fail "the stored address is too easy to guess to switch back on. Alerts name your networks and the devices joining them, so this needs a new address from the service's generate button — replace it in the field above."
        fi
    fi
    case "$NENABLED" in 0|1) ;; *) fail "enabled must be 0 or 1" ;; esac

    # VALIDATED ON EVERY PATH, not only when the toggle is on. These checks used
    # to sit inside `if [ "$NENABLED" = "1" ]`, so saving with the toggle OFF
    # stored the address unchecked - and the file is read by root programs
    # whether notifications are enabled or not, because the read happens before
    # the enabled test in both daemons. "Off" was never a quiet path.
    #
    # An empty address is allowed ONLY with the toggle off, which is how the
    # feature is cleared; with it on, an empty address would arm a monitor that
    # can never deliver.
    if [ "$NKEEP" = "1" ]; then
        :   # validated above against the stored value; nothing new to check
    elif [ -z "$NURL" ]; then
        [ "$NENABLED" = "1" ] && fail "enter the address to send to before switching notifications on"
    else
        case "$NURL" in
            https://*|http://*) ;;
            *) fail "the address must start with https:// or http://" ;;
        esac
        [ "${#NURL}" -gt 512 ] && fail "that address is longer than 512 characters"
        # RFC 3986 characters only. The old list was A-Za-z0-9:/._~- which
        # rejects ? & and =, so no webhook carrying a query string could be
        # saved with the toggle ON - and that strictness is what pushed a real
        # URL down the unvalidated toggle-OFF path. Everything a URI may
        # legitimately contain is accepted here EXCEPT the apostrophe, which is
        # legal per RFC but appears in no webhook and complicates every layer
        # that has to quote this value. Characters that are not URI characters
        # at all - backslash, backtick, quote, space, angle brackets, braces,
        # pipe, caret, and every control byte - are refused by that rule alone.
        #
        # $ ( ) are legal URI sub-delims and are dropped from the list ANYWAY.
        # They are the command-substitution set, no real webhook contains one,
        # and if anyone ever reintroduces a `.` on this file the stored value
        # still could not substitute a command. Note what this does NOT buy:
        # & and ; are equally dangerous to a sourced line and CANNOT be dropped,
        # because query strings need them. That is the whole reason "widen the
        # allowlist" and "keep sourcing it" were never both available - the
        # parse in conf_load is what makes accepting & safe, not this list.
        _urlbad=$(printf '%s' "$NURL" | tr -d 'A-Za-z0-9:/?#[]@!&*+,;=._~%-')
        [ -n "$_urlbad" ] && fail "that address contains characters a URL cannot hold"

        # THE ADDRESS IS A BEARER SECRET, SO IT HAS TO BE UNGUESSABLE.
        #
        # On a public push service the topic IS the authentication: whoever
        # knows it reads this router's alerts. The join notifier now sends
        # network names and the names or MAC addresses of the devices joining
        # them, so a guessable topic is a live feed of who is in the house. A
        # topic built out of strings anyone can read in the public repo — the
        # product name, the owner's handle — is guessable in a handful of
        # attempts, and the service will not rate-limit a subscriber.
        #
        # THE BAR. The URL is split into components after the scheme and host
        # (the host is public by definition and can never be the secret), and
        # at least ONE component must look like something that was generated
        # rather than typed:
        #
        #   - 12 characters or more. Twelve random base62 characters is ~71
        #     bits; nothing shorter is worth calling a secret.
        #   - contains BOTH an upper and a lower case letter. This is the rule
        #     that does the real work. Every service that mints these tokens —
        #     and the push service's own "generate" button — emits base62 or
        #     base64url, where a 12-character token misses one of the two cases
        #     about 0.7% of the time. A slug a person typed is almost always
        #     all lower case. Digits are deliberately NOT required: the miss
        #     rate for those is ~12% at this length, and human slugs contain
        #     digits anyway, so the signal is weak and the false refusals real.
        #   - at least 8 DISTINCT characters, so length cannot be reached by
        #     repeating a short pattern. Twelve random characters give about
        #     eleven distinct ones; this only bites padding.
        #   - does not contain this router's own name. Derived at run time from
        #     the hostname, never hardcoded: the exact failure this is here to
        #     stop was a topic prefixed with a name that is written down in
        #     public. Only applied when the hostname is 4+ characters, so a
        #     short one cannot collide with a real token by accident.
        #   - is not just words wearing a capital letter. Split again on the
        #     separators people put in slugs (- _ .), a component every one of
        #     whose chunks is a word — one leading letter, lower case after it,
        #     digits only at the end — is refused. That is what stops the
        #     obvious second attempt after the case rule bites: capitalising
        #     the same guessable words. A generated token never has this shape,
        #     because its capitals land in the middle.
        #
        # What this still cannot see is a run-together CamelCase phrase with no
        # separator: it has interior capitals and reads as random to every test
        # above. Refusing that needs a dictionary, which is not on this router.
        #
        # Checking COMPONENTS, not the whole string, is what keeps structured
        # webhooks working: the secret sits in the last path segment for
        # Discord and Slack, in a query VALUE for Gotify, and in the middle of
        # the path for Telegram, whose last segment is the literal method name.
        # Requiring one strong component accepts all four and still refuses a
        # URL whose every part is a word.
        #
        # Fed on stdin, two lines, because `awk -v` processes backslash escapes
        # in the value on busybox and this value is attacker-shaped. If the
        # hostname line ever arrived malformed the URL would not be on line 2
        # and nothing is printed, which fails closed.
        _nhn=$(uci -q get system.@system[0].hostname 2>/dev/null | tr -d '\n\r')
        [ "$(url_strong "$NURL")" = "1" ] || fail "that address has no unguessable part in it. Alerts name your networks and the devices joining them, and on a public push service the address is the only thing keeping strangers out — so it needs a token of 12 or more characters mixing upper and lower case, not a word. Use the service's own generate button. To switch notifications off, clear this field instead."
    fi
    mkdir -p /etc/dashboard
    # SAVE OWNS TWO KEYS AND MUST LEAVE THE REST ALONE.
    #
    # This used to write exactly two lines over the file, which erased every
    # other key in it - and there are 51 documented ones: the message captions
    # and the alert thresholds that notifymon and wifiwatch read. notifymon's
    # own header tells the owner those survive "because a console reinstall
    # replaces this script and never touches that config", which is true of a
    # reinstall and was false of this button. Someone who had reworded their
    # alerts in Indonesian lost the lot by toggling notifications off and on.
    #
    # Anything that is not a valid assignment and not a comment is DROPPED
    # rather than carried forward. That is deliberate: it means saving from this
    # page also cleans out any junk line an older, unvalidated write may have
    # left behind, and the file converges on something conf_load can read whole.
    # THE FILE IS BUILT IN MEMORY FIRST, AND THE WRITE IS CHECKED BY COUNTING
    # BYTES — not by the exit status of the redirection.
    #
    # This used to be one `{ ...; if ...; fi; } > tmp || fail`. A group command
    # exits with the status of its LAST command, and the last thing in that
    # group was a shell test, not a write. Replayed on this router against
    # /dev/full: with the config's final line being a preserved key the group
    # did return 1, but with a trailing comment, a trailing blank line, a
    # trailing NOTIFY_URL= line, a trailing junk line, or no config file at all
    # it returned 0. The live file ends in NOTIFY_URL=, so the check could not
    # fire here at all — and the `mv` under it was unchecked as well, so a
    # truncated temp file was installed over a good config and the endpoint
    # still answered {"ok":true}. That loses the URL and all 51 overrides.
    #
    # Exit status alone cannot be trusted even when the last command IS a write:
    # stdout to a file is block-buffered, so a printf can return 0 with the data
    # still in the buffer and the ENOSPC surfacing only at the flush, after the
    # status has been taken. Measured on a 64k tmpfs deliberately filled: a
    # 15889-byte payload landed as 4096 bytes.
    #
    # So: capture, write once, then verify the file on disk is exactly as long
    # as what we meant to write. That is deterministic whatever the buffering
    # does. `${#var}` in ash counts BYTES, not characters (checked: a 5-char
    # UTF-8 string measures 6), so this stays correct for non-ASCII captions.
    #
    # The trailing X is there because command substitution strips every trailing
    # newline; without it a config that ends in blank lines would silently lose
    # them and the byte count would disagree with the file for no real reason.
    _newconf=$( {
        printf 'NOTIFY_ENABLED=%s\nNOTIFY_URL=%s\n' "$NENABLED" "$NURL"
        if [ -r "$NOTIFYCONF" ]; then
            while IFS= read -r _ln || [ -n "$_ln" ]; do
                case "$_ln" in
                    ''|'#'*)                       printf '%s\n' "$_ln"; continue ;;
                    NOTIFY_ENABLED=*|NOTIFY_URL=*) continue ;;
                esac
                _lk=${_ln%%=*}
                [ "$_lk" = "$_ln" ] && continue
                case "$_lk" in ''|[0-9]*|*[!A-Za-z0-9_]*) continue ;; esac
                printf '%s\n' "$_ln"
            done < "$NOTIFYCONF"
        fi
        printf 'X'
    } )
    _newconf=${_newconf%X}
    _wfail="could not write /etc/dashboard/notify.conf — the setting is unchanged. That is a filesystem refusal; check overlay space over SSH"
    # 0600 before the rename, not after: the temp file is created under the
    # CGI's umask, and chmod-after leaves a window where the URL is world
    # readable under its final name.
    rm -f "$NOTIFYCONF.tmp"
    printf '%s' "$_newconf" > "$NOTIFYCONF.tmp" 2>/dev/null || { rm -f "$NOTIFYCONF.tmp"; fail "$_wfail"; }
    chmod 600 "$NOTIFYCONF.tmp" 2>/dev/null
    _wrote=$(wc -c < "$NOTIFYCONF.tmp" 2>/dev/null); _wrote=${_wrote##* }
    [ "$_wrote" = "${#_newconf}" ] || { rm -f "$NOTIFYCONF.tmp"; fail "$_wfail"; }
    # The rename is the only step that can destroy the old file, so it is the
    # one step that must not be assumed to have worked either.
    mv "$NOTIFYCONF.tmp" "$NOTIFYCONF" 2>/dev/null || { rm -f "$NOTIFYCONF.tmp"; fail "$_wfail"; }
    # Re-baseline so switching on does not replay whatever happened while off.
    rm -f /tmp/.notifystate
    logger -t settings "push notifications set to $NENABLED via web UI"
    printf '{"ok":true,"enabled":%s}' "$([ "$NENABLED" = 1 ] && echo true || echo false)"
    exit 0
fi

if [ "$ACTION" = "testnotify" ]; then
    conf_load "$NOTIFYCONF" || fail "notifications have never been set up — enter an address and enable them above, then test"
    [ "$NOTIFY_ENABLED" = "1" ] && [ -n "$NOTIFY_URL" ] || fail "notifications are switched off — enable them above first, then test"
    _hn=$(uci -q get system.@system[0].hostname); _hn=${_hn:-router}
    if wget -q -T 8 -O /dev/null --header="Title: $_hn: test" --header="Tags: bell" \
        --post-data="If you are reading this on your phone, the alerts work." "$NOTIFY_URL" 2>/dev/null; then
        printf '{"ok":true}'
    else
        # The monitor queues a failed send and retries; a TEST must not, or the
        # button would report failure and then the message would arrive anyway.
        printf '{"ok":false,"error":"the router could not reach that address"}'
    fi
    exit 0
fi

[ -n "$ACTION" ] && fail "unknown action"

# --------------------------------------------------------------------- read --
NOW=$(date +%s)
UP=$(cut -d. -f1 /proc/uptime)

radio_json() {  # $1 = radioN
    R="$1"
    BAND=$(uci -q get wireless.$R.band)
    BN=$(band_num "$BAND")
    PHY=$(phy_of "$R")
    IFSEC=$(ap_section_of "$R")
    DIS=$(uci -q get wireless.$R.disabled); [ "$DIS" = "1" ] || DIS=0
    CH=$(uci -q get wireless.$R.channel)
    HT=$(uci -q get wireless.$R.htmode)
    TX=$(uci -q get wireless.$R.txpower)
    CTRY=$(uci -q get wireless.$R.country)
    SSID=$(uci -q get wireless.$IFSEC.ssid)
    ENC=$(uci -q get wireless.$IFSEC.encryption)
    IDIS=$(uci -q get wireless.$IFSEC.disabled); [ "$IDIS" = "1" ] || IDIS=0

    # live state: first AP interface on this band from `iw dev`
    CUR=$(iw dev 2>/dev/null | awk -v want="$BN" '
        /^\tInterface/ { isap=0; ch=0; band=0; next }
        /type AP/ { isap=1; next }
        /channel/ {
            ch=$2+0; g=$3; sub(/\(/,"",g); f=g+0
            match($0,/width: [0-9]+/); w=substr($0,RSTART+7,RLENGTH-7)+0
            match($0,/center1: [0-9]+/); c1=substr($0,RSTART+9,RLENGTH-9)+0
            band=(f<3000)?1:2; next
        }
        /txpower/ && isap && band==want && ch {
            printf "{\"channel\":%d,\"freq\":%d,\"width\":%d,\"center\":%d,\"txpower\":%d}", ch, f, w, c1, $2+0
            exit
        }')
    [ -n "$CUR" ] || CUR=null

    printf '{"id":"%s","band":"%s","disabled":%s,"channel":"%s","htmode":"%s","txpower":%s,"country":"%s",' \
        "$R" "$(esc "$BAND")" "$([ "$DIS" = "1" ] && echo true || echo false)" \
        "$(esc "$CH")" "$(esc "$HT")" \
        "$([ -n "$TX" ] && jnum "$TX" || echo null)" "$(esc "$CTRY")"
    printf '"gens":%s,"channels":%s,"current":%s,' "$(gens_of "$BN")" "$(chan_json "$BN")" "$CUR"
    printf '"ssid":"%s","enc":"%s","iface_disabled":%s}' \
        "$(esc "$SSID")" "$(esc "$ENC")" "$([ "$IDIS" = "1" ] && echo true || echo false)"
}

printf '{"ok":true,"ts":%s,' "$NOW"

RJ=""
for _r in $RADIOS; do RJ="$RJ${RJ:+,}$(radio_json "$_r")"; done
printf '"wireless":{"radios":[%s],' "$RJ"

# Secondary networks are optional and there may be several: emit an ARRAY, empty
# when there are none, so the UI renders one panel per network and no panel at
# all on a router that has none. Each entry carries its own section name because
# that is what the write action needs back.
#
# `legacy` is reported rather than inferred in the page, and it is the whole
# point of the guest SSID: an AP that advertises only WPA-PSK with no PMF is one
# a pre-2012 supplicant can actually associate with, where the main SSID's
# sae-mixed + ieee80211w + ieee80211r advertises five AKM suites and four RSN
# capability bits those clients were never written to parse.
_SECJ=""
for _net in $(secondary_networks); do
    _secs=$(sections_of_net "$_net")
    # Facts are read from the FIRST section and the rest are checked against it,
    # because the page presents one form for the network: if the two bands have
    # drifted apart - someone edited uci by hand - the page must say so rather
    # than silently show one band's settings as though they were both.
    _first=$(printf '%s' "$_secs" | head -1)
    _ss=$(uci -q get wireless.$_first.ssid)
    _sd=$(uci -q get wireless.$_first.disabled); [ "$_sd" = "1" ] || _sd=0
    _siso=$(uci -q get wireless.$_first.isolate); [ "$_siso" = "1" ] || _siso=0
    _bands=""; _seclist=""; _leg=true; _split=false
    for _sec in $_secs; do
        _sdev=$(uci -q get wireless.$_sec.device)
        _sband=$(uci -q get wireless.$_sdev.band)
        case " $_bands " in *" $_sband "*) ;; *) _bands="$_bands $_sband" ;; esac
        _seclist="$_seclist${_seclist:+,}\"$(esc "$_sec")\""
        _senc=$(uci -q get wireless.$_sec.encryption)
        _spmf=$(uci -q get wireless.$_sec.ieee80211w); [ -n "$_spmf" ] || _spmf=0
        case "$_senc" in
            psk2*|psk-mixed*) [ "$_spmf" = "0" ] || _leg=false ;;
            *) _leg=false ;;
        esac
        # SSID or key drifted between the bands of one network
        [ "$(uci -q get wireless.$_sec.ssid)" = "$_ss" ] || _split=true
        [ "$(uci -q get wireless.$_sec.key)" = "$(uci -q get wireless.$_first.key)" ] || _split=true
    done
    _bandj=""
    for _b in $_bands; do _bandj="$_bandj${_bandj:+,}\"$(esc "$_b")\""; done
    _SECJ="$_SECJ${_SECJ:+,}$(printf '{"network":"%s","sections":[%s],"bands":[%s],"ssid":"%s","disabled":%s,"isolate":%s,"legacy":%s,"split":%s}' \
        "$(esc "$_net")" "$_seclist" "$_bandj" "$(esc "$_ss")" \
        "$([ "$_sd" = "1" ] && echo true || echo false)" \
        "$([ "$_siso" = "1" ] && echo true || echo false)" "$_leg" "$_split")"
done
printf '"secondary":[%s]},' "$_SECJ"
printf '"lan":{"ipaddr":"%s","netmask":"%s","dhcp":{"start":%s,"limit":%s,"leasetime":"%s"}},' \
    "$(esc "$(uci -q get network.lan.ipaddr)")" "$(esc "$(uci -q get network.lan.netmask)")" \
    "$(jnum "$(uci -q get dhcp.lan.start)")" "$(jnum "$(uci -q get dhcp.lan.limit)")" \
    "$(esc "$(uci -q get dhcp.lan.leasetime)")"
NOTIFY_ENABLED=0; NOTIFY_URL=""
conf_load /etc/dashboard/notify.conf >/dev/null 2>&1
# The queue file exists only while a send is stranded, i.e. almost never.
# TEST for it rather than redirecting from it: `wc -l < missing 2>/dev/null`
# does NOT stay quiet, because the failing redirection is performed by the
# SHELL and reported before wc ever runs - the 2>/dev/null lands on the wrong
# process. Every poll of this page was writing an error to the system log.
NOTIFY_QUEUED=0
[ -f /tmp/.notifyq ] && NOTIFY_QUEUED=$(wc -l < /tmp/.notifyq)
# `weak` is a VERDICT about the stored address and never says anything about
# its contents. Enforcement used to exist only on the way in, which meant the one
# state worth warning about - an address already stored that would be refused
# today - was the one state the console could not show. The alerts carry network
# names and the names of devices joining them, so this is not cosmetic.
printf '"notify":{"enabled":%s,"url":"%s","queued":%s,"weak":%s},' \
    "$([ "$NOTIFY_ENABLED" = 1 ] && echo true || echo false)" \
    "$(esc "$NOTIFY_URL")" \
    "$(jnum "$NOTIFY_QUEUED")" \
    "$( [ -n "$NOTIFY_URL" ] && [ "$(url_strong "$NOTIFY_URL")" != "1" ] && echo true || echo false )"
printf '"system":{"hostname":"%s","zonename":"%s","uptime":%s,"ntp":%s},' \
    "$(esc "$(uci -q get system.@system[0].hostname)")" \
    "$(esc "$(uci -q get system.@system[0].zonename)")" \
    "$(jnum "$UP")" \
    "$([ "$(uci -q get system.ntp.enabled)" = "1" ] && echo true || echo false)"

printf '"ipv6":{"mode":"%s","can_native":%s,"uplink":%s,"master":"%s","ula":"%s","radns":%s},' \
    "$(v6_mode)" "$(v6_can_native)" "$(v6_uplink_up)" \
    "$(esc "$(v6_master)")" "$(esc "$(uci -q get network.globals.ula_prefix)")" \
    "$(ra6_json)"

# Whatever the last check found, plus the running firmware read locally so the
# panel can state that much even if nothing has ever been checked. `null` means
# never checked — distinct from "checked and up to date", which the UI must not
# blur into the same sentence.
. /etc/openwrt_release 2>/dev/null
printf '"software":{"running":"%s","revision":"%s","target":"%s","owut":%s,"check":%s}}' \
    "$(esc "$DISTRIB_RELEASE")" "$(esc "$DISTRIB_REVISION")" "$(esc "$DISTRIB_TARGET")" \
    "$(command -v owut >/dev/null 2>&1 && echo true || echo false)" \
    "$(cat "$UPDCACHE" 2>/dev/null || echo null)"
