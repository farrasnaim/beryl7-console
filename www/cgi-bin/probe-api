#!/bin/sh
# /www/cgi-bin/probe-api  —  what the Overview's probe is aimed at, and the
# saved addresses you can aim it at.
#
# Two different lifetimes, deliberately kept apart:
#
#   the SELECTION   /tmp/.pingtarget          resets to Cloudflare on every
#                                             boot. Choosing a target is
#                                             something you do while looking
#                                             into a problem, not a setting to
#                                             carry forever — and it means no
#                                             flash write when you change it.
#   the SAVED LIST  /etc/dashboard/ping-targets   survives reboots, because the
#                                             whole point is not to retype a
#                                             game server's address every time.
#
# All of it lives here rather than being split with settings-api, so the
# address validator exists once. A wrong copy of that is how you end up
# accepting a hostname in one place and rejecting it in the other.
#
# Writes are POST + same-origin, like every other write on this console. There
# is no password: the console is unauthenticated on the trusted LAN by design,
# and the same-origin check is what stops a web page you happen to be visiting
# from driving this through your browser. `list` is a GET because it reads and
# changes nothing — the same rule settings-api applies to its log reader.

# esc, jnum, fail, read_body, urldec, qs_get, qs_get_dec, guard_post — one copy,
# shared with every other endpoint. Tested for readability rather than sourced
# blind: busybox ash treats `.` as a special builtin, so a missing file aborts
# the script outright and an `|| fallback` after it never runs. Without the
# check the failure is a 500 with an empty body and nothing in the log.
BERYL_LIB=/usr/share/beryl/cgi-lib.sh
if [ -r "$BERYL_LIB" ]; then
    . "$BERYL_LIB"
else
    printf 'Content-Type: application/json\r\n'
    printf 'Cache-Control: no-store\r\n\r\n'
    printf '{"ok":false,"error":"missing %s - reinstall the console"}' "$BERYL_LIB"
    exit 0
fi

SEL_FILE=/tmp/.pingtarget
TARGETS=/etc/dashboard/ping-targets
POST_MAX=512
MAX_SAVED=12            # the dropdown has to stay readable
NAME_MAX=24

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n\r\n'

read_body

# No default. An absent action used to become `set`, which is the WRITE action -
# the inverse of the convention every other endpoint follows, where an empty
# action is the read path and anything unrecognised is refused. Nothing depended
# on it: `set` with no address argument terminates at the same fail() an empty
# action now reaches, so this deletes a line rather than replacing one.
ACTION=$(qs_get action)

# `list` reads and changes nothing, so it stays a GET. The POST rule exists to
# stop a foreign page issuing a WRITE through your browser; a read cannot be
# turned into one, and the browser will not hand the response to another origin.
if [ "$ACTION" != "list" ]; then
    guard_post
fi

# valid_ip4 now lives in the shared library: vpn-api needs the same check on a
# tunnel's DNS entries, and a second copy of an address validator is exactly the
# drift this console keeps paying for.

# The file is `ip|name` per line, the same shape as the classmap and the oui
# map. `|` and control characters are stripped from names on the way in, so a
# line can never gain a second field or a newline.
clean_name() {
    printf '%s' "$1" | tr -d '|\000-\037' | cut -c1-"$NAME_MAX" \
        | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

list_json() {
    printf '['
    [ -f "$TARGETS" ] && awk -F'|' '
        function esc(s) { gsub(/\\/, "\\\\&", s); gsub(/"/, "\\\\&", s); return s }
        $1 != "" && $1 !~ /^#/ {
            nm = (NF >= 2 && $2 != "") ? $2 : $1
            printf "%s{\"ip\":\"%s\",\"name\":\"%s\"}", (c++ ? "," : ""), esc($1), esc(nm)
        }' "$TARGETS" 2>/dev/null
    printf ']'
}

save_list() {   # stdin -> the file, atomically
    mkdir -p /etc/dashboard 2>/dev/null
    cat > "$TARGETS.tmp" || return 1
    mv "$TARGETS.tmp" "$TARGETS"
}

case "$ACTION" in

list)
    SEL=""; CUSTOM=""
    [ -f "$SEL_FILE" ] && { read -r _l < "$SEL_FILE" 2>/dev/null; set -- $_l; SEL=$1; CUSTOM=$2; }
    printf '{"ok":true,"sel":"%s","target":"%s","targets":%s,"max":%s}' \
        "$(esc "$SEL")" "$(esc "$CUSTOM")" "$(list_json)" "$MAX_SAVED"
    ;;

add)
    IP=$(qs_get ip)
    NAME=$(clean_name "$(qs_get_dec name)")
    valid_ip4 "$IP" || fail "not a usable IPv4 address"
    IP=$IP4_CANON
    [ -n "$NAME" ] || NAME="$IP"
    _n=$(awk -F'|' '$1 != "" && $1 !~ /^#/ && $1 != ip' ip="$IP" "$TARGETS" 2>/dev/null | wc -l)
    [ "$_n" -ge "$MAX_SAVED" ] && fail "the list holds $MAX_SAVED addresses and is full — remove one first"
    # Re-adding an address that is already saved renames it rather than
    # duplicating it — a list with the same IP twice has no useful meaning.
    { [ -f "$TARGETS" ] && awk -F'|' -v ip="$IP" '$1 != ip' "$TARGETS" 2>/dev/null
      printf '%s|%s\n' "$IP" "$NAME"
    } | save_list || fail "could not write /etc/dashboard/ping-targets — the list is unchanged. That is a filesystem refusal; check overlay space over SSH (df /overlay)"
    printf '{"ok":true,"targets":%s}' "$(list_json)"
    ;;

del)
    IP=$(qs_get ip)
    [ -n "$IP" ] || fail "no address given — nothing was removed"
    [ -f "$TARGETS" ] || fail "the list is already empty — nothing to remove"
    awk -F'|' -v ip="$IP" '$1 != ip' "$TARGETS" 2>/dev/null | save_list || fail "could not write /etc/dashboard/ping-targets — the list is unchanged. That is a filesystem refusal; check overlay space over SSH (df /overlay)"
    # The prober is deliberately NOT touched. Removing a shortcut should not
    # change what the router is currently measuring; the Overview shows the
    # live address whether or not it is still in the list.
    printf '{"ok":true,"targets":%s}' "$(list_json)"
    ;;

set)
    SEL=$(qs_get sel)
    IP=$(qs_get ip)
    case "$SEL" in
        cf|google|gw) LINE="$SEL" ;;
        custom)
            valid_ip4 "$IP" || fail "not a usable IPv4 address"
    IP=$IP4_CANON
            LINE="custom $IP"
            ;;
        *) fail "unknown target" ;;
    esac
    printf '%s\n' "$LINE" > "$SEL_FILE.tmp" 2>/dev/null || fail "could not write the selection to /tmp — the probe target is unchanged. /tmp is RAM; if it is full, something is filling it — that needs SSH"
    mv "$SEL_FILE.tmp" "$SEL_FILE" 2>/dev/null || fail "could not write the selection to /tmp — the probe target is unchanged. /tmp is RAM; if it is full, something is filling it — that needs SSH"
    printf '{"ok":true,"sel":"%s"}' "$(esc "$SEL")"
    ;;

*) fail "unknown action" ;;
esac
