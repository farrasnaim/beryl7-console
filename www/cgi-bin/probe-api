#!/bin/sh
# /www/cgi-bin/probe-api  —  what the Overview's probe is aimed at, and the
# saved addresses you can aim it at.
#
# Two different lifetimes, deliberately kept apart:
#
#   the SELECTION   /tmp/.pingtarget          resets to Cloudflare on every
#                                             boot. Choosing a target is
#                                             something you do while looking
#                                             into a problem, not a setting to
#                                             carry forever — and it means no
#                                             flash write when you change it.
#   the SAVED LIST  /etc/dashboard/ping-targets   survives reboots, because the
#                                             whole point is not to retype a
#                                             game server's address every time.
#
# All of it lives here rather than being split with settings-api, so the
# address validator exists once. A wrong copy of that is how you end up
# accepting a hostname in one place and rejecting it in the other.
#
# Writes are POST + same-origin, like every other write on this console. There
# is no password: the console is unauthenticated on the trusted LAN by design,
# and the same-origin check is what stops a web page you happen to be visiting
# from driving this through your browser. `list` is a GET because it reads and
# changes nothing — the same rule settings-api applies to its log reader.

SEL_FILE=/tmp/.pingtarget
TARGETS=/etc/dashboard/ping-targets
POST_MAX=512
MAX_SAVED=12            # the dropdown has to stay readable
NAME_MAX=24

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n\r\n'

# JSON forbids a raw control byte inside a string, and JSON.parse enforces it —
# one such byte anywhere in a payload invalidates the WHOLE response, so the page
# renders nothing and the cause is invisible. Stripping only \n\r\t left BEL, VT,
# FF, ESC and the rest passing through verbatim; reachable through any name the
# router did not author, e.g. a device renamed via setdev, whose own filter also
# only removes \n\r\t.
#
# The range is spelled in octal, NOT as [:cntrl:]. busybox tr does not implement
# POSIX classes and silently treats [:cntrl:] as the literal set { [ : c n t r l ] },
# so `tr -d '[:cntrl:]'` turns "hello world" into "heo wod" — measured on this
# router. That would have quietly corrupted every name containing c, n, t, r or l.
esc() { printf '%s' "$1" | tr -d '\001-\037\177' | sed 's/\\/\\\\/g; s/"/\\"/g'; }
fail() { printf '{"ok":false,"error":"%s"}' "$(esc "$1")"; exit 0; }

CL="${CONTENT_LENGTH:-0}"; case "$CL" in ''|*[!0-9]*) CL=0 ;; esac
[ "$CL" -gt "$POST_MAX" ] && fail "body too large"
BODY=""
[ "$CL" -gt 0 ] && BODY=$(dd bs=1 count="$CL" 2>/dev/null)

qs_get() {
    printf '%s' "${QUERY_STRING}&${BODY}" | tr '&' '\n' \
      | awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); print; exit}'
}
urldec() {
    printf '%s' "$1" | awk '
    BEGIN{ for(i=0;i<16;i++){ h=sprintf("%X",i); H[h]=i; H[tolower(h)]=i } }
    { gsub(/\+/," "); s=$0; n=length(s); out=""
      for(i=1;i<=n;i++){ c=substr(s,i,1)
        if(c=="%" && i+2<=n){ a=substr(s,i+1,1); b=substr(s,i+2,1)
          if((a in H) && (b in H)){ out=out sprintf("%c",H[a]*16+H[b]); i+=2; continue } }
        out=out c }
      printf "%s", out }'
}
qs_get_dec() { urldec "$(qs_get "$1")"; }

ACTION=$(qs_get action)
[ -n "$ACTION" ] || ACTION=set

# `list` reads and changes nothing, so it stays a GET. The POST rule exists to
# stop a foreign page issuing a WRITE through your browser; a read cannot be
# turned into one, and the browser will not hand the response to another origin.
if [ "$ACTION" != "list" ]; then
    [ "$REQUEST_METHOD" = "POST" ] || fail "POST required"
    src="${HTTP_ORIGIN:-$HTTP_REFERER}"
    src="${src#*://}"; src="${src%%[:/]*}"
    # DNS is case-insensitive and a browser echoes back whatever was typed
    # in the address bar, so Beryl7.lan and beryl7.lan are one host. The
    # address list is already lowercase, so this cannot affect IP matching.
    src=$(printf '%s' "$src" | tr 'A-Z' 'a-z')
    ok=0
    case "$src" in
        "") ok=0 ;;
        localhost|127.0.0.1|::1) ok=1 ;;
        *) for ip in $(ip -o addr 2>/dev/null | awk '{split($4,x,"/"); print x[1]}'); do
             [ "$ip" = "$src" ] && { ok=1; break; }
           done
           # ...and the names this router answers to. Opening the console by
           # name is an ordinary thing to do, and settings-api even offers a
           # control to CHANGE the hostname — so the console hands you a way to
           # create the condition that disables it. Without this the page loads
           # (GET is unguarded) and every button then fails "bad origin" with
           # nothing pointing at the cause.
           #
           # Read from uci at runtime, never written literally: this repository
           # is public and a hostname baked in here is one deployment's private
           # detail published.
           #
           # NOT Origin == HTTP_HOST, which is the usual fix and is wrong here.
           # That compares two headers the caller controls to each other, so an
           # attacker domain pointed at this router matches itself and passes.
           # Checking against addresses the router actually owns is precisely
           # what defeats DNS rebinding, so it stays an allowlist.
           if [ "$ok" = 0 ]; then
               n_h=$(uci -q get system.@system[0].hostname | tr 'A-Z' 'a-z')
               n_d=$(uci -q get dhcp.@dnsmasq[0].domain | tr 'A-Z' 'a-z')
               [ -n "$n_d" ] || n_d=lan
               [ -n "$n_h" ] && { [ "$src" = "$n_h" ] || [ "$src" = "$n_h.$n_d" ]; } && ok=1
           fi ;;
    esac
    [ "$ok" = 1 ] || fail "bad origin"
fi

# A literal unicast IPv4 address and nothing else.
#
# NOT a hostname: resolving one at probe time could go out through the VPN, or
# fail during exactly the outage the probe exists to measure. NOT multicast or
# broadcast, which do not mean anything as a round-trip target. A LAN address IS
# allowed — pointing this at something on your own network is a legitimate thing
# to want to measure.
valid_ip4() {
    case "$1" in
        ''|*[!0-9.]*|*..*|.*|*.) return 1 ;;
    esac
    _c=0; _first=""
    _oldifs=$IFS; IFS=.
    for _o in $1; do
        case "$_o" in ''|*[!0-9]*) IFS=$_oldifs; return 1 ;; esac
        [ "${#_o}" -gt 3 ] && { IFS=$_oldifs; return 1; }
        [ "$_o" -gt 255 ] && { IFS=$_oldifs; return 1; }
        _c=$((_c + 1))
        [ "$_c" = 1 ] && _first=$_o
    done
    IFS=$_oldifs
    [ "$_c" = 4 ] || return 1
    [ "$_first" = 0 ] && return 1            # "this network"
    [ "$_first" -ge 224 ] && return 1        # multicast, and 255.x broadcast
    return 0
}

# The file is `ip|name` per line, the same shape as the classmap and the oui
# map. `|` and control characters are stripped from names on the way in, so a
# line can never gain a second field or a newline.
clean_name() {
    printf '%s' "$1" | tr -d '|\000-\037' | cut -c1-"$NAME_MAX" \
        | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

list_json() {
    printf '['
    [ -f "$TARGETS" ] && awk -F'|' '
        function esc(s) { gsub(/\\/, "\\\\&", s); gsub(/"/, "\\\\&", s); return s }
        $1 != "" && $1 !~ /^#/ {
            nm = (NF >= 2 && $2 != "") ? $2 : $1
            printf "%s{\"ip\":\"%s\",\"name\":\"%s\"}", (c++ ? "," : ""), esc($1), esc(nm)
        }' "$TARGETS" 2>/dev/null
    printf ']'
}

save_list() {   # stdin -> the file, atomically
    mkdir -p /etc/dashboard 2>/dev/null
    cat > "$TARGETS.tmp" || return 1
    mv "$TARGETS.tmp" "$TARGETS"
}

case "$ACTION" in

list)
    SEL=""; CUSTOM=""
    [ -f "$SEL_FILE" ] && { read -r _l < "$SEL_FILE" 2>/dev/null; set -- $_l; SEL=$1; CUSTOM=$2; }
    printf '{"ok":true,"sel":"%s","target":"%s","targets":%s,"max":%s}' \
        "$(esc "$SEL")" "$(esc "$CUSTOM")" "$(list_json)" "$MAX_SAVED"
    ;;

add)
    IP=$(qs_get ip)
    NAME=$(clean_name "$(qs_get_dec name)")
    valid_ip4 "$IP" || fail "not a usable IPv4 address"
    [ -n "$NAME" ] || NAME="$IP"
    _n=$(awk -F'|' '$1 != "" && $1 !~ /^#/ && $1 != ip' ip="$IP" "$TARGETS" 2>/dev/null | wc -l)
    [ "$_n" -ge "$MAX_SAVED" ] && fail "that is as many as the list holds ($MAX_SAVED)"
    # Re-adding an address that is already saved renames it rather than
    # duplicating it — a list with the same IP twice has no useful meaning.
    { [ -f "$TARGETS" ] && awk -F'|' -v ip="$IP" '$1 != ip' "$TARGETS" 2>/dev/null
      printf '%s|%s\n' "$IP" "$NAME"
    } | save_list || fail "cannot save the list"
    printf '{"ok":true,"targets":%s}' "$(list_json)"
    ;;

del)
    IP=$(qs_get ip)
    [ -n "$IP" ] || fail "which address?"
    [ -f "$TARGETS" ] || fail "nothing saved"
    awk -F'|' -v ip="$IP" '$1 != ip' "$TARGETS" 2>/dev/null | save_list || fail "cannot save the list"
    # The prober is deliberately NOT touched. Removing a shortcut should not
    # change what the router is currently measuring; the Overview shows the
    # live address whether or not it is still in the list.
    printf '{"ok":true,"targets":%s}' "$(list_json)"
    ;;

set)
    SEL=$(qs_get sel)
    IP=$(qs_get ip)
    case "$SEL" in
        cf|google|gw) LINE="$SEL" ;;
        custom)
            valid_ip4 "$IP" || fail "not a usable IPv4 address"
            LINE="custom $IP"
            ;;
        *) fail "unknown target" ;;
    esac
    printf '%s\n' "$LINE" > "$SEL_FILE.tmp" 2>/dev/null || fail "cannot write the selection"
    mv "$SEL_FILE.tmp" "$SEL_FILE" 2>/dev/null || fail "cannot write the selection"
    printf '{"ok":true,"sel":"%s"}' "$(esc "$SEL")"
    ;;

*) fail "unknown action" ;;
esac
