Thumbs.db
.DS_Store
*.prenav
*.bak

# Restore bundles hold WireGuard private keys, Wi-Fi passphrases and the
# console's write password. They must never reach a public repository.
backups/
*.tar.gz
*.packages

# Runtime state that holds secrets, in case a copy is ever pulled off the router
# into this tree for inspection. repeater-known stores the passphrases of every
# Wi-Fi uplink that has been joined; classmap and the vpndns ruleset carry device
# names and tunnel resolvers. Only the .example files belong here.
etc/dashboard/repeater-known
etc/dashboard/classmap
etc/dashboard/vpn-*
etc/nftables.d/
