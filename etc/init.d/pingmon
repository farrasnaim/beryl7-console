#!/bin/sh /etc/rc.common
# /etc/init.d/pingmon
#
# Supervision for /usr/sbin/pingmon, which see for why it exists.
#
# procd, deliberately, and not a cron entry with a lock file or a hand-written
# watchdog. Restarting a process that died is the one job the init system
# already does correctly, and the custom-supervision layer on this router is
# exactly what the 2026-08-11 cleanup removed. There is no code here to get
# wrong.

START=95
STOP=10

USE_PROCD=1
PROG=/usr/sbin/pingmon

start_service() {
    procd_open_instance
    procd_set_param command "$PROG"
    # 5s between respawns, unlimited retries: the reason this exits is that the
    # internet went away, and that is the state it most needs to survive.
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # No reaping needed any more: the prober runs `ping -c1 -W1`, which lives at
    # most a second, so there is no long-lived child to be orphaned. The old
    # `while …| awk` version had one, and procd signalling only the pid it
    # tracks left the whole pipeline running invisibly.
    #
    # The RING goes, because a stale one served as live would be a lie. The
    # SELECTION stays: a crash-and-respawn must not silently change what is
    # being measured. Only a reboot resets it, which is the point — /tmp is
    # empty at boot and the default is Cloudflare.
    rm -f /tmp/.pingring /tmp/.pingring.tmp
}
