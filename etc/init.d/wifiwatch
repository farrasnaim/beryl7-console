#!/bin/sh /etc/rc.common
# Real-time Wi-Fi arrival/departure alerts. START after networking and hostapd
# exist (S95, beside pingmon) because it subscribes to hostapd's ubus objects
# and exits immediately if none are published yet — procd then respawns it,
# which is the intended behaviour rather than a retry loop of its own.
START=96
STOP=10
USE_PROCD=1

start_service() {
    [ -x /usr/sbin/wifiwatch ] || return 0
    procd_open_instance
    procd_set_param command /usr/sbin/wifiwatch
    procd_set_param respawn 30 10 0
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
