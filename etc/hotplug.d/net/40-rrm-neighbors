#!/bin/sh
# Cross-band 802.11k neighbour reports for the two main-SSID APs.
#
# One hostapd process serves both bands here, but it still does not tell either
# AP about the other: rrm_nr_list comes back empty on both, so a client is given
# no hint that the other band exists. 802.11r then only helps a roam the client
# worked out for itself. This fills both lists in, in both directions.
#
# Hooked on the netdev appearing rather than at boot, because the list is runtime
# state and a cold boot is when it is actually empty.
#
# WHICH RELOADS CLEAR THE LIST. A plain `wifi reload` does NOT: the interfaces
# are not recreated, their ifindexes are unchanged, the BSS is never torn down
# and the runtime list survives. A reload that changes SECURITY settings is a
# different animal - netifd unregisters and recreates the BSSs, the kernel logs
# `(unregistering)`, and the list goes with them. That is why this hook must
# work on a reload and not only on a cold boot.
#
# AND WHY IT VERIFIES. rrm_nr_set returns success for a call hostapd accepted
# and then discarded because the BSS was still coming up. The first version of
# this script trusted that return value and, worse, logged unconditionally - so
# on 2026-09-01 the 2.4 GHz list sat empty for eleven minutes while the log said
# the reports had been set. A client on 2.4 GHz was told nothing about the 5 GHz
# AP, which is the exact failure this script exists to prevent, reported as a
# success. Every set is now read back, and the log says which direction landed.

[ "$ACTION" = add ] || exit 0
case "$INTERFACE" in
	phy0.0-ap0|phy0.1-ap0) ;;
	*) exit 0 ;;
esac

AP24=phy0.0-ap0
AP5=phy0.1-ap0

registered() {
	ubus -S list 2>/dev/null | grep -qx "hostapd.$1"
}

# Describe $2 to $1, and CONFIRM IT IS THERE AFTERWARDS. Reads the three fields
# in one call: asking three times invites the two APs disagreeing mid-read if
# hostapd is still settling.
set_pair() {
	local target="$1" src="$2" nr bssid ssid elem
	nr=$(ubus call "hostapd.$src" rrm_nr_get_own 2>/dev/null) || return 1
	bssid=$(printf '%s' "$nr" | jsonfilter -e '@.value[0]')
	ssid=$(printf '%s' "$nr" | jsonfilter -e '@.value[1]')
	elem=$(printf '%s' "$nr" | jsonfilter -e '@.value[2]')
	[ -n "$bssid" ] && [ -n "$elem" ] || return 1
	ubus call "hostapd.$target" rrm_nr_set \
		"{\"list\":[[\"$bssid\",\"$ssid\",\"$elem\"]]}" >/dev/null 2>&1 || return 1
	ubus call "hostapd.$target" rrm_nr_list 2>/dev/null | grep -q "$bssid"
}

# Both sides must be on ubus before either can be described. Bounded so a band
# that never comes up cannot wedge hotplug.
i=0
while [ $i -lt 15 ]; do
	registered "$AP24" && registered "$AP5" && break
	sleep 1
	i=$((i + 1))
done
registered "$AP24" && registered "$AP5" || exit 0

# Being on ubus is not the same as being ready to keep what it is given, so each
# direction is retried on its own until the read-back confirms it. A direction
# that has already landed is not set again.
ok24=0
ok5=0
j=0
while [ $j -lt 10 ]; do
	[ "$ok24" = 1 ] || { set_pair "$AP24" "$AP5" && ok24=1; }
	[ "$ok5" = 1 ] || { set_pair "$AP5" "$AP24" && ok5=1; }
	[ "$ok24" = 1 ] && [ "$ok5" = 1 ] && break
	sleep 1
	j=$((j + 1))
done

if [ "$ok24" = 1 ] && [ "$ok5" = 1 ]; then
	logger -t rrm-neighbors \
		"neighbour reports verified both ways after ${j}s (trigger: $INTERFACE)"
else
	logger -t rrm-neighbors \
		"NEIGHBOUR REPORTS INCOMPLETE after ${j}s (trigger: $INTERFACE): 2.4->5=$ok24 5->2.4=$ok5"
fi
