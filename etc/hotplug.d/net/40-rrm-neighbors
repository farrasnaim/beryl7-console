#!/bin/sh
# Cross-band 802.11k neighbour reports for the two main-SSID APs.
#
# One hostapd process serves both bands here, but it still does not tell either
# AP about the other: rrm_nr_list comes back empty on both, so a client is given
# no hint that the other band exists. 802.11r then only helps a roam the client
# worked out for itself. This fills both lists in, in both directions.
#
# Hooked on the netdev appearing rather than at boot, because the list is runtime
# state and a cold boot is when it is actually empty.
#
# Measured, against the obvious assumption: a plain `wifi reload` does NOT clear
# it. The interfaces are not recreated - their ifindexes are unchanged across a
# reload - so the BSS is never torn down and the runtime list survives. Only a
# reboot loses it, which is exactly what this hook covers.

[ "$ACTION" = add ] || exit 0
case "$INTERFACE" in
	phy0.0-ap0|phy0.1-ap0) ;;
	*) exit 0 ;;
esac

AP24=phy0.0-ap0
AP5=phy0.1-ap0

registered() {
	ubus -S list 2>/dev/null | grep -qx "hostapd.$1"
}

# Describe $2 to $1. Reads the three fields in one call: asking three times
# invites the two APs disagreeing mid-read if hostapd is still settling.
set_pair() {
	local target="$1" src="$2" nr bssid ssid elem
	nr=$(ubus call "hostapd.$src" rrm_nr_get_own 2>/dev/null) || return 1
	bssid=$(printf '%s' "$nr" | jsonfilter -e '@.value[0]')
	ssid=$(printf '%s' "$nr" | jsonfilter -e '@.value[1]')
	elem=$(printf '%s' "$nr" | jsonfilter -e '@.value[2]')
	[ -n "$bssid" ] && [ -n "$elem" ] || return 1
	ubus call "hostapd.$target" rrm_nr_set \
		"{\"list\":[[\"$bssid\",\"$ssid\",\"$elem\"]]}" >/dev/null 2>&1
}

# Both sides must be on ubus before either can be described. Bounded so a band
# that never comes up cannot wedge hotplug.
i=0
while [ $i -lt 15 ]; do
	registered "$AP24" && registered "$AP5" && break
	sleep 1
	i=$((i + 1))
done
registered "$AP24" && registered "$AP5" || exit 0

set_pair "$AP24" "$AP5"
set_pair "$AP5" "$AP24"

logger -t rrm-neighbors "cross-band neighbour reports set (trigger: $INTERFACE)"
