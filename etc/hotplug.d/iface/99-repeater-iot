#!/bin/sh
# /etc/hotplug.d/iface/99-repeater-iot
#
# Travel automation: a secondary SSID for smart-home gear only makes sense at
# home, where that hardware lives. When the router joins an upstream Wi-Fi
# (repeater mode) you are travelling and none of it is present, so the SSID is
# just an extra broadcast — take it down. Bring it back the moment the uplink
# goes away.
#
# Driven by hotplug rather than the /repeater page so it holds however the
# uplink changes: the web UI, LuCI, a reboot, or the hotel AP dropping out.
#
# The sections are found, not named: every AP on a network other than the primary
# one. There is no knob to manage only some of them, and that is deliberate - the
# reason to switch these off while travelling is that they broadcast home network
# names in a public place, and that reason applies to all of them equally.

[ "$INTERFACE" = "wwan" ] || exit 0

# THE FILENAME SAYS "iot" AND THE SCOPE IS NOW WIDER THAN THAT.
#
# Not renamed on purpose: this path is named in .gitignore's exception list,
# install.sh's preserve loop and /etc/sysupgrade.conf, and a rename that misses
# one of those is exactly the class of silent gap that left notifymon out of
# every backup for two days. The name is stale; the registration is correct.
#
# What changed: this took the FIRST wifi-iface not on the primary network and
# switched only that one. That was right while there was one. With a guest SSID
# beside the IoT SSID it becomes an ordering accident - one of the two would go
# on broadcasting a home network name in a hotel lobby, and which one depended
# on uci section order. Every non-primary AP is switched now.
IOT_SECTIONS=""
LOCK=/tmp/.repeater-iot.lock
LOG="logger -t repeater-iot"

for _s in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
    _m=$(uci -q get wireless.$_s.mode 2>/dev/null)
    [ -z "$_m" ] || [ "$_m" = "ap" ] || continue
    _n=$(uci -q get wireless.$_s.network 2>/dev/null)
    [ -n "$_n" ] && [ "$_n" != "lan" ] && IOT_SECTIONS="$IOT_SECTIONS $_s"
done

# nothing to do if this router has no secondary SSID
[ -n "$IOT_SECTIONS" ] || exit 0

case "$ACTION" in
    ifup)   want_disabled=1 ;;   # uplink present -> travelling -> IoT off
    ifdown) want_disabled=0 ;;   # uplink gone    -> home       -> IoT on
    *) exit 0 ;;
esac

# Nothing to do unless at least one of them actually needs changing, tested
# BEFORE taking the lock. An ifupdate storm would otherwise reload the radios
# once per event for a change already made, and these radios are shared with
# the primary network - every one of those reloads drops every client.
NEED=""
for _s in $IOT_SECTIONS; do
    _cur=$(uci -q get wireless.$_s.disabled)
    [ -n "$_cur" ] || _cur=0
    [ "$_cur" = "$want_disabled" ] || NEED="$NEED $_s"
done
[ -n "$NEED" ] || exit 0

# Serialise: ifup/ifdown can fire in quick succession on a flapping uplink.
exec 9>>"$LOCK"
flock -n 9 2>/dev/null || exit 0

IOT_RADIOS=""
for _s in $NEED; do
    uci set wireless.$_s.disabled="$want_disabled"
    if [ "$want_disabled" = "1" ]; then
        $LOG "uplink up -> disabling non-primary SSID '$(uci -q get wireless.$_s.ssid)' ($_s)"
    else
        $LOG "uplink down -> re-enabling non-primary SSID '$(uci -q get wireless.$_s.ssid)' ($_s)"
    fi
    _r=$(uci -q get wireless.$_s.device 2>/dev/null)
    case " $IOT_RADIOS " in *" $_r "*) ;; *) IOT_RADIOS="$IOT_RADIOS $_r" ;; esac
done
uci commit wireless

# Backgrounded: hotplug handlers should return promptly, and `wifi reload`
# re-enters netifd (which is what invoked us).
#
# Scoped to the radio the secondary SSID actually lives on. Unscoped, this
# toggled one 2.4 GHz SSID by restarting every radio, so joining a 5 GHz uplink
# knocked the main 2.4 GHz clients off for no reason — measured during a travel
# rehearsal: six disconnects on the IoT AP, which is the point, and two more on
# the main 2.4 GHz AP, which is not. Falls back to reloading everything if the
# radio cannot be read, which is the previous behaviour.
# One reload per DISTINCT radio, after every section is committed. Reloading
# inside the loop above would restart a shared radio once per SSID on it, and
# the second reload would land while the first was still bringing interfaces
# up - the mid-flight sampling that turned into the 2026-08-10 outage.
# tell apwatch this AP gap is ours, not a fault (see cgi-lib wifi_reloading)
#
# Stamped once, ABOVE the branch, because both branches reload. It used to sit
# inside the scoped branch only, so the fallback — the broadest reload in the
# file — was the one running unannounced.
printf '%s\n' "$(cut -d. -f1 /proc/uptime)" > /tmp/.wifi-reloading 2>/dev/null
if [ -n "$(printf '%s' "$IOT_RADIOS" | tr -d ' ')" ]; then
    ( sleep 1; for _r in $IOT_RADIOS; do [ -n "$_r" ] && wifi reload "$_r"; done ) >/dev/null 2>&1 &
else
    # Unscoped, and deliberately kept that way. Reaching here means not one
    # changed section names a radio, which is a wireless config netifd could not
    # have brought up in the first place — so there is no narrower target to
    # aim at. Doing nothing instead is worse than the broad reload: the disabled
    # flags are already committed, and skipping the reload would leave a home
    # SSID broadcasting in a hotel lobby, which is the whole reason this hook
    # exists. Same fallback rule as reload_uplink_radio and 33-uplink-width.
    ( sleep 1; wifi reload ) >/dev/null 2>&1 &
fi

flock -u 9 2>/dev/null
exit 0
